을 때도 헬릭스가 온갖 자료를 안고 나와서 페르시카에게 도울 수 있는 게 없는지 물었었잖아."}]}],"stageRaw":{"imgTween":[{"imgId":124,"delay":0,"duration":0.2,"alpha":1,"isDark":true}]},"next":"24carnival_helix#8"},"24carnival_helix#8":{"id":"24carnival_helix#8","act":8,"kind":"dialogue","speaker":{"heroId":1024,"name":"헬릭스","rawName":"헬릭스","isProfessor":false},"units":[{"uid":"24carnival_helix#8","rawText":"에헤헤, 그때의 난 내가 뭘 도울 수 있는지 전혀 몰랐거든... 그래서 계속 고민했어.","displayText":"에헤헤, 그때의 난 내가 뭘 도울 수 있는지 전혀 몰랐거든... 그래서 계속 고민했어.","spans":[{"text":"에헤헤, 그때의 난 내가 뭘 도울 수 있는지 전혀 몰랐거든... 그래서 계속 고민했어."}]}],"stageRaw":{"imgTween":[{"imgId":124,"delay":0,"duration":0.2,"alpha":1,"isDark":false}]},"next":"24carnival_helix#9"},"24carnival_helix#9":{"id":"24carnival_helix#9","act":9,"kind":"dialogue","speaker":{"heroId":1024,"name":"헬릭스","rawName":"헬릭스","isProfessor":false},"units":[{"uid":"24carnival_helix#9","rawText":"교수가 안토니나 언니에게 부탁해 분석기 만들어 준 덕분에, 나도 모두를 도울 수 있는 일이 많다는 걸 알았어.","displayText":"교수가 안토니나 언니에게 부탁해 분석기 만들어 준 덕분에, 나도 모두를 도울 수 있는 일이 많다는 걸 알았어.","spans":[{"text":"교수가 안토니나 언니에게 부탁해 분석기 만들어 준 덕분에, 나도 모두를 도울 수 있는 일이 많다는 걸 알았어."}]}],"next":"24carnival_helix#10"},"24carnival_helix#10":{"id":"24carnival_helix#10","act":10,"kind":"dialogue","speaker":{"heroId":1024,"name":"헬릭스","rawName":"헬릭스","isProfessor":false},"units":[{"uid":"24carnival_helix#10","rawText":"교수의 기억이든, 엔트로피와 정화자의 코드에 관한 것이든, 난 최선을 다해 교수를 도울 거야!","displayText":"교수의 기억이든, 엔트로피와 정화자의 코드에 관한 것이든, 난 최선을 다해 교수를 도울 거야!","spans":[{"text":"교수의 기억이든, 엔트로피와 정화자의 코드에 관한 것이든, 난 최선을 다해 교수를 도울 거야!"}]}],"next":"24carnival_helix#11"},"24carnival_helix#11":{"id":"24carnival_helix#11","act":11,"kind":"dialogue","speaker":{"name":null,"rawName":"bravo","isProfessor":true,"professorVariant":"bravo"},"units":[{"uid":"24carnival_helix#11","rawText":"응, 부탁할게, 헬릭스.","displayText":"응, 부탁할게, 헬릭스.","spans":[{"text":"응, 부탁할게, 헬릭스."}]}],"stageRaw":{"imgTween":[{"imgId":124,"delay":0,"duration":0.2,"alpha":1,"isDark":true}]},"next":null,"end":true}},"worldRecords":{},"report":{"