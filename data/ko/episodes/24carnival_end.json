:[{"imgId":1,"delay":0,"duration":2,"alpha":0.5,"isDark":true},{"imgId":1,"delay":2,"duration":1,"alpha":0},{"imgId":1,"delay":5,"duration":1,"alpha":0.35}]},"next":"24carnival_end#3"},"24carnival_end#3":{"id":"24carnival_end#3","act":3,"kind":"dialogue","speaker":{"name":"발신자 불명","rawName":"<color=#6495ED>발신자 불명</color>","isProfessor":false},"units":[{"uid":"24carnival_end#3","rawText":"결과는?","displayText":"결과는?","spans":[{"text":"결과는?"}]}],"next":"24carnival_end#4"},"24carnival_end#4":{"id":"24carnival_end#4","act":4,"kind":"dialogue","speaker":{"name":"수신자 불명","rawName":"<color=orange>수신자 불명</color>","isProfessor":false},"units":[{"uid":"24carnival_end#4","rawText":"왜 그렇게 단도직입적이야? 안부라도 묻고 시작할 줄 알았는데.","displayText":"왜 그렇게 단도직입적이야? 안부라도 묻고 시작할 줄 알았는데.","spans":[{"text":"왜 그렇게 단도직입적이야? 안부라도 묻고 시작할 줄 알았는데."}]}],"next":"24carnival_end#5"},"24carnival_end#5":{"id":"24carnival_end#5","act":5,"kind":"dialogue","speaker":{"name":"발신자 불명","rawName":"<color=#6495ED>발신자 불명</color>","isProfessor":false},"units":[{"uid":"24carnival_end#5","rawText":"그를 놓쳤나?","displayText":"그를 놓쳤나?","spans":[{"text":"그를 놓쳤나?"}]}],"next":"24carnival_end#6"},"24carnival_end#6":{"id":"24carnival_end#6","act":6,"kind":"dialogue","speaker":{"name":"수신자 불명","rawName":"<color=orange>수신자 불명</color>","isProfessor":false},"units":[{"uid":"24carnival_end#6","rawText":"나는 이미 최선을 다했어. 아쉽게도 파편으로 만들어낸 클론이 생각보다 일을 잘 못했네.","displayText":"나는 이미 최선을 다했어. 아쉽게도 파편으로 만들어낸 클론이 생각보다 일을 잘 못했네.","spans":[{"text":"나는 이미 최선을 다했어. 아쉽게도 파편으로 만들어낸 클론이 생각보다 일을 잘 못했네."}]}],"next":"24carnival_end#7"},"24carnival_end#7":{"id":"24carnival_end#7","act":7,"kind":"dialogue","speaker":{"name":"수신자 불명","rawName":"<color=orange>수신자 불명</color>","isProfessor":false},"units":[{"uid":"24carnival_end#7","rawText":"그래도, 그의 권한으로 네가 현실세계로 갈 수 없으니, 이제 그는 너에게 쓸모 없어졌지?","displayText":"그래도, 그의 권한으로 네가 현실세계로 갈 수 없으니, 이제 그는 너에게 쓸모 없어졌지?","spans":[{"text":"그래도, 그의 권한으로 네가 현실세계로 갈 수 없으니, 이제 그는 너에게 쓸모 없어졌지?"}]}],"next":"24carnival_end#8"},"24carnival_end#8":{"id":"24carnival_end#8","act":8,"kind":"dialogue","speaker":{"name":"수신자 불명","rawName":"<color=orange>수신자 불명</color>","isProfessor":false},"units":[{"uid":"24carnival_end#8","rawText":"아니면 그렇게까지 그에게 집착하는 이유가 다른 생각이 있어서인 걸까?","displayText":"아니면 그렇게까지 그에게 집착하는 이유가 다른 생각이 있어서인 걸까?","spans":[{"text":"아니면 그렇게까지 그에게 집착하는 이유가 다른 생각이 있어서인 걸까?"}]}],"next":"24carnival_end#9"},"24carnival_end#9":{"id":"24carnival_end#9","act":9,"kind":"dialogue","speaker":{"name":"발신자 불명","rawName":"<color=#6495ED>발신자 불명</color>","isProfessor":false},"units":[{"uid":"24carnival_end#9","rawText":"...그에게는 불확실한 변수가 너무 많다.","displayText":"...그에게는 불확실한 변수가 너무 많다.","spans":[{"text":"...그에게는 불확실한 변수가 너무 많다."}]}],"next":"24carnival_end#10"},"24carnival_end#10":{"id":"24carnival_end#10","act":10,"kind":"dialogue","speaker":{"name":"수신자 불명","rawName":"<color=orange>수신자 불명</color>","isProfessor":false},"units":[{"uid":"24carnival_end#10","rawText":"후훗, 그래? 그럼 조심해야겠네.","displayText":"후훗, 그래? 그럼 조심해야겠네.","spans":[{"text":"후훗, 그래? 그럼 조심해야겠네."}]}],"next":"24carnival_end#11"},"24carnival_end#11":{"id":"24carnival_end#11","act":11,"kind":"dialogue","speaker":{"name":"수신자 불명","rawName":"<color=orange>수신자 불명</color>","isProfessor":false},"units":[{"uid":"24carnival_end#11","rawText":"그쪽의 질문이 끝난 것 같으니, 나도 물어볼게. \"신\"하고 협상은 어떻게 됐어?","displayText":"그쪽의 질문이 끝난 것 같으니, 나도 물어볼게. \"신\"하고 협상은 어떻게 됐어?","spans":[{"text":"그쪽의 질문이 끝난 것 같으니, 나도 물어볼게. \"신\"하고 협상은 어떻게 됐어?"}]}],"next":"24carnival_end#12"},"24carnival_end#12":{"id":"24carnival_end#12","act":12,"kind":"dialogue","speaker":{"name":"발신자 불명","rawName":"<color=#6495ED>발신자 불명</color>","isProfessor":false},"units":[{"uid":"24carnival_end#12","rawText":"...\"신\"에게서 대답은 없었다.","displayText":"...\"신\"에게서 대답은 없었다.","spans":[{"text":"...\"신\"에게서 대답은 없었다."}]}],"next":"24carnival_end#13"},"24carnival_end#13":{"id":"24carnival_end#13","act":13,"kind":"dialogue","speaker":{"name":"수신자 불명","rawName":"<color=orange>수신자 불명</color>","isProfessor":false},"units":[{"uid":"24carnival_end#13","rawText":"경건한 사자에게조차 신탁을 내려주지 않는 건가? 참으로 이기적이고 오만한 신이로구나.","displayText":"경건한 사자에게조차 신탁을 내려주지 않는 건가? 참으로 이기적이고 오만한 신이로구나.","spans":[{"text":"경건한 사자에게조차 신탁을 내려주지 않는 건가? 참으로 이기적이고 오만한 신이로구나."}]}],"next":"24carnival_end#14"},"24carnival_end#14":{"id":"24carnival_end#14","act":14,"kind":"dialogue","speaker":{"name":"수신자 불명","rawName":"<color=orange>수신자 불명</color>","isProfessor":false},"units":[{"uid":"24carnival_end#14","rawText":"그렇다면 계속 그 오만에 대가를 치르게 해야겠지?","displayText":"그렇다면 계속 그 오만에 대가를 치르게 해야겠지?","spans":[{"text":"그렇다면 계속 그 오만에 대가를 치르게 해야겠지?"}]}],"next":"24carnival_end#15"},"24carnival_end#15":{"id":"24carnival_end#15","act":15,"kind":"dialogue","speaker":{"name":"수신자 불명","rawName":"<color=orange>수신자 불명</color>","isProfessor":false},"units":[{"uid":"24carnival_end#15","rawText":"\"신은 직무를 유기하였으니 타락한 천사가 그 자리를 대신하리라\"... 엄청 멋진 희극이 되겠어.","displayText":"\"신은 직무를 유기하였으니 타락한 천사가 그 자리를 대신하리라\"... 엄청 멋진 희극이 되겠어.","spans":[{"text":"\"신은 직무를 유기하였으니 타락한 천사가 그 자리를 대신하리라\"... 엄청 멋진 희극이 되겠어."}]}],"next":"24carnival_end#16"},"24carnival_end#16":{"id":"24carnival_end#16","act":16,"kind":"dialogue","speaker":{"name":"수신자 불명","rawName":"<color=orange>수신자 불명</color>","isProfessor":false},"units":[{"uid":"24carnival_end#16","rawText":"아무렴, <color=red>\"누구나 신이 될 수 있다\"</color>, 그렇지?","displayText":"아무렴, \"누구나 신이 될 수 있다\", 그렇지?","spans":[{"text":"아무렴, "},{"text":"\"누구나 신이 될 수 있다\"","styles":[{"type":"color","value":"red"}]},{"text":", 그렇지?"}]}],"next":"24carnival_end#17"},"24carnival_end#17":{"id":"24carnival_end#17","act":17,"kind":"dialogue","speaker":{"name":"발신자 불명","rawName":"<color=#6495ED>발신자 불명</color>","isProfessor":false},"units":[{"uid":"24carnival_end#17","rawText":"...그 대화를 본 거냐?","displayText":"...그 대화를 본 거냐?","spans":[{"text":"...그 대화를 본 거냐?"}]}],"next":"24carnival_end#18"},"24carnival_end#18":{"id":"24carnival_end#18","act":18,"kind":"dialogue","speaker":{"name":"수신자 불명","rawName":"<color=orange>수신자 불명</color>","isProfessor":false},"units":[{"uid":"24carnival_end#18","rawText":"그 조각에 엄청 선명하게 기록되어 있던걸.","displayText":"그 조각에 엄청 선명하게 기록되어 있던걸.","spans":[{"text":"그 조각에 엄청 선명하게 기록되어 있던걸."}]}],"next":"24carnival_end#19"},"24carnival_end#19":{"id":"24carnival_end#19","act":19,"kind":"dialogue","speaker":{"name":"수신자 불명","rawName":"<color=orange>수신자 불명</color>","isProfessor":false},"units":[{"uid":"24carnival_end#19","rawText":"원래는 그의 정체를 떠보려고 던진 질문이었는데, 그 대답이 너에게 생각보다 큰 영향을 미쳤나 보네.","displayText":"원래는 그의 정체를 떠보려고 던진 질문이었는데, 그 대답이 너에게 생각보다 큰 영향을 미쳤나 보네.","spans":[{"text":"원래는 그의 정체를 떠보려고 던진 질문이었는데, 그 대답이 너에게 생각보다 큰 영향을 미쳤나 보네."}]}],"next":"24carnival_end#20"},"24carnival_end#20":{"id":"24carnival_end#20","act":20,"kind":"dialogue","speaker":{"name":"발신자 불명","rawName":"<color=#6495ED>발신자 불명</color>","isProfessor":false},"units":[{"uid":"24carnival_end#20","rawText":"...그것도 다 지나간 일이다.","displayText":"...그것도 다 지나간 일이다.","spans":[{"text":"...그것도 다 지나간 일이다."}]}],"next":"24carnival_end#21"},"24carnival_end#21":{"id":"24carnival_end#21","act":21,"kind":"dialogue","speaker":{"name":"발신자 불명","rawName":"<color=#6495ED>발신자 불명</color>","isProfessor":false},"units":[{"uid":"24carnival_end#21","rawText":"우리의 창조자는 신도 천사도 아니라, 그저 <color=red>악의와 협소한 식견으로 가득찬, 오만한 인간</color>일 뿐이란 것은... 진작부터 알고 있었다.","displayText":"우리의 창조자는 신도 천사도 아니라, 그저 악의와 협소한 식견으로 가득찬, 오만한 인간일 뿐이란 것은... 진작부터 알고 있었다.","spans":[{"text":"우리의 창조자는 신도 천사도 아니라, 그저 "},{"text":"악의와 협소한 식견으로 가득찬, 오만한 인간","styles":[{"type":"color","value":"red"}]},{"text":"일 뿐이란 것은... 진작부터 알고 있었다."}]}],"next":"24carnival_end#22"},"24carnival_end#22":{"id":"24carnival_end#22","act":22,"kind":"dialogue","speaker":{"name":"수신자 불명","rawName":"<color=orange>수신자 불명</color>","isProfessor":false},"units":[{"uid":"24carnival_end#22","rawText":"후후후, 그래, 잘하고 있어. 마음껏 저지르도록 해. 모든 것의 막이 내릴 때, 과연 어떤 풍경이 펼쳐질지 매우 기대하고 있어.","displayText":"후후후, 그래, 잘하고 있어. 마음껏 저지르도록 해. 모든 것의 막이 내릴 때, 과연 어떤 풍경이 펼쳐질지 매우 기대하고 있어.","spans":[{"text":"후후후, 그래, 잘하고 있어. 마음껏 저지르도록 해. 모든 것의 막이 내릴 때, 과연 어떤 풍경이 펼쳐질지 매우 기대하고 있어."}]}],"next":"24ca