:[{"imgId":154,"delay":0,"duration":0.2,"posId":3,"alpha":1,"isDark":true}]},"next":"cpt_python_03_03#28"},"cpt_python_03_03#28":{"id":"cpt_python_03_03#28","act":28,"kind":"dialogue","speaker":{"name":"통신채널 2","rawName":"<color=orange>통신채널 2</color>","isProfessor":false},"units":[{"uid":"cpt_python_03_03#28","rawText":"\"인간-인형 혼성 부대는 전장의 미래다.\" 와우, 아주 소름이 돋는 주장이야.","displayText":"\"인간-인형 혼성 부대는 전장의 미래다.\" 와우, 아주 소름이 돋는 주장이야.","spans":[{"text":"\"인간-인형 혼성 부대는 전장의 미래다.\" 와우, 아주 소름이 돋는 주장이야."}]}],"next":"cpt_python_03_03#29"},"cpt_python_03_03#29":{"id":"cpt_python_03_03#29","act":29,"kind":"dialogue","speaker":{"name":"통신채널 2","rawName":"<color=orange>통신채널 2</color>","isProfessor":false},"units":[{"uid":"cpt_python_03_03#29","rawText":"전장의 미래라니까, 시합 방식을 정면 대결에서 돌발전으로 바꿔도 큰 문제 없을 거 아니야, 안 그래?","displayText":"전장의 미래라니까, 시합 방식을 정면 대결에서 돌발전으로 바꿔도 큰 문제 없을 거 아니야, 안 그래?","spans":[{"text":"전장의 미래라니까, 시합 방식을 정면 대결에서 돌발전으로 바꿔도 큰 문제 없을 거 아니야, 안 그래?"}]}],"next":"cpt_python_03_03#30"},"cpt_python_03_03#30":{"id":"cpt_python_03_03#30","act":30,"kind":"dialogue","speaker":{"heroId":1054,"name":"파이슨","rawName":"파이슨","isProfessor":false,"faces":[{"imgId":154,"faceId":5}],"dialogPos":2},"units":[{"uid":"cpt_python_03_03#30","rawText":"남부는 갈수록 질이 떨어지는군. 너같이 입만 번지르르한 녀석은 예전 같았으면 화장실 똥칸이나 치우고 있었을 텐데 말이야.","displayText":"남부는 갈수록 질이 떨어지는군. 너같이 입만 번지르르한 녀석은 예전 같았으면 화장실 똥칸이나 치우고 있었을 텐데 말이야.","spans":[{"text":"남부는 갈수록 질이 떨어지는군. 너같이 입만 번지르르한 녀석은 예전 같았으면 화장실 똥칸이나 치우고 있었을 텐데 말이야."}]}],"stageRaw":{"imgTween":[{"imgId":154,"delay":0,"duration":0.2,"posId":3,"alpha":1,"isDark":false}],"heroFace":[{"imgId":154,"faceId":5}]},"next":"cpt_python_03_03#31"},"cpt_python_03_03#31":{"id":"cpt_python_03_03#31","act":31,"kind":"dialogue","speaker":{"name":"통신채널 2","rawName":"<color=orange>통신채널 2</color>","isProfessor":false},"units":[{"uid":"cpt_python_03_03#31","rawText":"이 자식...!","displayText":"이 자식...!","spans":[{"text":"이 자식...!"}],"shake":true}],"stageRaw":{"imgTween":[{"imgId":154,"delay":0,"duration"