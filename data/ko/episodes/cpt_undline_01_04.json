heroFace":[{"imgId":170,"faceId":5}]},"next":"cpt_undline_01_04#24"},"cpt_undline_01_04#24":{"id":"cpt_undline_01_04#24","act":24,"kind":"dialogue","speaker":{"heroId":1070,"name":"운디네","rawName":"운디네","isProfessor":false,"faces":[{"imgId":170,"faceId":6}]},"units":[{"uid":"cpt_undline_01_04#24","rawText":"(아까는 스핀으로 얼버무렸지만, 아직 공연은 한참 남았어. 이런 고난도 동작을 계속한다면 얼마 버티지 못할 거야.)","monologue":true,"displayText":"아까는 스핀으로 얼버무렸지만, 아직 공연은 한참 남았어. 이런 고난도 동작을 계속한다면 얼마 버티지 못할 거야.","spans":[{"text":"아까는 스핀으로 얼버무렸지만, 아직 공연은 한참 남았어. 이런 고난도 동작을 계속한다면 얼마 버티지 못할 거야."}]}],"stageRaw":{"heroFace":[{"imgId":170,"faceId":6}]},"next":"cpt_undline_01_04#25"},"cpt_undline_01_04#25":{"id":"cpt_undline_01_04#25","act":25,"kind":"dialogue","speaker":{"heroId":1070,"name":"운디네","rawName":"운디네","isProfessor":false,"faces":[{"imgId":170,"faceId":5}]},"units":[{"uid":"cpt_undline_01_04#25","rawText":"(안 돼, 여기서 망가질 순——)","monologue":true,"displayText":"안 돼, 여기서 망가질 순——","spans":[{"text":"안 돼, 여기서 망가질 순——"}]}],"stageRaw":{"imgTween":[{"imgId":170,"delay":0,"duration":0.2,"posId":3,"alpha":1,"shake":true,"isDark":false}],"heroFace":[{"imgId":170,"faceId":5}]},"next":"cpt_undline_01_04#26"},"cpt_undline_01_04#26":{"id":"cpt_undline_01_04#26","act":26,"kind":"dialogue","speaker":{"heroId":177,"name":"스케르","rawName":"스케르","isProfessor":false,"faces":[{"imgId":177,"faceId":1}],"dialogPos":1},"units":[{"uid":"cpt_undline_01_04#26","rawText":"<size=28>삐——\n(괜찮음...)</size>","displayText":"삐——\n(괜찮음...)","spans":[{"text":"삐——\n(괜찮음...)","styles":[{"type":"size","value":28}]}]}],"stageRaw":{"imgTween":[{"imgId":170,"delay":0,"duration":0.2,"posId":3,"alpha":0,"isDark":false},{"imgId":177,"delay":0,"duration":0,"posId":2,"alpha":0,"isDark":false},{"imgId":177,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":false},{"imgId":179,"delay":0,"duration":0,"posId":4,"alpha":0,"isDark":true},{"imgId":179,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":true}],"heroFace":[{"imgId":177,"faceId":1}]},"next":"cpt_und