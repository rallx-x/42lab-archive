lay":0,"duration":0.6,"alpha":1}]},"next":"24fe2_s15_7#5"},"24fe2_s15_7#5":{"id":"24fe2_s15_7#5","act":5,"kind":"dialogue","speaker":{"name":null,"rawName":"bravo","isProfessor":true,"professorVariant":"bravo"},"units":[{"uid":"24fe2_s15_7#5","rawText":"말키라가 말했지... 무대 위에 서는 주인공은 강해야만 운명의 궤도를 바꿀 수 있고, 조연은 그저 풀잎이나 먼지 같은 존재에 지나지 않는다고. 하지만 그래도, 나는 시도하고 싶어.","displayText":"말키라가 말했지... 무대 위에 서는 주인공은 강해야만 운명의 궤도를 바꿀 수 있고, 조연은 그저 풀잎이나 먼지 같은 존재에 지나지 않는다고. 하지만 그래도, 나는 시도하고 싶어.","spans":[{"text":"말키라가 말했지... 무대 위에 서는 주인공은 강해야만 운명의 궤도를 바꿀 수 있고, 조연은 그저 풀잎이나 먼지 같은 존재에 지나지 않는다고. 하지만 그래도, 나는 시도하고 싶어."}]}],"next":"24fe2_s15_7#6"},"24fe2_s15_7#6":{"id":"24fe2_s15_7#6","act":6,"kind":"dialogue","speaker":{"name":null,"rawName":"bravo","isProfessor":true,"professorVariant":"bravo"},"units":[{"uid":"24fe2_s15_7#6","rawText":"여기서 멈춘다면, 지금까지의 모든 희생이 아무런 의미도 없어질 테니까.","displayText":"여기서 멈춘다면, 지금까지의 모든 희생이 아무런 의미도 없어질 테니까.","spans":[{"text":"여기서 멈춘다면, 지금까지의 모든 희생이 아무런 의미도 없어질 테니까."}]}],"next":"24fe2_s15_7#7"},"24fe2_s15_7#7":{"id":"24fe2_s15_7#7","act":7,"kind":"narration","units":[{"uid":"24fe2_s15_7#7","rawText":"미약하게나마 연산량을 손바닥에 그러모아, 장벽을 밀어내려 했다.","displayText":"미약하게나마 연산량을 손바닥에 그러모아, 장벽을 밀어내려 했다.","spans":[{"text":"미약하게나마 연산량을 손바닥에 그러모아, 장벽을 밀어내려 했다."}]}],"stageRaw":{"imgTween":[{"imgId":10,"delay":0,"duration":1,"alpha":0.5}]},"next":"24fe2_s15_7#8"},"24fe2_s15_7#8":{"id":"24fe2_s15_7#8","act":8,"kind":"narration","units":[{"uid":"24fe2_s15_7#8","rawText":"그때, 흐릿한 방화벽 너머로 은빛 실루엣이 나타났다. 그는 말없이 고개를 끄덕이며, 역바빌론 탑의 안내자였음을 밝히려는 듯 상처투성이인 손바닥을 방화벽에 댔다.","displayText":"그때, 흐릿한 방화벽 너머로 은빛 실루엣이 나타났다. 그는 말없이 고개를 끄덕이며, 역바빌론 탑의 안내자였음을 밝히려는 듯 상처투성이인 손바닥을 방화벽에 댔다.","spans":[{"text":"그때, 흐릿한 방화벽 너머로 은빛 실루엣이 나타났다. 그는 말없이 고개를 끄덕이며, 역바빌론 탑의 안내자였음을 밝히려는 듯 상처투성이인 손바닥을 방화벽에 댔다."}]}],"stageRaw":{"imgTween":[{"imgId":37,"delay":0,"duration":0,"posId":3,"alpha":0,"isDark":true},{"imgId":37,"delay":0,"duration":0.6,"alpha":1,"isDark":true}]},"next":"24fe2_s15_7#9"},"24fe2_s15_7#9":{"id":"24fe2_s15_7#9","act":9,