":true,"isDark":true},{"imgId":30,"delay":0.5,"duration":0.6,"alpha":0,"isDark":true},{"imgId":26,"delay":0.5,"duration":0.6,"alpha":1,"isDark":true}]},"next":"24summer_s07_0#63"},"24summer_s07_0#63":{"id":"24summer_s07_0#63","act":63,"kind":"dialogue","speaker":{"name":"유카리스트","rawName":"<color=#ADFF2F>유카리스트</color>","isProfessor":false},"units":[{"uid":"24summer_s07_0#63","rawText":"...잊은 게야? 지금의 언니는 이미 <color=#ADFF2F>\"유카리스트\"</color>이네.","displayText":"...잊은 게야? 지금의 언니는 이미 \"유카리스트\"이네.","spans":[{"text":"...잊은 게야? 지금의 언니는 이미 "},{"text":"\"유카리스트\"","styles":[{"type":"color","value":"#ADFF2F"}]},{"text":"이네."}]}],"stageRaw":{"imgTween":[{"imgId":26,"delay":0,"duration":0.6,"alpha":0,"isDark":true}]},"next":"24summer_s07_0#64"},"24summer_s07_0#64":{"id":"24summer_s07_0#64","act":64,"kind":"dialogue","speaker":{"name":"유카리스트","rawName":"<color=#ADFF2F>유카리스트</color>","isProfessor":false},"units":[{"uid":"24summer_s07_0#64","rawText":"어서 가시게. 내가 겪었던 그 절망을 똑같이 겪으면서, 내 선택이 틀리지 않았다는 걸 증명해 보여주시게.","displayText":"어서 가시게. 내가 겪었던 그 절망을 똑같이 겪으면서, 내 선택이 틀리지 않았다는 걸 증명해 보여주시게.","spans":[{"text":"어서 가시게. 내가 겪었던 그 절망을 똑같이 겪으면서, 내 선택이 틀리지 않았다는 걸 증명해 보여주시게."}]}],"next":"24summer_s07_0#65"},"24summer_s07_0#65":{"id":"24summer_s07_0#65","act":65,"kind":"narration","units":[{"uid":"24summer_s07_0#65","rawText":"주변이 다시 어둠으로 변했다. 유카리스트는 손을 놓고 안젤루스가 끝없이 심연으로 떨어지는 모습을 지켜보았다.","displayText":"주변이 다시 어둠으로 변했다. 유카리스트는 손을 놓고 안젤루스가 끝없이 심연으로 떨어지는 모습을 지켜보았다.","spans":[{"text":"주변이 다시 어둠으로 변했다. 유카리스트는 손을 놓고 안젤루스가 끝없이 심연으로 떨어지는 모습을 지켜보았다."}]}],"next":"24summer_s07_0#66"},"24summer_s07_0#66":{"id":"24summer_s07_0#66","act":66,"kind":"dialogue","speaker":{"name":"유카리스트","rawName":"<color=#ADFF2F>유카리스트</color>","isProfessor":false},"units":[{"uid":"24summer_s07_0#66","rawText":"<color=red>몇 번이고 뼛속 깊이 새겨질 절망을 경험한다면, 누구든 나처럼 미쳐버릴 수밖에 없다네.</color>","displayText":"몇 번이고 뼛속 깊이 새겨질 절망을 경험한다면, 누구든 나처럼 미쳐버릴 수밖에 없다네.","spans":[{"text":"몇 번이고 뼛속 깊이 새겨질 절망을 경험한다면, 누구든 나처럼 미쳐버릴 수밖에 없다네.","styles":[{"type":"color",