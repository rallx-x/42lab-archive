":0,"duration":0.2,"alpha":1,"isDark":true}]},"next":"24carnival_nora#4"},"24carnival_nora#4":{"id":"24carnival_nora#4","act":4,"kind":"dialogue","speaker":{"heroId":1059,"name":"노라","rawName":"노라","isProfessor":false},"units":[{"uid":"24carnival_nora#4","rawText":"그라제. 그리고 나가 요즘 새로 소설 하나 쓰고 있는디 말여, 제목이 [뉴럴 클라우드]인디... 한 인간이 즈 목숨을 걸고 클라우드 서버에 들어가서, 거 갇힌 인형들을 거시기해뿌는 이야기거든.","displayText":"그라제. 그리고 나가 요즘 새로 소설 하나 쓰고 있는디 말여, 제목이 [뉴럴 클라우드]인디... 한 인간이 즈 목숨을 걸고 클라우드 서버에 들어가서, 거 갇힌 인형들을 거시기해뿌는 이야기거든.","spans":[{"text":"그라제. 그리고 나가 요즘 새로 소설 하나 쓰고 있는디 말여, 제목이 [뉴럴 클라우드]인디... 한 인간이 즈 목숨을 걸고 클라우드 서버에 들어가서, 거 갇힌 인형들을 거시기해뿌는 이야기거든."}]}],"stageRaw":{"imgTween":[{"imgId":159,"delay":0,"duration":0.2,"alpha":1,"isDark":false}]},"next":"24carnival_nora#5"},"24carnival_nora#5":{"id":"24carnival_nora#5","act":5,"kind":"dialogue","speaker":{"name":null,"rawName":"bravo","isProfessor":true,"professorVariant":"bravo"},"units":[{"uid":"24carnival_nora#5","rawText":"그럼 네가 구상한 스토리에서 그 인간은 결국 성공해?","displayText":"그럼 네가 구상한 스토리에서 그 인간은 결국 성공해?","spans":[{"text":"그럼 네가 구상한 스토리에서 그 인간은 결국 성공해?"}]}],"stageRaw":{"imgTween":[{"imgId":159,"delay":0,"duration":0.2,"alpha":1,"isDark":true}]},"next":"24carnival_nora#6"},"24carnival_nora#6":{"id":"24carnival_nora#6","act":6,"kind":"dialogue","speaker":{"heroId":1059,"name":"노라","rawName":"노라","isProfessor":false},"units":[{"uid":"24carnival_nora#6","rawText":"아따 교수, 우째 결말도 안 보고 스포일러부터 찾냐! 그래도 나가 딱 하나는 장담할 수 있어야... 그 인간을 기다리는 결말은, 분명 그 여정을 헤쳐온 보람이 있는 결말이라는 거여.","displayText":"아따 교수, 우째 결말도 안 보고 스포일러부터 찾냐! 그래도 나가 딱 하나는 장담할 수 있어야... 그 인간을 기다리는 결말은, 분명 그 여정을 헤쳐온 보람이 있는 결말이라는 거여.","spans":[{"text":"아따 교수, 우째 결말도 안 보고 스포일러부터 찾냐! 그래도 나가 딱 하나는 장담할 수 있어야... 그 인간을 기다리는 결말은, 분명 그 여정을 헤쳐온 보람이 있는 결말이라는 거여."}]}],"stageRaw":{"imgTween":[{"imgId":159,"delay":0,"duration":0.2,"alpha":1,"isDark":false}]},"next":"24carnival_nora#7"},"24carnival_nora#7":{"id":"24carnival_nora#7","act":7,"kind":"dialogue","speaker":{"name":null,"rawName":"bravo","isProfessor":true,"professorVariant":"bravo"},"units":[{"uid":"24carnival_nora#7","rawText":"하하, 그렇다면 정말 멋진 결말이겠네.","displayText":"하하, 그렇다면 정말 멋진 결말이겠네.","spans":[{"text":"하하, 그렇다면 정말 멋진 결말이겠네."}]}],"stageRaw":{"imgTween":[{"imgId":159,"delay":0,"duration":0.2,"alpha":1,"isDark":true}]},"next":"24carnival_nora#8"},"24carnival_nora#8":{"id":"24carnival_nora#8","act":8,"kind":"dialogue","speaker":{"heroId":1059,"name":"노라","rawName":"노라","isProfessor":false},"units":[{"uid":"24carnival_nora#8","rawText":"흐흐, 그거야 말이 필요가 없제! 따악 출판되기만 하면, 분명히 고 뱀 자슥 작품 따위는 콧대를 납작하게 만들어불거여. 흐흐흐... 그 떨떠름한 표정을 상상만 해도 기양... 흐흐... 하하하하하!","displayText":"흐흐, 그거야 말이 필요가 없제! 따악 출판되기만 하면, 분명히 고 뱀 자슥 작품 따위는 콧대를 납작하게 만들어불거여. 흐흐흐... 그 떨떠름한 표정을 상상만 해도 기양... 흐흐... 하하하하하!","spans":[{"text":"흐흐, 그거야 말이 필요가 없제! 따악 출판되기만 하면, 분명히 고 뱀 자슥 작품 따위는 콧대를 납작하게 만들어불거여. 흐흐흐... 그 떨떠름한 표정을 상상만 해도 기양... 흐흐... 하하하하하!"}],"shake":true}],"stageRaw":{"imgTween":[{"imgId":159,"delay":0,"duration":0.2,"alpha":1,"shake":true,"isDark":false}]},"next":"24carnival_nora#9"},"24carnival_nora#9":{"id":"24carnival_nora#9","act":9,"kind":"dialogue","speaker":{"name":null,"rawName":"bravo","isProfessor":true,"professorVariant":"bravo"},"units":[{"uid":"24carnival_nora#9","rawText":"아, 장음이 원고 제출해야 한다고 전해달라고 했어. 그리고 현실로 돌아간 후에도 계속해서 네 편집자를 맡겠다고 신청했대.","displayText":"아, 장음이 원고 제출해야 한다고 전해달라고 했어. 그리고 현실로 돌아간 후에도 계속해서 네 편집자를 맡겠다고 신청했대.","spans":[{"text":"아, 장음이 원고 제출해야 한다고 전해달라고 했어. 그리고 현실로 돌아간 후에도 계속해서 네 편집자를 맡겠다고 신청했대."}]}],"stageRaw":{"imgTween":[{"imgId":159,"delay":0,"duration":0.2,"alpha":1,"isDark":true}]},"next":"24carnival_nora#10"},"24carnival_nora#10":{"id":"24carnival_nora#10","act":10,"kind":"dialogue","speaker":{"heroId":1059,"name":"노라","rawName":"노라","isProfessor":false},"units":[{"uid":"24carnival_nora#10","rawText":"...뭐... 뭣이여!?... 어어어?!!!!!","displayText":"...뭐... 뭣이여!?... 어어어?!!!!!","spans":[{"text":"...뭐... 뭣이여!?... 어어어?!!!!!"}],"shake":true}],"stageRaw":{"imgTween":[{"imgId":159,"delay":0,"duration":0.2,"alpha":1,"shake":true,"isDark":false},{"i