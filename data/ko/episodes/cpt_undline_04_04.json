:3,"alpha":0,"imgPath":"undline_avg"},{"imgId":176,"imgType":3,"alpha":0,"imgPath":"undline_w1_avg"},{"imgId":177,"imgType":3,"alpha":0,"imgPath":"undline_w2_avg"},{"imgId":178,"imgType":3,"alpha":0,"imgPath":"undline_w3_avg"},{"imgId":179,"imgType":3,"alpha":0,"imgPath":"undline_w4_avg"}],"bgColor":2},"next":"cpt_undline_04_04#2"},"cpt_undline_04_04#2":{"id":"cpt_undline_04_04#2","act":2,"kind":"narration","units":[{"uid":"cpt_undline_04_04#2","rawText":"동료기들은 휴식을 취하는 짬짬이 악기와 지휘봉을 손질하고 있었고, 운디네는 마인드맵을 정리하면서 드 레이시에게 부칠 편지 내용을 고민 중이었다.","displayText":"동료기들은 휴식을 취하는 짬짬이 악기와 지휘봉을 손질하고 있었고, 운디네는 마인드맵을 정리하면서 드 레이시에게 부칠 편지 내용을 고민 중이었다.","spans":[{"text":"동료기들은 휴식을 취하는 짬짬이 악기와 지휘봉을 손질하고 있었고, 운디네는 마인드맵을 정리하면서 드 레이시에게 부칠 편지 내용을 고민 중이었다."}]}],"stageRaw":{"imgTween":[{"imgId":1,"delay":0,"duration":1,"alpha":1}]},"next":"cpt_undline_04_04#3"},"cpt_undline_04_04#3":{"id":"cpt_undline_04_04#3","act":3,"kind":"scene","units":[{"uid":"cpt_undline_04_04#3","rawText":"<color=orange>드 레이시에게</color>:","displayText":"드 레이시에게:","spans":[{"text":"드 레이시에게","styles":[{"type":"accent"}]},{"text":":"}]}],"next":"cpt_undline_04_04#4"},"cpt_undline_04_04#4":{"id":"cpt_undline_04_04#4","act":4,"kind":"scene","units":[{"uid":"cpt_undline_04_04#4","rawText":"전에 너한테, 처음부터 시작해도 걱정 없다고 말했었지.<|>\n하지만 기댈 곳 없이 새로운 땅에서 다시 시작해 보니까, 예전만큼 돈이 벌리는 일을 받기는 어렵더라.","displayText":"전에 너한테, 처음부터 시작해도 걱정 없다고 말했었지.\n하지만 기댈 곳 없이 새로운 땅에서 다시 시작해 보니까, 예전만큼 돈이 벌리는 일을 받기는 어렵더라.","spans":[{"text":"전에 너한테, 처음부터 시작해도 걱정 없다고 말했었지."},{"text":"\n하지만 기댈 곳 없이 새로운 땅에서 다시 시작해 보니까, 예전만큼 돈이 벌리는 일을 받기는 어렵더라."}]}],"next":"cpt_undline_04_04#5"},"cpt_undline_04_04#5":{"id":"cpt_undline_04_04#5","act":5,"kind":"scene","units":[{"uid":"cpt_undline_04_04#5","rawText":"넌 지금까지의 수리비를 안 갚아도 된다고 했지만, 그렇다고 그 빚을 내버려두지는 않을 거야.<|>\n그리고 계속 돈을 벌어서, 이 애들의 마인드맵을 안전하게 업그레이드할 방법을 찾으려고 해... 지금은 그냥 평범한 길거리 공연밖에 못 하고 있어. 보수는 적지만, 일을 자주 나가고 예전보다 자유로워서 좋아.","displayText":"넌 지금까지의 수리비를 안 갚아도 된다고 했지만, 그렇다고 그 빚을 내버려두지는 않을 거야.\n그리고 계속 돈을 벌어서, 이 애들의 마인드맵을 안전하게 업그레이드할 방법을 찾으려고 해... 지금은 그냥 평범한 길거리 공연밖에 못 하고 있어. 보수는 적지만, 일을 자주 나가고 예전보다 자유로워서 좋아.","spans":[{"text":"넌 지금까지의 수리비를 안 갚아도 된다고 했지만, 그렇다고 그 빚을 내버려두지는 않을 거야."},{"text":"\n그리고 계속 돈을 벌어서, 이 애들의 마인드맵을 안전하게 업그레이드할 방법을 찾으려고 해... 지금은 그냥 평범한 길거리 공연밖에 못 하고 있어. 보수는 적지만, 일을 자주 나가고 예전보다 자유로워서 좋아."}]}],"next":"cpt_undline_04_04#6"},"cpt_undline_04_04#6":{"id":"cpt_undline_04_04#6","act":6,"kind":"scene","units":[{"uid":"cpt_undline_04_04#6","rawText":"계속 열심히 하다 보면 돈이 모이겠지.","displayText":"계속 열심히 하다 보면 돈이 모이겠지.","spans":[{"text":"계속 열심히 하다 보면 돈이 모이겠지."}]}],"next":"cpt_undline_04_04#7"},"cpt_undline_04_04#7":{"id":"cpt_undline_04_04#7","act":7,"kind":"dialogue","speaker":{"heroId":176,"name":"돌체","rawName":"돌체","isProfessor":false,"faces":[{"imgId":176,"faceId":1}],"dialogPos":1},"units":[{"uid":"cpt_undline_04_04#7","rawText":"띠디디삐비——\n(보수, 수령!)","displayText":"띠디디삐비——\n(보수, 수령!)","spans":[{"text":"띠디디삐비——\n(보수, 수령!)"}]}],"stageRaw":{"imgTween":[{"imgId":176,"delay":0,"duration":0,"posId":2,"alpha":0,"isDark":false},{"imgId":176,"delay":0,"duration":0.6,"posId":2,"alpha":1,"isDark":false},{"imgId":177,"delay":0,"duration":0,"posId":4,"alpha":0,"isDark":true},{"imgId":177,"delay":0,"duration":0.6,"posId":4,"alpha":1,"isDark":true}],"heroFace":[{"imgId":176,"faceId":1}]},"next":"cpt_undline_04_04#8"},"cpt_undline_04_04#8":{"id":"cpt_undline_04_04#8","act":8,"kind":"dialogue","speaker":{"heroId":177,"name":"스케르","rawName":"스케르","isProfessor":false,"dialogPos":3},"units":[{"uid":"cpt_undline_04_04#8","rawText":"띠디디삐비——\n(퇴장, 준비!)","displayText":"띠디디삐비——\n(퇴장, 준비!)","spans":[{"text":"띠디디삐비——\n(퇴장, 준비!)"}]}],"stageRaw":{"imgTween":[{"imgId":176,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":true},{"imgId":177,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":false}]},"next":"cpt_undline_04_04#9"},"cpt_undline_04_04#9":{"id":"cpt_undline_04_04#9","act":9,"kind":"dialogue","speaker":{"heroId":1070,"name":"운디네","rawName":"운디네","isProfessor":false,"faces":[{"imgId":170,"faceId":2}]},"u