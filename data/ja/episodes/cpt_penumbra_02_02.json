:{"imgTween":[{"imgId":183,"delay":0,"duration":0,"posId":3,"alpha":0,"isDark":false},{"imgId":183,"delay":0,"duration":0.2,"alpha":1,"shake":true,"isDark":false},{"imgId":183,"delay":0.5,"duration":0.2,"alpha":1,"shake":true,"isDark":false}],"heroFace":[{"imgId":183,"faceId":10}]},"next":"cpt_penumbra_02_02#35"},"cpt_penumbra_02_02#35":{"id":"cpt_penumbra_02_02#35","act":35,"kind":"narration","units":[{"uid":"cpt_penumbra_02_02#35","rawText":"スヴァローグ重工、研究所。オメガ07開発チーム内部会議。","displayText":"スヴァローグ重工、研究所。オメガ07開発チーム内部会議。","spans":[{"text":"スヴァローグ重工、研究所。オメガ07開発チーム内部会議。"}]}],"stageRaw":{"imgTween":[{"imgId":183,"delay":0,"duration":0.2,"alpha":0,"isDark":false},{"imgId":1,"delay":0,"duration":0.6,"alpha":0}]},"next":"cpt_penumbra_02_02#36"},"cpt_penumbra_02_02#36":{"id":"cpt_penumbra_02_02#36","act":36,"kind":"dialogue","speaker":{"name":"研究員1","rawName":"研究員1","isProfessor":false,"lookup":"연구원1"},"units":[{"uid":"cpt_penumbra_02_02#36","rawText":"OpsTecを回収するの？","displayText":"OpsTecを回収するの？","spans":[{"text":"OpsTecを回収するの？"}]}],"stageRaw":{"imgTween":[{"imgId":2,"delay":0,"duration":1,"alpha":1}],"ppv":{"cg":{"saturation":-70}}},"next":"cpt_penumbra_02_02#37"},"cpt_penumbra_02_02#37":{"id":"cpt_penumbra_02_02#37","act":37,"kind":"dialogue","speaker":{"name":"研究員2","rawName":"研究員2","isProfessor":false,"lookup":"연구원2"},"units":[{"uid":"cpt_penumbra_02_02#37","rawText":"ああ、ハサンが失脚した。\n光学迷彩のテスト用モデルであるOpsTecを放置しておけば、\n技術が漏洩するおそれがある。","displayText":"ああ、ハサンが失脚した。\n光学迷彩のテスト用モデルであるOpsTecを放置しておけば、\n技術が漏洩するおそれがある。","spans":[{"text":"ああ、ハサンが失脚した。\n光学迷彩のテスト用モデルであるOpsTecを放置しておけば、\n技術が漏洩するおそれがある。"}]}],"next":"cpt_penumbra_02_02#38"},"cpt_penumbra_02_02#38":{"id":"cpt_penumbra_02_02#38","act":38,"kind":"dialogue","speaker":{"name":"研究員3","rawName":"研究員3","isProfessor":false,"lookup":"연구원3"},"units":[{"uid":"cpt_penumbra_02_02#38","rawText":"だからって、回収してどうなるんです？\n光学迷彩のテストは終了しました。\n彼のようなテスト用人形を、他の分野に応用できるはずもない。","displayText":"だからって、回収してどうなるんです？\n光学迷彩のテストは終了しました。\n彼のようなテスト用人形を、他の分野に応用できるはずもない。","spans":[{"text":"だからって、回収してどうなるんです？\n光学迷彩のテストは終了しました。\n彼のようなテスト用人形を、他の分野に応用できるはずもない。"}]}],"next":"cpt_penumbra_02_02#39"},"cpt_penumbra_02_02#39":{"id":"cpt_penumbra_02_02#39","act":39,"kind":"dialogue","speaker":{"name":"研究員2","rawName":"研究員2","isProfessor":false,"lookup":"연구원2"},"units":[{"uid":"cpt_penumbra_02_02#39","rawText":"哀れだな。記録データを削除して、民生用人形に転用することも不可能だとは。","displayText":"哀れだな。記録データを削除して、民生用人形に転用することも不可能だとは。","spans":[{"text":"哀れだな。記録データを削除して、民生用人形に転用することも不可能だとは。"}]}],"next":"cpt_penumbra_02_02#40"},"cpt_penumbra_02_02#40":{"id":"cpt_penumbra_02_02#40","act":40,"kind":"dialogue","speaker":{"name":"研究員1","rawName":"研究員1","isProfessor":false,"lookup":"연구원1"},"units":[{"uid":"cpt_penumbra_02_02#40","rawText":"あの子、すごく不器用だから、基本的な生活もままならないでしょうね。\n人間社会に溶け込むなんてできっこないわ。\nそれどころか、世界を脅かすテロリストになりかねない……","displayText":"あの子、すごく不器用だから、基本的な生活もままならないでしょうね。\n人間社会に溶け込むなんてできっこないわ。\nそれどころか、世界を脅かすテロリストになりかねない……","spans":[{"text":"あの子、すごく不器用だから、基本的な生活もままならないでしょうね。\n人間社会に溶け込むなんてできっこないわ。\nそれどころか、世界を脅かすテロリストになりかねない……"}]}],"next":"cpt_penumbra_02_02#41"},"cpt_penumbra_02_02#41":{"id":"cpt_penumbra_02_02#41","act":41,"kind":"narration","units":[{"uid":"cpt_penumbra_02_02#41","rawText":"光学迷彩を用いて、会議室の窓の外に潜んでいたペナンブラは、すべてを聞いていた。\n数日前、彼はスヴァローグ重工の研究員によって研究所へと連れ戻され、\nその後しばらく監禁されていたのだ。\n待遇としては、ハサンのもとで働いていた時と、なんら変わりなかった。","displayText":"光学迷彩を用いて、会議室の窓の外に潜んでいたペナンブラは、すべてを聞いていた。\n数日前、彼はスヴァローグ重工の研究員によって研究所へと連れ戻され、\nその後しばらく監禁されていたのだ。\n待遇としては、ハサンのもとで働いていた時と、なんら変わりなかった。","spans":[{"text":"光学迷彩を用いて、会議室の窓の外に潜んでいたペナンブラは、すべてを聞いていた。\n数日前、彼はスヴァローグ重工の研究員によって研究所へと連れ戻され、\nその後しばらく監禁されていたのだ。\n待遇としては、ハサンのもとで働いていた時と、なんら変わりなかった。"}]}],"next":"cpt_penumbra_02_02#42"},"cpt_penumbra_02_02#42":{"id":"cpt_penumbra_02_02#42","act":42,"kind":"narration","units":[{"uid":"cpt_penumbra_02_02#42","rawText":"素体の検査中に、ペナンブラはメンテナンススタッフを気絶させ、\n光学迷彩を利用して逃げ出した。彼は、自身の記憶が再び消されるのを知っていた。\nそこで、旧式の録音機をこっそりと起動させておいたのだ。","displayText":"素体の検査中に、ペナンブラはメンテナンススタッフを気絶させ、\n光学迷彩を利用して逃げ出した。彼は、自身の記憶が再び消されるのを知っていた。\nそこで、旧式の録音機をこっそりと起動させておいたのだ。","spans":[{"text":"素体の検査中に、ペナンブラはメンテナンススタッフを気絶させ、\n光学迷彩を利用して逃げ出した。彼は、自身の記憶が再び消されるのを知っていた。\nそこで、旧式の録音機をこっそりと起動させておいたのだ。"}]}],"stageRaw":{"imgTween":[{"imgId":2,"delay":0,"duration":0.6,"alpha":0,"shake":true}]},"next":"cpt_penumbra_02_02#43"},"cpt_penumbra_02_02#43":{"id":"cpt_penumbra_02_02#43","act":43,"kind":"narration","units":[{"uid":"cpt_penumbra_02_02#43","rawText":"この会話はありのまま保存され、何度も何度も、繰り返し再生された。","displayText":"この会話はありのまま保存され、何度も何度も、繰り返し再生された。","spans":[{"text":"この会話はありのまま保存され、何度も何度も、繰り返し再生された。"}]}],"next":"cpt_penumbra_02_02#44"},"cpt_penumbra_02_02#44":{"id":"cpt_penumbra_02_02#44","act":44,"kind":"narration","units":[{"uid":"cpt_penumbra_02_02#44","rawText":"戦場で傷つき壊れたパーツと同じだ――\n人間に必要とされなければ、自身の存在意義は失われる。","displayText":"戦場で傷つき壊れたパーツと同じだ――\n人間に必要とされなければ、自身の存在意義は失われる。","spans":[{"text":"戦場で傷つき壊れたパーツと同じだ――\n人間に必要とされなければ、自身の存在意義は失われる。"}]}],"next":"cpt_penumbra_02_02#45"},"cpt_penumbra_02_02#45":{"id":"cpt_penumbra_02_02#45","act":45,"kind":"dialogue","speaker":{"heroId":194,"name":"警備員","rawName":"警備員","isProfessor":false,"lookup":"경비원"},"units":[{"uid":"cpt_penumbra_02_02#45","rawText":"<size=36>OpsTecが……OpsTecが監禁室から脱走しました！！</size>","displayText":"OpsTecが……OpsTecが監禁室から脱走しました！！","spans":[{"text":"OpsTecが……OpsTecが監禁室から脱走しました！！","styles":[{"type":"size","value":36}]}],"shake":true}],"stageRaw":{"imgTween":[{"imgId":2,"delay":0,"duration":0.6,"alpha":1},{"imgId":194,"delay":0,"duration":0,"posId":3,"alpha":0,"isDark":false},{"imgId":194,"delay":0.6,"duration":0.2,"alpha":1,"shake":true,"isDark":false}]},"next":"cpt_penumbra_02_02#46"},"cpt_penumbra_02_02#46":{"id":"cpt_penumbra_02_02#46","act":46,"kind":"narration","units":[{"uid":"cpt_penumbra_02_02#46","rawText":"警備員が大慌てで会議室へと駆けつけた。\n室内は騒然となる。だが、ペナンブラが自ら姿を現したことで、騒ぎは収まった。","displayText":"警備員が大慌てで会議室へと駆けつけた。\n室内は騒然となる。だが、ペナンブラが自ら姿を現したことで、騒ぎは収まった。","spans":[{"text":"警備員が大慌てで会議室へと駆けつけた。\n室内は騒然となる。だが、ペナンブラが自ら姿を現したことで、騒ぎは収まった。"}]}],"stageRaw":{"imgTween":[{"imgId":194,"delay":0,"duration":0.2,"alpha":0,"isDark":false}]},"next":"cpt_penumbra_02_02#47"},"cpt_penumbra_02_02#47":{"id":"cpt_penumbra_02_02#47","act":47,"kind":"narration","units":[{"uid":"cpt_penumbra_02_02#47","rawText":"彼の記憶はまたしても消去された、何一つ残らず。","displayText":"彼の記憶はまたしても消去された、何一つ残らず。","spans":[{"text":"彼の記憶はまたしても消去された、何一つ残らず。"}]}],"stageRaw":{"imgTween":[{"imgId":2,"delay":0,"duration":0.6,"alpha":0},{"imgId":3,"delay":0,"duration":0.2,"alpha":1,"isDark":false},{"imgId":3,"delay":0.2,"duration":0.2,"alpha":0,"isDark":false},{"imgId":4,"delay":0.4,"duration":0.2,"alpha":1,"isDark":false},{"imgId":4,"delay":0.6,"duration":0.2,"alpha":0,"isDark":false}]},"next":"cpt_penumbra_02_02#48"},"cpt_penumbra_02_02#48":{"id":"cpt_penumbra_02_02#48","act":48,"kind":"dialogue","speaker":{"heroId":1083,"name":"ペナンブラ","rawName":"ペナンブラ","isProfessor":false,"lookup":"페넘브라"},"units":[{"uid":"cpt_penumbra_02_02#48","rawText":"フッ……主を失った番犬以上に、相応しい形容はないな。","displayText":"フッ……主を失った番犬以上に、相応しい形容はないな。","spans":[{"text":"フッ……主を失った番犬以上に、相応しい形容はないな。"}]}],"stageRaw":{"imgTween":[{"imgId":183,"delay":0,"duration":0.2,"alpha":1,"isDark":false}]},"next":"cpt_penumbra_02_02#49"},"cpt_penumbra_02_02#49":{"id":"cpt_penumbra_02_02#49","act":49,"kind":"narration","units":[{"uid":"cpt_penumbra_02_02#49","rawText":"ペナンブラは黙って監禁室の隅に腰掛け、自嘲するような笑顔を浮かべた。\nしかし、数秒後に寂しげな表情が取って代わる。","displayText":"ペナンブラは黙って監禁室の隅に腰掛け、自嘲するような笑顔を浮かべた。\nしかし、数秒後に寂しげな表情が取って代わる。","spans":[{"text":"ペナンブラは黙って監禁室の隅に腰掛け、自嘲するような笑顔を浮かべた。\nしかし、数秒後に寂しげな表情が取って代わる。"}]}],"stageRaw":{"imgTween":[{"imgId":183,"delay":0,"duration":0.2,"alpha":0,"isDark":false}]},"next":"cpt_penumbra_02_02#50"},"cpt_penumbra_02_02#50":{"id":"cpt_penumbra_02_02#50","act":50,"kind":"narration","units":[{"uid":"cpt_penumbra_02_02#50","rawText":"監禁室は真っ暗だ。それに気づいた者はいない……","displayText":"監禁室は真っ暗だ。それに気づいた者はいない……","spans":[{"text":"監禁室は真っ暗だ。それに気づいた者はいない……"}]}],"next":null,"end":true}},"worldRecords":{},"report":{"blocks":50,"unreachedActs":[],"warnings":[{"id":"cpt_penumbra_02_02#22","msg":"괄호로 시작하지만 독백 규칙에 맞지 않음","text":"(＾－＾)V 출