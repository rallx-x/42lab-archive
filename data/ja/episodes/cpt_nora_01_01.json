{"imgId":159,"imgType":3,"alpha":0,"imgPath":"nora_avg"},{"imgId":84,"imgType":3,"alpha":0,"imgPath":"refugeeboy_avg"}],"bgColor":2},"next":"cpt_nora_01_01#2"},"cpt_nora_01_01#2":{"id":"cpt_nora_01_01#2","act":2,"kind":"narration","units":[{"uid":"cpt_nora_01_01#2","rawText":"一陣の山風が頬を掠める。風には黄土色の砂利が混ざっていた。\n私は手にしていた雑記帳で、慌てて顔を守った。","displayText":"一陣の山風が頬を掠める。風には黄土色の砂利が混ざっていた。\n私は手にしていた雑記帳で、慌てて顔を守った。","spans":[{"text":"一陣の山風が頬を掠める。風には黄土色の砂利が混ざっていた。\n私は手にしていた雑記帳で、慌てて顔を守った。"}]}],"next":"cpt_nora_01_01#3"},"cpt_nora_01_01#3":{"id":"cpt_nora_01_01#3","act":3,"kind":"narration","units":[{"uid":"cpt_nora_01_01#3","rawText":"さっきの風、人間だったら目を痛めていたことだろう。\n人形の眼球素材は頑丈といえど、砂が入るのはできるだけ避けたい。","displayText":"さっきの風、人間だったら目を痛めていたことだろう。\n人形の眼球素材は頑丈といえど、砂が入るのはできるだけ避けたい。","spans":[{"text":"さっきの風、人間だったら目を痛めていたことだろう。\n人形の眼球素材は頑丈といえど、砂が入るのはできるだけ避けたい。"}]}],"next":"cpt_nora_01_01#4"},"cpt_nora_01_01#4":{"id":"cpt_nora_01_01#4","act":4,"kind":"narration","units":[{"uid":"cpt_nora_01_01#4","rawText":"人間にとっても、人形にとっても、ここは居住に適した場所とは言えそうにない――\n私はそう結論を下したのである。","displayText":"人間にとっても、人形にとっても、ここは居住に適した場所とは言えそうにない――\n私はそう結論を下したのである。","spans":[{"text":"人間にとっても、人形にとっても、ここは居住に適した場所とは言えそうにない――\n私はそう結論を下したのである。"}]}],"next":"cpt_nora_01_01#5"},"cpt_nora_01_01#5":{"id":"cpt_nora_01_01#5","act":5,"kind":"narration","units":[{"uid":"cpt_nora_01_01#5","rawText":"メンタルのネットワーク接続が、だんだんと弱まっている。\n信号のカバー範囲ではないらしい。","displayText":"メンタルのネットワーク接続が、だんだんと弱まっている。\n信号のカバー範囲ではないらしい。","spans":[{"text":"メンタルのネットワーク接続が、だんだんと弱まっている。\n信号のカバー範囲ではないらしい。"}]}],"next":"cpt_nora_01_01#6"},"cpt_nora_01_01#6":{"id":"cpt_nora_01_01#6","act":6,"kind":"narration","units":[{"uid":"cpt_nora_01_01#6","rawText":"面倒だ、家に戻って籠もりたい――\nなんて刺激的だろう、インスピレーションが湧いてくるようだ――\n二つの感情が、私のメンタルの中でもつれ合う。いつものことだ。","displayText":"面倒だ、家に戻って籠もりたい――\nなんて刺激的だろう、インスピレーションが湧いてくるようだ――\n二つの感情が、私のメンタルの中でもつれ合う。いつものことだ。","spans":[{"text":"面倒だ、家に戻って籠もりたい――\nなんて刺激的だろう、インスピレーションが湧いてくるようだ――\n二つの感情が、私のメンタルの中でもつれ合う。いつものことだ。"}]}],"next":"cpt_nora_01_01#7"},"cpt_nora_01_01#7":{"id":"cpt_nora_01_01#7","act":7,"kind":"dialogue","speaker":{"name":"野良","rawName":"野良","isProfessor":false,"lookup":"노라"},"units":[{"uid":"cpt_nora_01_01#7","rawText":"こん角ば曲がりゃあ……あった！","displayText":"こん角ば曲がりゃあ……あった！","spans":[{"text":"こん角ば曲がりゃあ……あった！"}],"shake":true}],"next":"cpt_nora_01_01#8"},"cpt_nora_01_01#8":{"id":"cpt_nora_01_01#8","act":8,"kind":"narration","units":[{"uid":"cpt_nora_01_01#8","rawText":"だが、その村が視界に現れた瞬間、私は気づいた――\nここまで来たのは、無駄足ではなかったと。","displayText":"だが、その村が視界に現れた瞬間、私は気づいた――\nここまで来たのは、無駄足ではなかったと。","spans":[{"text":"だが、その村が視界に現れた瞬間、私は気づいた――\nここまで来たのは、無駄足ではなかったと。"}]}],"next":"cpt_nora_01_01#9"},"cpt_nora_01_01#9":{"id":"cpt_nora_01_01#9","act":9,"kind":"direction","stageRaw":{"imgTween":[{"imgId":1,"delay":0,"duration":1,"alpha":1,"isDark":false},{"imgId":1,"delay":1,"duration":0.4,"alpha":1,"isDark":true},{"imgId":1,"delay":1.4,"duration":0.4,"alpha":1,"isDark":false}]},"next":"cpt_nora_01_01#10"},"cpt_nora_01_01#10":{"id":"cpt_nora_01_01#10","act":10,"kind":"dialogue","speaker":{"heroId":1059,"name":"野良","rawName":"野良","isProfessor":false,"faces":[{"imgId":159,"faceId":8}],"dialogPos":2,"lookup":"노라"},"units":[{"uid":"cpt_nora_01_01#10","rawText":"本当に、本当やった……","displayText":"本当に、本当やった……","spans":[{"text":"本当に、本当やった……"}]}],"stageRaw":{"imgTween":[{"imgId":159,"delay":0,"duration":0,"posId":3,"alpha":0,"isDark":false},{"imgId":159,"delay":0,"duration":0.2,"posId":3,"alpha":1,"isDark":false}],"heroFace":[{"imgId":159,"faceId":8}]},"next":"cpt_nora_01_01#11"},"cpt_nora_01_01#11":{"id":"cpt_nora_01_01#11","act":11,"kind":"narration","units":[{"uid":"cpt_nora_01_01#11","rawText":"オンボロの建物、陰鬱とした空気、まばらな人煙……\nまるで古い映画のワンシーンを切り取ってきたかのような風景。","displayText":"オンボロの建物、陰鬱とした空気、まばらな人煙……\nまるで古い映画のワンシーンを切り取ってきたかのような風景。","spans":[{"text":"オンボロの建物、陰鬱とした空気、まばらな人煙……\nまるで古い映画のワンシーンを切り取ってきたかのような風景。"}]}],"stageRaw":{"imgTween":[{"imgId":159,"delay":0,"duration":0.2,"posId":3,"alpha":0,"isDark":false}]},"next":"cpt_nora_01_01#12"},"cpt_nora_01_01#12":{"id":"cpt_nora_01_01#12","act":1