_luna#4"},"24carnival_luna#4":{"id":"24carnival_luna#4","act":4,"kind":"dialogue","speaker":{"heroId":1074,"name":"ルナ","rawName":"ルナ","isProfessor":false,"lookup":"보름"},"units":[{"uid":"24carnival_luna#4","rawText":"それに……この占いの力は、教授と私の絆と切っても切れない関係にあるわけだし。","displayText":"それに……この占いの力は、教授と私の絆と切っても切れない関係にあるわけだし。","spans":[{"text":"それに……この占いの力は、教授と私の絆と切っても切れない関係にあるわけだし。"}]}],"next":"24carnival_luna#5"},"24carnival_luna#5":{"id":"24carnival_luna#5","act":5,"kind":"dialogue","speaker":{"name":null,"rawName":"bravo","isProfessor":true,"professorVariant":"bravo","lookup":"bravo"},"units":[{"uid":"24carnival_luna#5","rawText":"あの時の君の占いは……数週間連続で、ウィロウの新聞のトップに登ったくらいだしね。","displayText":"あの時の君の占いは……数週間連続で、ウィロウの新聞のトップに登ったくらいだしね。","spans":[{"text":"あの時の君の占いは……数週間連続で、ウィロウの新聞のトップに登ったくらいだしね。"}],"alt":{"f":{"displayText":"あの時のあなたの占い……数週間連続で、\nウィロウの新聞のトップに登ったくらいだしね。","spans":[{"text":"あの時のあなたの占い……数週間連続で、\nウィロウの新聞のトップに登ったくらいだしね。"}]}}}],"stageRaw":{"imgTween":[{"imgId":174,"delay":0,"duration":0.2,"alpha":1,"isDark":true}]},"next":"24carnival_luna#6"},"24carnival_luna#6":{"id":"24carnival_luna#6","act":6,"kind":"dialogue","speaker":{"heroId":1074,"name":"ルナ","rawName":"ルナ","isProfessor":false,"lookup":"보름"},"units":[{"uid":"24carnival_luna#6","rawText":"あはははは……はは……あの時はたしかに、悲惨だったな……","displayText":"あはははは……はは……あの時はたしかに、悲惨だったな……","spans":[{"text":"あはははは……はは……あの時はたしかに、悲惨だったな……"}]}],"stageRaw":{"imgTween":[{"imgId":174,"delay":0,"duration":0.2,"alpha":1,"isDark":false}]},"next":"24carnival_luna#7"},"24carnival_luna#7":{"id":"24carnival_luna#7","act":7,"kind":"dialogue","speaker":{"heroId":1074,"name":"ルナ","rawName":"ルナ","isProfessor":false,"lookup":"보름"},"units":[{"uid":"24carnival_luna#7","rawText":"バーバンクをさまよってた時も……何度も試したの。それなのに、占いはハズレてばかり……なにもかも台無しにするか、落ちこぼれるかの二択。","displayText":"バーバンクをさまよってた時も……何度も試したの。それなのに、占いはハズレてばかり……なにもかも台無しにするか、落ちこぼれるかの二択。","spans":[{"text":"バーバンクをさまよってた時も……何度も試したの。それなのに、占いはハズレてばかり……なにもかも台無しにするか、落ちこぼれるかの二択。"}]}],"next":"24carnival_luna#8"},"24carnival_luna#8":{"id":"24carnival_luna#8","act":8,"kind":"dialogue","speaker":{"heroId":1074,"name":"ルナ","rawName":"ルナ","isProfessor":false,"lookup":"보름"},"units":[{"uid":"24carnival_luna#8","rawText":"でも、オアシスへやってきて、教授やイェレナ、それにイアハートに励まされて。そうしたら、自分の占いに新たな理解が生まれて、無事に占いの力も取り戻せたんだ。","displayText":"でも、オアシスへやってきて、教授やイェレナ、それにイアハートに励まされて。そうしたら、自分の占いに新たな理解が生まれて、無事に占いの力も取り戻せたんだ。","spans":[{"text":"でも、オアシスへやってきて、教授やイェレナ、それにイアハートに励まされて。そうしたら、自分の占いに新たな理解が生まれて、無事に占いの力も取り戻せたんだ。"}]}],"next":"24carnival_luna#9"},"24carnival_luna#9":{"id":"24carnival_luna#9","act":9,"kind":"dialogue","speaker":{"heroId":1074,"name":"ルナ","rawName":"ルナ","isProfessor":false,"lookup":"보름"},"units":[{"uid":"24carnival_luna#9","rawText":"そうだ！せっかくだし、昔話のついでに、教授のもう一つの疑問に答えてあげる……「兆し」が見えるよ……","displayText":"そうだ！せっかくだし、昔話のついでに、教授のもう一つの疑問に答えてあげる……「兆し」が見えるよ……","spans":[{"text":"そうだ！せっかくだし、昔話のついでに、教授のもう一つの疑問に答えてあげる……「兆し」が見えるよ……"}]}],"next":"24carnival_luna#10"},"24carnival_luna#10":{"id":"24carnival_luna#10","act":10,"kind":"dialogue","speaker":{"heroId":1074,"name":"ルナ","rawName":"ルナ","isProfessor":false,"lookup":"보름"},"units":[{"uid":"24carnival_luna#10","rawText":"ううん、見えなくたって、私は信じてる……やがて黒夜は終わり、黎明が訪れると。","displayText":"ううん、見えなくたって、私は信じてる……やがて黒夜は終わり、黎明が訪れると。","spans":[{"text":"ううん、見えなくたって、私は信じてる……やがて黒夜は終わり、黎明が訪れると。"}]}],"next":"24carnival_luna#11"},"24carnival_luna#11":{"id":"24carnival_luna#11","act":11,"kind":"dialogue","speaker":{"heroId":1074,"name":"ルナ","rawName":"ルナ","isProfessor":false,"lookup":"보름"},"units":[{"uid":"24carnival_luna#11","rawText":"もう一つに世界に戻っても、私たちの絆は、けして消えたりしない。","displayText":"もう一つに世界に戻っても、私たちの絆は、けして消えたりしない。","spans":[{"text":"もう一つに世界に戻っても、私たちの絆は、けして消えたりしない。"}]}],"next":null,"end":true}},"worldRecords":{},"report":{"blocks":11,"unreachedActs":[],"warnings":[]}}