":"스에요이"},"units":[{"uid":"cpt_hb_h05#16","rawText":"When I underwent surgery in the medical department once, the lead surgeon said that I wouldn't be able to keep quiet if I had your pain reception module.","displayText":"When I underwent surgery in the medical department once, the lead surgeon said that I wouldn't be able to keep quiet if I had your pain reception module.","spans":[{"text":"When I underwent surgery in the medical department once, the lead surgeon said that I wouldn't be able to keep quiet if I had your pain reception module."}]}],"next":"cpt_hb_h05#17"},"cpt_hb_h05#17":{"id":"cpt_hb_h05#17","act":17,"kind":"dialogue","speaker":{"heroId":1056,"name":"Lind","rawName":"Lind","isProfessor":false,"faces":[{"imgId":156,"faceId":6}],"dialogPos":1,"lookup":"린드"},"units":[{"uid":"cpt_hb_h05#17","rawText":"Even when you're asking a question, you have to praise yourself along the way... That isn't just disgusting, but narcissistic too.","displayText":"Even when you're asking a question, you have to praise yourself along the way... That isn't just disgusting, but narcissistic too.","spans":[{"text":"Even when you're asking a question, you have to praise yourself along the way... That isn't just disgusting, but narcissistic too."}]}],"stageRaw":{"imgTween":[{"imgId":153,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":true},{"imgId":156,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":false}],"heroFace":[{"imgId":156,"faceId":6}]},"next":"cpt_hb_h05#18"},"cpt_hb_h05#18":{"id":"cpt_hb_h05#18","act":18,"kind":"dialogue","speaker":{"heroId":1053,"name":"Sueyoi","rawName":"Sueyoi","isProfessor":false,"faces":[{"imgId":153,"faceId":2}],"dialogPos":3,"lookup":"스에요이"},"units":[{"uid":"cpt_hb_h05#18","rawText":"...You know that's not what I meant.","displayText":"...You know that's not what I meant.","spans":[{"text":"...You know that's not what I meant."}]}],"stageRaw":{"imgTween":[{"imgId":153,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":false},{"