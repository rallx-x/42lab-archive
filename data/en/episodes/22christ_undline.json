4}],"lookup":"운디네"},"units":[{"uid":"22christ_undline#31","rawText":"How come you folded immediately to the Professor's bribes?","displayText":"How come you folded immediately to the Professor's bribes?","spans":[{"text":"How come you folded immediately to the Professor's bribes?"}]}],"stageRaw":{"imgTween":[{"imgId":178,"delay":0,"duration":0.2,"posId":3,"alpha":0,"isDark":false},{"imgId":170,"delay":0,"duration":0.2,"posId":3,"alpha":1,"isDark":false}],"heroFace":[{"imgId":170,"faceId":4}]},"next":"22christ_undline#32"},"22christ_undline#32":{"id":"22christ_undline#32","act":32,"kind":"dialogue","speaker":{"heroId":179,"name":"Maestoso","rawName":"Maestoso","isProfessor":false,"lookup":"마에스"},"units":[{"uid":"22christ_undline#32","rawText":"Dididi, beep—\n(Chief, ordered, Excellency, could be, trusted)","displayText":"Dididi, beep—\n(Chief, ordered, Excellency, could be, trusted)","spans":[{"text":"Dididi, beep—\n(Chief, ordered, Excellency, could be, trusted)"}]}],"stageRaw":{"imgTween":[{"imgId":170,"delay":0,"duration":0.2,"posId":3,"alpha":0,"isDark":false},{"imgId":179,"delay":0,"duration":0,"posId":3,"alpha":0,"isDark":false},{"imgId":179,"delay":0,"duration":0.2,"posId":3,"alpha":1,"isDark":false}]},"next":"22christ_undline#33"},"22christ_undline#33":{"id":"22christ_undline#33","act":33,"kind":"dialogue","speaker":{"heroId":1070,"name":"Undine","rawName":"Undine","isProfessor":false,"faces":[{"imgId":170,"faceId":5}],"lookup":"운디네"},"units":[{"uid":"22christ_undline#33","rawText":"...At times like these, you need to prioritize deception and blocking them.","displayText":"...At times like these, you need to prioritize deception and blocking them.","spans":[{"text":"...At times like these, you need to prioritize deception and blocking them."}]}],"stageRaw":{"imgTween":[{"imgId":179,"delay":0,"duration":0.2,"posId":3,"alpha":0,"isDark":false},{"imgId":170,"delay":0,"duration":0.2,"posId":3,"alpha":1,"isDark":false}],"heroFace":[{"imgId":170,"faceId":5}]},"next":"22christ_undline#34"},"22christ_undline#34":{"id":"22christ_undline#34","act":34,"kind":"narration","units":[{"uid":"22christ_undline#34","rawText":"I successfully slip past their blockade before Undine can react.","displayText":"I successfully slip past their blockade before Undine can react.","spans":[{"text":"I successfully slip past their blockade before Undine can react."}]}],"stageRaw":{"imgTween":[{"imgId":170,"delay":0,"duration":0.2,"posId":3,"alpha":0,"isDark":false}]},"next":"22christ_undline#35"},"22christ_undline#35":{"id":"22christ_undline#35","act":35,"kind":"narration","units":[{"uid":"22christ_undline#35","rawText":"Undine has a gift box without a ribbon behind her.","displayText":"Undine has a gift box without a ribbon behind her.","spans":[{"text":"Undine has a gift box without a ribbon behind her."}]}],"next":"22christ_undline#36"},"22christ_undline#36":{"id":"22christ_undline#36","act":36,"kind":"dialogue","speaker":{"name":null,"rawName":"bravo","isProfessor":true,"professorVariant":"bravo","lookup":"bravo"},"units":[{"uid":"22christ_undline#36","rawText":"What's this?","displayText":"What's this?","spans":[{"text":"What's this?"}]}],"next":"22christ_undline#37"},"22christ_undline#37":{"id":"22christ_undline#37","act":37,"kind":"dialogue","speaker":{"heroId":1070,"name":"Undine","rawName":"Undine","isProfessor":false,"faces":[{"imgId":170,"faceId":2}],"lookup":"운디네"},"units":[{"uid":"22christ_undline#37","rawText":"...I was hoping to give it to you in a more official setting.","displayText":"...I was hoping to give it to you in a more official setting.","spans":[{"text":"...I was hoping to give it to you in a more official setting."}]}],"stageRaw":{"imgTween":[{"imgId":170,"delay":0,"duration":0.2,"posId":3,"alpha":1,"isDark":false}],"heroFace":[{"imgId":170,"faceId":2}]},"next":"22christ_undline#38"},"22christ_undline#38":{"id":"22christ_undline#38","act":38,"kind":"dialogue","speaker":{"heroId":1070,"name":"Undine","rawName":"Undine","isProfessor":false,"lookup":"운디네"},"units":[{"uid":"22christ_undline#38","rawText":"I even chose to prepare it in the Abax Gallery... Looks like I'm just bad at picking the right time and place.","displayText":"I even chose to prepare it in the Abax Gallery... Looks like I'm just bad at picking the right time and place.","spans":[{"text":"I even chose to prepare it in the Abax Gallery... Looks like I'm just bad at picking the right time and place."}]}],"next":"22christ_undline#39"},"22christ_undline#39":{"id":"22christ_undline#39","act":39,"kind":"dialogue","speaker":{"heroId":1070,"name":"Undine","rawName":"Undine","isProfessor":false,"lookup":"운디네"},"units":[{"uid":"22christ_undline#39","rawText":"But since you've already discovered it...","displayText":"But since you've already discovered it...","spans":[{"text":"But since you've already discovered it..."}]}],"next":"22christ_undline#40"},"22christ_undline#40":{"id":"22christ_undline#40","act":40,"kind":"narration","units":[{"uid":"22christ_undline#40","rawText":"Undine picks up the box and offers it to me.","displayText":"Undine picks up the box and offers it to me.","spans":[{"text":"Undine picks up the box and offers it to me."}]}],"stageRaw":{"imgTween":[{"imgId":170,"delay":0,"duration":0.2,"posId":3,"alpha":0,"isDark":false}]},"next":"22christ_undline#41"},"22christ_undline#41":{"id":"22christ_undline#41","act":41,"kind":"dialogue","speaker":{"heroId":1070,"name":"Undine","rawName":"Undine","isProfessor":false,"faces":[{"imgId":170,"faceId":0}],"lookup":"운디네"},"units":[{"uid":"22christ_undline#41","rawText":"Merry Christmas, Professor. This is a little something from Undine's ceremonial orchestra. We hope you like it.","displayText":"Merry Christmas, Professor. This is a little something from Undine's ceremonial orchestra. We hope you like it.","spans":[{"text":"Merry Christmas, Professor. This is a little something from Undine's ceremonial orchestra. We hope you like it."}]}],"stageRaw":{"imgTween":[{"imgId":170,"delay":0,"duration":0.2,"posId":3,"alpha":1,"isDark":false}],"heroFace":[{"imgId":170,"faceId":0}]},"next":"22christ_undline#42"},"22christ_undline#42":{"id":"22christ_undline#42","act":42,"kind":"dialogue","speaker":{"name":null,"rawName":"bravo","isProfessor":true,"professorVariant":"bravo","lookup":"bravo"},"units":[{"uid":"22christ_undline#42","rawText":"Thank you. May I open it?","displayText":"Thank you. May I open it?","spans":[{"text":"Thank you. May I open it?"}]}],"stageRaw":{"imgTween":[{"imgId":170,"delay":0,"duration":0.2,"posId":3,"alpha":1,"isDark":true}]},"next":"22christ_undline#43"},"22christ_undline#43":{"id":"22christ_undline#43","act":43,"kind":"dialogue","speaker":{"heroId":1070,"name":"Undine","rawName":"Undine","isProfessor":false,"lookup":"운디네"},"units":[{"uid":"22christ_undline#43","rawText":"Things being what they are now, there's no need for complicated formalities. By all means, Professor.","displayText":"Things being what they are now, there's no need for complicated formalities. By all means, Professor.","spans":[{"text":"Things being what they are now, there's no need for complicated formalities. By all means, Professor."}]}],"stageRaw":{"imgTween":[{"imgId":170,"delay":0,"duration":0.2,"posId":3,"alpha":1,"isDark":false}]},"next":"22christ_undline#44"},"22christ_undline#44":{"id":"22christ_undline#44","act":44,"kind":"narration","units":[{"uid":"22christ_undline#44","rawText":"I open the box and find an exquisite music box within.","displayText":"I open the box and find an exquisite music box within.","spans":[{"text":"I open the box and find an exquisite music box within."}]}],"stageRaw":{"imgTween":[{"imgId":170,"delay":0,"duration":0.2,"posId":3,"alpha":0,"isDark":false}]},"next":"22christ_undline#45"},"22christ_undline#45":{"id":"22christ_undline#45","act":45,"kind":"narration","units":[{"uid":"22christ_undline#45","rawText":"I lightly turn its knob, and soothing music washes out from it.","displayText":"I lightly turn its knob, and soothing music washes out from it.","spans":[{"text":"I lightly turn its knob, and soothing music washes out from it."}]}],"next":"22christ_undline#46"},"22christ_undline#46":{"id":"22christ_undline#46","act":46,"kind":"dialogue","speaker":{"name":null,"rawName":"bravo","isProfessor":true,"professorVariant":"bravo","lookup":"bravo"},"units":[{"uid":"22christ_undline#46","rawText":"This... Is this from one of your shows?","displayText":"This... Is this from one of your shows?","spans":[{"text":"This... Is this from one of your shows?"}]}],"next":"22christ_undline#47"},"22christ_undline#47":{"id":"22christ_undline#47","act":47,"kind":"dialogue","speaker":{"heroId":1070,"name":"Undine","rawName":"Undine","isProfessor":false,"faces":[{"imgId":170,"faceId":2}],"lookup":"운디네"},"units":[{"uid":"22christ_undline#47","rawText":"This is the only way we have to express our thanks. Thank you, Professor.","displayText":"This is the only way we have to express our thanks. Thank you, Professor.","spans":[{"text":"This is the only way we have to express our thanks. Thank you, Professor."}]}],"stageRaw":{"imgTween":[{"imgId":170,"delay":0,"duration":0.2,"posId":3,"alpha":1,"isDark":false}],"heroFace":[{"imgId":170,"faceId":2}]},"next":"22christ_undline#48"},"22christ_undline#48":{"id":"22christ_undline#48","act":48,"kind":"dialogue","speaker":{"heroId":1070,"name":"Undine","rawName":"Undine","isProfessor":false,"lookup":"운디네"},"units":[{"uid":"22christ_undline#48","rawText":"You gave us a home for the first tune... And allowed us to stand on a different kind of stage.","displayText":"You gave us a home for the first tune... And allowed us to stand on a different kind of stage.","spans":[{"text":"You gave us a home for the first tune... And allowed us to stand on a different kind of stage."}]}],"next":"22christ_undline#49"},"22christ_undline#49":{"id":"22christ_undline#49","act":49,"kind":"dialogue","speaker":{"heroId":1070,"name":"Undine","rawName":"Undine","isProfessor":fal