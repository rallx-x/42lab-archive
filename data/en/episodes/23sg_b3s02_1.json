"},"units":[{"uid":"23sg_b3s02_1#23","rawText":"As- as if! Don't forget, I'm an insane mad scientist! A few monsters don't scare me!","displayText":"As- as if! Don't forget, I'm an insane mad scientist! A few monsters don't scare me!","spans":[{"text":"As- as if! Don't forget, I'm an insane mad scientist! A few monsters don't scare me!"}],"shake":true}],"stageRaw":{"imgTween":[{"imgId":176,"delay":0,"duration":0.2,"alpha":1,"isDark":true}]},"next":"23sg_b3s02_1#24"},"23sg_b3s02_1#24":{"id":"23sg_b3s02_1#24","act":24,"kind":"narration","units":[{"uid":"23sg_b3s02_1#24","rawText":"Despite my words, I can't hide the trembling of my hands.","displayText":"Despite my words, I can't hide the trembling of my hands.","spans":[{"text":"Despite my words, I can't hide the trembling of my hands."}]}],"stageRaw":{"imgTween":[{"imgId":176,"delay":0,"duration":0.2,"alpha":0,"isDark":true}]},"next":"23sg_b3s02_1#25"},"23sg_b3s02_1#25":{"id":"23sg_b3s02_1#25","act":25,"kind":"dialogue","speaker":{"heroId":1076,"name":"Erika","rawName":"Erika","isProfessor":false,"faces":[{"imgId":176,"faceId":2}],"lookup":"에리카"},"units":[{"uid":"23sg_b3s02_1#25","rawText":"Is that so... Alright then. Call me if you need help.","displayText":"Is that so... Alright then. Call me if you need help.","spans":[{"text":"Is that so... Alright then. Call me if you need help."}]}],"stageRaw":{"imgTween":[{"imgId":176,"delay":0,"duration":0.2,"alpha":1,"isDark":false}],"heroFace":[{"imgId":176,"faceId":2}]},"next":"23sg_b3s02_1#26"},"23sg_b3s02_1#26":{"id":"23sg_b3s02_1#26","act":26,"kind":"narration","units":[{"uid":"23sg_b3s02_1#26","rawText":"Erika doesn't say anything else. She simply pats my shoulder and prepares for battle.","displayText":"Erika doesn't say anything else. She simply pats my shoulder and prepares for battle.","spans":[{"text":"Erika doesn't say anything else. She simply pats my shoulder and prepares for battle."}]}],"stageRaw":{"imgTween":[{"imgId":176,"delay":0,"duration":0.2,"alpha":0,"