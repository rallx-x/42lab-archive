er":{"heroId":1068,"name":"Dupin","rawName":"Dupin","isProfessor":false,"lookup":"뒤팽"},"units":[{"uid":"cpt_dupin_04_04#18","rawText":"This device... It must have been installed after yesterday's inspection was finished.","displayText":"This device... It must have been installed after yesterday's inspection was finished.","spans":[{"text":"This device... It must have been installed after yesterday's inspection was finished."}]}],"stageRaw":{"imgTween":[{"imgId":168,"delay":0,"duration":0.2,"posId":3,"alpha":1,"isDark":false}]},"next":"cpt_dupin_04_04#19"},"cpt_dupin_04_04#19":{"id":"cpt_dupin_04_04#19","act":19,"kind":"dialogue","speaker":{"heroId":1068,"name":"Dupin","rawName":"Dupin","isProfessor":false,"faces":[{"imgId":168,"faceId":5}],"lookup":"뒤팽"},"units":[{"uid":"cpt_dupin_04_04#19","rawText":"It looks like that kidnapping you instigated last night was to complete this \"way out\" of yours, right?","displayText":"It looks like that kidnapping you instigated last night was to complete this \"way out\" of yours, right?","spans":[{"text":"It looks like that kidnapping you instigated last night was to complete this \"way out\" of yours, right?"}]}],"stageRaw":{"heroFace":[{"imgId":168,"faceId":5}]},"next":"cpt_dupin_04_04#20"},"cpt_dupin_04_04#20":{"id":"cpt_dupin_04_04#20","act":20,"kind":"dialogue","speaker":{"name":"LeBlanc","rawName":"<color=red>LeBlanc</color>","isProfessor":false,"lookup":"<color=red>르블랑</color>"},"units":[{"uid":"cpt_dupin_04_04#20","rawText":"<color=red>Indeed, oh astute great detective. Unfortunately, we will have to meet again some other time.</color>","displayText":"Indeed, oh astute great detective. Unfortunately, we will have to meet again some other time.","spans":[{"text":"Indeed, oh astute great detective. Unfortunately, we will have to meet again some other time.","styles":[{"type":"color","value":"red"}]}]}],"stageRaw":{"imgTween":[{"imgId":168,"delay":0,"duration":0.2,"posId":3,"alpha":1,"isDark":true}]},"next":"cpt_dupin_04_04#21"},"cpt_dupin_04_04#21":{"id":"cpt_dupin_04_04#21","act":21,"kind":"narration","units":[{"uid":"cpt_dupin_04_04#21","rawText":"And with that, LeBlanc vanishes from view.\nOnly a loudspeaker hidden in parts unknown continues to transmit his voice.","displayText":"And with that, LeBlanc vanishes from view.\nOnly a loudspeaker hidden in parts unknown continues to transmit his voice.","spans":[{"text":"And with that, LeBlanc vanishes from view.\nOnly a loudspeaker hidden in parts unknown continues to transmit his voice."}]}],"next":"cpt_dupin_04_04#22"},"cpt_dupin_04_04#22":{"id":"cpt_dupin_04_04#22","act":22,"kind":"dialogue","speaker":{"name":"LeBlanc","rawName":"<color=red>LeBlanc</color>","isProfessor":false,"lookup":"<color=red>르블랑</color>"},"units":[{"uid":"cpt_dupin_04_04#22","rawText":"If you hadn't stepped into my trap, you'd have caught me by now. Do you regret it?","displayText":"If you hadn't stepped into my trap, you'd have caught me by now. Do you regret it?","spans":[{"text":"If you hadn't stepped into my trap, you'd have caught me by now. Do you regret it?"}]}],"next":"cpt_dupin_04_04#23"},"cpt_dupin_04_04#23":{"id":"cpt_dupin_04_04#23","act":23,"kind":"dialogue","speaker":{"heroId":1068,"name":"Dupin","rawName":"Dupin","isProfessor":false,"faces":[{"imgId":168,"faceId":4}],"lookup":"뒤팽"},"units":[{"uid":"cpt_dupin_04_04#23","rawText":"...Not at all.","displayText":"...Not at all.","spans":[{"text":"...Not at all."}]}],"stageRaw":{"imgTween":[{"imgId":168,"delay":0,"duration":0.2,"posId":3,"alpha":1,"isDark":false}],"heroFace":[{"imgId":168,"faceId":4}]},"next":"cpt_dupin_04_04#24"},"cpt_dupin_04_04#24":{"id":"cpt_dupin_04_04#24","act":24,"kind":"dialogue","speaker":{"heroId":1068,"name":"Dupin","rawName":"Dupin","isProfessor":false,"faces":[{"imgId":168,"faceId":0}],"lookup":"뒤팽"},"units":[{"uid":"cpt_dupin_04_04#24","rawText":"If I hadn't taken the bait, and if I hadn't had Aki's help, I wouldn't have been able to secure the Juuzumaru Tsunetsugu either.","displayText":"If I hadn't taken the bait, and if I hadn't had Aki's help, I wouldn't have been able to secure the Juuzumaru Tsunetsugu either.","spans":[{"text":"If I hadn't taken the bait, and if I hadn't had Aki's help, I wouldn't have been able to secure the Juuzumaru Tsunetsugu either."}]}],"stageRaw":{"heroFace":[{"imgId":168,"faceId":0}]},"next":"cpt_dupin_04_04#25"},"cpt_dupin_04_04#25":{"id":"cpt_dupin_04_04#25","act":25,"kind":"dialogue","speaker":{"heroId":1068,"name":"Dupin","rawName":"Dupin","isProfessor":false,"lookup":"뒤팽"},"units":[{"uid":"cpt_dupin_04_04#25","rawText":"This time round, we're even.","displayText":"This time round, we're even.","spans":[{"text":"This time round, we're even."}]}],"next":"cpt_dupin_04_04#26"},"cpt_dupin_04_04#26":{"id":"cpt_dupin_04_04#26","act":26,"kind":"dialogue","speaker":{"name":"LeBlanc","rawName":"<color=red>LeBlanc</color>","isProfessor":false,"lookup":"<color=red>르블랑</color>"},"units":[{"uid":"cpt_dupin_04_04#26","rawText":"<color=red>Oh yes. This time, you had Aki's help.</color>","displayText":"Oh yes. This time, you had Aki's help.","spans":[{"text":"Oh yes. This time, you had Aki's help.","styles":[{"type":"color","value":"red"}]}]}],"stageRaw":{"imgTween":[{"imgId":168,"delay":0,"duration":0.2,"posId":3,"alpha":1,"isDark":true}]},"next":"cpt_dupin_04_04#27"},"cpt_dupin_04_04#27":{"id":"cpt_dupin_04_04#27","act":27,"kind":"dialogue","speaker":{"name":"LeBlanc","rawName":"<color=red>LeBlanc</color>","isProfessor":false,"lookup":"<color=red>르블랑</color>"},"units":[{"uid":"cpt_dupin_04_04#27","rawText":"<color=red>Do you think you can stop me with only your own strength next time?</color>","displayText":"Do you think you can stop me with only your own strength next time?","spans":[{"text":"Do you think you can stop me with only your own strength next time?","styles":[{"type":"color","value":"red"}]}]}],"next":"cpt_dupin_04_04#28"},"cpt_dupin_04_04#28":{"id":"cpt_dupin_04_04#28","act":28,"kind":"dialogue","speaker":{"heroId":1068,"name":"Dupin","rawName":"Dupin","isProfessor":false,"faces":[{"imgId":168,"faceId":4}],"lookup":"뒤팽"},"units":[{"uid":"cpt_dupin_04_04#28","rawText":"...","displayText":"...","spans":[{"text":"..."}]}],"stageRaw":{"imgTween":[{"imgId":168,"delay":0,"duration":0.2,"posId":3,"alpha":1,"isDark":false}],"heroFace":[{"imgId":168,"faceId":4}]},"next":"cpt_dupin_04_04#29"},"cpt_dupin_04_04#29":{"id":"cpt_dupin_04_04#29","act":29,"kind":"dialogue","speaker":{"heroId":1068,"name":"Dupin","rawName":"Dupin","isProfessor":false,"faces":[{"imgId":168,"faceId":0}],"lookup":"뒤팽"},"units":[{"uid":"cpt_dupin_04_04#29","rawText":"You're wrong, LeBlanc.","displayText":"You're wrong, LeBlanc.","spans":[{"text":"You're wrong, LeBlanc."}]}],"stageRaw":{"heroFace":[{"imgId":168,"faceId":0}]},"next":"cpt_dupin_04_04#30"},"cpt_dupin_04_04#30":{"id":"cpt_dupin_04_04#30","act":30,"kind":"dialogue","speaker":{"heroId":1068,"name":"Dupin","rawName":"Dupin","isProfessor":false,"lookup":"뒤팽"},"units":[{"uid":"cpt_dupin_04_04#30","rawText":"Everything I've done, my obsession, my choices, my partners—all of them are my strength.","displayText":"Everything I've done, my obsession, my choices, my partners—all of them are my strength.","spans":[{"text":"Everything I've done, my obsession, my choices, my partners—all of them are my strength."}]}],"next":"cpt_dupin_04_04#31"},"cpt_dupin_04_04#31":{"id":"cpt_dupin_04_04#31","act":31,"kind":"dialogue","speaker":{"name":"LeBlanc","rawName":"<color=red>LeBlanc</color>","isProfessor":false,"lookup":"<color=red>르블랑</color>"},"units":[{"uid":"cpt_dupin_04_04#31","rawText":"<color=red>You consider Aki part of your strength?</color>","displayText":"You consider Aki part of your strength?","spans":[{"text":"You consider Aki part of your strength?","styles":[{"type":"color","value":"red"}]}]}],"stageRaw":{"imgTween":[{"imgId":168,"delay":0,"duration":0.2,"posId":3,"alpha":1,"isDark":true}]},"next":"cpt_dupin_04_04#32"},"cpt_dupin_04_04#32":{"id":"cpt_dupin_04_04#32","act":32,"kind":"dialogue","speaker":{"heroId":1015,"name":"Aki","rawName":"Aki","isProfessor":false,"faces":[{"imgId":115,"faceId":3}],"lookup":"아키"},"units":[{"uid":"cpt_dupin_04_04#32","rawText":"Hm? Can't he? That's how partners are, no?","displayText":"Hm? Can't he? That's how partners are, no?","spans":[{"text":"Hm? Can't he? That's how partners are, no?"}]}],"stageRaw":{"imgTween":[{"imgId":168,"delay":0,"duration":0.2,"posId":3,"alpha":0,"isDark":true},{"imgId":115,"delay":0,"duration":0,"posId":3,"alpha":0,"isDark":false},{"imgId":115,"delay":0,"duration":0.2,"posId":3,"alpha":1,"isDark":false}],"heroFace":[{"imgId":115,"faceId":3}]},"next":"cpt_dupin_04_04#33"},"cpt_dupin_04_04#33":{"id":"cpt_dupin_04_04#33","act":33,"kind":"dialogue","speaker":{"name":"LeBlanc","rawName":"<color=red>LeBlanc</color>","isProfessor":false,"lookup":"<color=red>르블랑</color>"},"units":[{"uid":"cpt_dupin_04_04#33","rawText":"<color=red>I see... Is that how you think? I have to say, I'm envious.</color>","displayText":"I see... Is that how you think? I have to say, I'm envious.","spans":[{"text":"I see... Is that how you think? I have to say, I'm envious.","styles":[{"type":"color","value":"red"}]}]}],"stageRaw":{"imgTween":[{"imgId":115,"delay":0,"duration":0.2,"posId":3,"alpha":1,"isDark":true}]},"next":"cpt_dupin_04_04#34"},"cpt_dupin_04_04#34":{"id":"cpt_dupin_04_04#34","act":34,"kind":"dialogue","speaker":{"name":"LeBlanc","rawName":"<color=red>LeBlanc</color>","isProfessor":false,"lookup":"<color=red>르블랑</color>"},"units":[{"uid":"cpt_dupin_04_04#34","rawText":"<color=red>Very well, then. If our places were changed, would Aki have become my strength as well?</color>","displayText":"Very well, then. If our places were changed, would Aki have become my strength as well?","spans":[{"text":"Very well, then. If our places were changed, would Aki have become my strength as well?","styles":[{"type":"color","value":"red"}]}]}],"next":"cpt_dupin_04_04#35"},"cpt_dupin_04_04#35":{"id":"cpt_dupin_04_04#35","act":35,"kind":"dialogue","speaker":{"heroId":1015,"name":"Aki","rawName":"Aki","isProfessor":false,"faces":[{"imgId":115,"faceId":5}],"dialogPos":2,"lookup":"아키"},"units":[{"uid":"cpt_dupin_04_04#35","rawText":"...Hah?","displayText":"...Hah?","spans":[{"text":"...Hah?"}]}],"stageRaw":{"imgTween":[{"imgId":115,"delay":0,"duration":0.2,"posId":3,"alpha":1,"shake":true,"isDark":false}],"heroFace":[{"imgId":115,"faceId":5}]},"next":"cpt_dupin_04_04#36"},"cpt_dupin_04_04#36":{"id":"cpt_dupin_04_04#36","act":36,"kind":"dialogue","speaker":{"heroId":1068,"name":"Dupin","rawName":"Dupin","isProfessor":false,"faces":[{"imgId":168,"faceId":2}],"lookup":"뒤팽"},"units":[{"uid":"cpt_dupin_04_04#36","rawText":"If there is a next time, I hope you won't treat others as toys to play with and arrange as you wish.","displayText":"If there is a next time, I hope you won't treat others as toys to play with and arrange as you wish.","spans":[{"text":"If there is a next time, I hope you won't treat others as toys to play with and arrange as you wish."}]}],"stageRaw":{"imgTween":[{"imgId":115,"delay":0,"duration":0.2,"posId":3,"alpha":0,"isDark":false},{"imgId":168,"delay":0,"duration":0.2,"posId":3,"alpha":1,"isDark":false}],"heroFace":[{"imgId":168,"faceId":2}]},"next":"cpt_dupin_04_04#37"},"cpt_dupin_04_04#37":{"id":"cpt_dupin_04_04#37","act":37,"kind":"dialogue","speaker":{"name":"LeBlanc","rawName":"<color=red>LeBlanc</color>","isProfessor":false,"lookup":"<color=red>르블랑</color>"},"units":[{"uid":"cpt_dupin_04_04#37","rawText":"<color=red>Toys... what a lovely way to put it.</color>","displayText":"Toys... what a lovely way to put it.","spans":[{"text":"Toys... what a lovely way to put it.","styles":[{"type":"color","value":"red"}]}]}],"stageRaw":{"imgTween":[{"imgId":168,"delay":0,"duration":0.2,"posId":3,"alpha":1,"isDark":true}]},"next":"cpt_dupin_04_04#38"},"cpt_dupin_04_04#38":{"id":"cpt_dupin_04_04#38","act":38,"kind":"dialogue","speaker":{"heroId":1068,"name":"Dupin","rawName":"Dupin","isProfessor":false,"faces":[{"imgId":168,"faceId":0}],"lookup":"뒤팽"},"units":[{"uid":"cpt_dupin_04_04#38","rawText":"Before I met you, I didn't have a rival. Mysteries were too simple for me...","displayText":"Before I met you, I didn't have a rival. Mysteries were too simple for me...","spans":[{"text":"Before I met you, I didn't have a rival. Mysteries were too simple for me..."}]}],"stageRaw":{"imgTween":[{"imgId":168,"delay":0,"duration":0.2,"posId":3,"alpha":1,"isDark":false}],"heroFace":[{"imgId":168,"faceId":0}]},"next":"cpt_dupin_04_04#39"},"cpt_dupin_04_04#39":{"id":"cpt_dupin_04_04#39","act":39,"kind":"dialogue","speaker":{"heroId":1068,"name":"Dupin","rawName":"Dupin","isProfessor":false,"lookup":"뒤팽"},"units":[{"uid":"cpt_dupin_04_04#39","rawText":"Only an insoluble mystery could hold my interest. It was an obsession, to the point where I had forgotten myself.","displayText":"Only an insoluble mystery could hold my interest. It was an obsession, to the point where I had forgotten myself.","spans":[{"text":"Only an insoluble mystery could hold my interest. It was an obsession, to the point where I had forgotten myself."}]}],"next":"cpt_dupin_04_04#40"},"cpt_dupin_04_04#40":{"id":"cpt_dupin_04_04#40","act":40,"kind":"dialogue","speaker":{"heroId":1068,"name":"Dupin","rawName":"Dupin","isProfessor":false,"faces":[{"imgId":168,"faceId":1}],"lookup":"뒤팽"},"units":[{"uid":"cpt_dupin_04_04#40","rawText":"In the same way, surely nobody managed to catch you before you met me, right?","displayText":"In the same way, surely nobody managed to catch you before you met me, right?","spans":[{"text":"In the same way, surely nobody managed to catch you before you met me, right?"}]}],"stageRaw":{"heroFace":[{"imgId":168,"faceId":1}]},"next":"cpt_dupin_04_04#41"},"cpt_dupin_04_04#41":{"id":"cpt_dupin_04_04#41","act":41,"kind":"dialogue","speaker":{"name":"LeBlanc","rawName":"<color=red>LeBlanc</color>","isProfessor":false,"lookup":"<color=red>르블랑</color>"},"units":[{"uid":"cpt_dupin_04_04#41","rawText":"<color=red>You're the only one who's come close, aren't you?</color>","displayText":"You're the only one who's come close, aren't you?","spans":[{"text":"You're the only one who's come close, aren't you?","styles":[{"type":"color","value":"red"}]}]}],"stageRaw":{"imgTween":[{"imgId":168,"delay":0,"duration":0.2,"posId":3,"alpha":1,"isDark":true}]},"next":"cpt_dupin_04_04#42"},"cpt_dupin_04_04#42":{"id":"cpt_dupin_04_04#42","act":42,"kind":"dialogue","speaker":{"heroId":1068,"name":"Dupin","rawName":"Dupin","isProfessor":false,"faces":[{"imgId":168,"faceId":0}],"lookup":"뒤팽"},"units":[{"uid":"cpt_dupin_04_04#42","rawText":"So that's why you taunted me.","displayText":"So that's why you taunted me.","spans":[{"text":"So that's why you taunted me."}]}],"stageRaw":{"imgTween":[{"imgId":168,"delay":0,"duration":0.2,"posId":3,"alpha":1,"isDark":false}],"heroFace":[{"imgId":168,"faceId":0}]},"next":"cpt_dupin_04_04#43"},"cpt_dupin_04_04#43":{"id":"cpt_dupin_04_04#43","act":43,"kind":"dialogue","speaker":{"heroId":1068,"name":"Dupin","rawName":"Dupin","isProfessor":false,"lookup":"뒤팽"},"units":[{"uid":"cpt_dupin_04_04#43","rawText":"When you trivialize or even ignore others and keep your eyes fixed on the prize, you end up imprisoning yourself.","displayText":"When you trivialize or even ignore others and keep your eyes fixed on the prize, you end up imprisoning yourself.","spans":[{"text":"When you trivialize or even ignore others and keep your eyes fixed on the prize, you end up imprisoning yourself."}]}],"next":"cpt_dupin_04_04#44"},"cpt_dupin_04_04#44":{"id":"cpt_dupin_04_04#44","act":44,"kind":"dialogue","speaker":{"heroId":1068,"name":"Dupin","rawName":"Dupin","isProfessor":false,"faces":[{"imgId":168,"faceId":1}],"lookup":"뒤팽"},"units":[{"uid":"cpt_dupin_04_04#44","rawText":"But I've risen above one-on-one duels. What about you?","displayText":"But I've risen above one-on-one duels. What about you?","spans":[{"text":"But I've risen above one-on-one duels. What about you?"}]}],"stageRaw":{"heroFace":[{"imgId":168,"faceId":1}]},"next":"cpt_dupin_04_04#45"},"cpt_dupin_04_04#45":{"id":"cpt_dupin_04_04#45","act":45,"kind":"dialogue","speaker":{"name":"LeBlanc","rawName":"<color=red>LeBlanc</color>","isProfessor":false,"lookup":"<color=red>르블랑</color>"},"units":[{"uid":"cpt_dupin_04_04#45","rawText":"<color=red>Humph. You've grown. How interesting.</color>","displayText":"Humph. You've grown. How interesting.","spans":[{"text":"Humph. You've grown. How interesting.","styles":[{"type":"color","value":"red"}]}]}],"stageRaw":{"imgTween":[{"imgId":168,"delay":0,"duration":0.2,"posId":3,"alpha":0,"isDark":false}]},"next":"cpt_dupin_04_04#46"},"cpt_dupin_04_04#46":{"id":"cpt_dupin_04_04#46","act":46,"kind":"dialogue","speaker":{"name":"Dupin","rawName":"Dupin","isProfessor":false,"lookup":"뒤팽"},"units":[{"uid":"cpt_dupin_04_04#46","rawText":"In any case—you were the one with tunnel vision this time, LeBlanc.","displayText":"In any case—you were the one with tunnel vision this time, LeBlanc.","spans":[{"text":"In any case—you were the one with tunnel vision this time, LeBlanc."}]}],"stageRaw":{"imgTween":[{"imgId":1,"delay":0,"duration":0.6,"alpha":0}]},"next":null,"end":true}},"worldRecords":{},"report":{"blocks":46,"unreachedActs":[],"warnings":[]}}