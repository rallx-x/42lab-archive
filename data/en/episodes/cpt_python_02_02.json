0","rawText":"Looks like they know the risks too. The Dolls find it harder to accept elimination than we do.","displayText":"Looks like they know the risks too. The Dolls find it harder to accept elimination than we do.","spans":[{"text":"Looks like they know the risks too. The Dolls find it harder to accept elimination than we do."}]}],"stageRaw":{"imgTween":[{"imgId":62,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":false},{"imgId":58,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":true}]},"next":"cpt_python_02_02#31"},"cpt_python_02_02#31":{"id":"cpt_python_02_02#31","act":31,"kind":"dialogue","speaker":{"heroId":58,"name":"Human Scout","rawName":"Human Scout","isProfessor":false,"dialogPos":1,"lookup":"인간 정찰병"},"units":[{"uid":"cpt_python_02_02#31","rawText":"Losing their qualifications to compete... If they're eliminated, does that mean these tin cans will be discarded?","displayText":"Losing their qualifications to compete... If they're eliminated, does that mean these tin cans will be discarded?","spans":[{"text":"Losing their qualifications to compete... If they're eliminated, does that mean these tin cans will be discarded?"}]}],"stageRaw":{"imgTween":[{"imgId":62,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":true},{"imgId":58,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":false}]},"next":"cpt_python_02_02#32"},"cpt_python_02_02#32":{"id":"cpt_python_02_02#32","act":32,"kind":"dialogue","speaker":{"heroId":62,"name":"Erwin","rawName":"Erwin","isProfessor":false,"dialogPos":3,"lookup":"엘빈"},"units":[{"uid":"cpt_python_02_02#32","rawText":"Oh, yes. The battlefield's a cruel place. Either they eliminate us or we eliminate them.","displayText":"Oh, yes. The battlefield's a cruel place. Either they eliminate us or we eliminate them.","spans":[{"text":"Oh, yes. The battlefield's a cruel place. Either they eliminate us or we eliminate them."}]}],"stageRaw":{"imgTween":[{"imgId":62,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":fa