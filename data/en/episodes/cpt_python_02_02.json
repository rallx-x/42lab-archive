lse}]},"next":"cpt_python_02_02#19"},"cpt_python_02_02#19":{"id":"cpt_python_02_02#19","act":19,"kind":"dialogue","speaker":{"heroId":62,"name":"Erwin","rawName":"Erwin","isProfessor":false,"dialogPos":3,"lookup":"엘빈"},"units":[{"uid":"cpt_python_02_02#19","rawText":"Just like these mock battles... Normal instructors would have just given up or gone hard on us if they found out we were sneaking around organizing mock battles like that.","displayText":"Just like these mock battles... Normal instructors would have just given up or gone hard on us if they found out we were sneaking around organizing mock battles like that.","spans":[{"text":"Just like these mock battles... Normal instructors would have just given up or gone hard on us if they found out we were sneaking around organizing mock battles like that."}]}],"next":"cpt_python_02_02#20"},"cpt_python_02_02#20":{"id":"cpt_python_02_02#20","act":20,"kind":"dialogue","speaker":{"heroId":58,"name":"Human Scout","rawName":"Human Scout","isProfessor":false,"dialogPos":1,"lookup":"인간 정찰병"},"units":[{"uid":"cpt_python_02_02#20","rawText":"Maybe he HAS given up. Mixing humans and Dolls in a unit isn't that easy, you know? Old Ironsides is a pretty good instructor, but I'm thinking even he doesn't know how to handle this.","displayText":"Maybe he HAS given up. Mixing humans and Dolls in a unit isn't that easy, you know? Old Ironsides is a pretty good instructor, but I'm thinking even he doesn't know how to handle this.","spans":[{"text":"Maybe he HAS given up. Mixing humans and Dolls in a unit isn't that easy, you know? Old Ironsides is a pretty good instructor, but I'm thinking even he doesn't know how to handle this."}]}],"stageRaw":{"imgTween":[{"imgId":58,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":false},{"imgId":62,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":true}]},"next":"cpt_python_02_02#21"},"cpt_python_02_02#21":{"id":"cpt_python_02_02#21","act":21,"kind":"dialogue","speaker":{"heroId":58,"name":"Human Scout","rawName":"Human Scout","isProfessor":false,"dialogPos":1,"lookup":"인간 정찰병"},"units":[{"uid":"cpt_python_02_02#21","rawText":"Still, that's not important. After all, I'll show these tin cans why humans rule the battlefield through my actions.","displayText":"Still, that's not important. After all, I'll show these tin cans why humans rule the battlefield through my actions.","spans":[{"text":"Still, that's not important. After all, I'll show these tin cans why humans rule the battlefield through my actions."}]}],"next":"cpt_python_02_02#22"},"cpt_python_02_02#22":{"id":"cpt_python_02_02#22","act":22,"kind":"dialogue","speaker":{"heroId":62,"name":"Erwin","rawName":"Erwin","isProfessor":false,"dialogPos":3,"lookup":"엘빈"},"units":[{"uid":"cpt_python_02_02#22","rawText":"That's enough. Stop running your mouth. If you're really feeling that eager, I can put you in the vanguard squad later.","displayText":"That's enough. Stop running your mouth. If you're really feeling that eager, I can put you in the vanguard squad later.","spans":[{"text":"That's enough. Stop running your mouth. If you're really feeling that eager, I can put you in the vanguard squad later."}]}],"stageRaw":{"imgTween":[{"imgId":58,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":true},{"imgId":62,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":false}]},"next":"cpt_python_02_02#23"},"cpt_python_02_02#23":{"id":"cpt_python_02_02#23","act":23,"kind":"dialogue","speaker":{"heroId":58,"name":"Human Scout","rawName":"Human Scout","isProfessor":false,"dialogPos":1,"lookup":"인간 정찰병"},"units":[{"uid":"cpt_python_02_02#23","rawText":"Please, no. I'm a scout; recon is my specialty.","displayText":"Please, no. I'm a scout; recon is my specialty.","spans":[{"text":"Please, no. I'm a scout; recon is my specialty."}]}],"stageRaw":{"imgTween":[{"imgId":58,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":false},{"imgId":62,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":true}]},"next":"cpt_python_02_02#24"},"cpt_python_02_02#24":{"id":"cpt_python_02_02#24","act":24,"kind":"narration","units":[{"uid":"cpt_python_02_02#24","rawText":"Just then, the distinct cracks of gunfire echoed from the town of Krasno","displayText":"Just then, the distinct cracks of gunfire echoed from the town of Krasno","spans":[{"text":"Just then, the distinct cracks of gunfire echoed from the town of Krasno"}]}],"stageRaw":{"imgTween":[{"imgId":58,"delay":0,"duration":0.2,"posId":2,"alpha":0,"isDark":false},{"imgId":62,"delay":0,"duration":0.2,"posId":4,"alpha":0,"isDark":true}]},"next":"cpt_python_02_02#25"},"cpt_python_02_02#25":{"id":"cpt_python_02_02#25","act":25,"kind":"dialogue","speaker":{"heroId":62,"name":"Erwin","rawName":"Erwin","isProfessor":false,"dialogPos":3,"lookup":"엘빈"},"units":[{"uid":"cpt_python_02_02#25","rawText":"It's begun...","displayText":"It's begun...","spans":[{"text":"It's begun..."}]}],"stageRaw":{"imgTween":[{"imgId":58,"delay":0,"duration":0,"posId":2,"alpha":0,"isDark":true},{"imgId":58,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":true},{"imgId":62,"delay":0,"duration":0,"posId":4,"alpha":0,"isDark":false},{"imgId":62,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":false}]},"next":"cpt_python_02_02#26"},"cpt_python_02_02#26":{"id":"cpt_python_02_02#26","act":26,"kind":"dialogue","speaker":{"heroId":58,"name":"Human Scout","rawName":"Human Scout","isProfessor":false,"dialogPos":1,"lookup":"인간 정찰병"},"units":[{"uid":"cpt_python_02_02#26","rawText":"Are we moving out?","displayText":"Are we moving out?","spans":[{"text":"Are we moving out?"}]}],"stageRaw":{"imgTween":[{"imgId":62,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":true},{"imgId":58,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":false}]},"next":"cpt_python_02_02#27"},"cpt_python_02_02#27":{"id":"cpt_python_02_02#27","act":27,"kind":"dialogue","speaker":{"heroId":62,"name":"Erwin","rawName":"Erwin","isProfessor":false,"dialogPos":3,"lookup":"엘빈"},"u