ind and the two of us spring up."}]}],"next":"cpt_nora_04_05#27"},"cpt_nora_04_05#27":{"id":"cpt_nora_04_05#27","act":27,"kind":"dialogue","speaker":{"heroId":1059,"name":"Nora","rawName":"Nora","isProfessor":false,"dialogPos":1,"lookup":"노라"},"units":[{"uid":"cpt_nora_04_05#27","rawText":"This is all YOUR fault! You were too loud and drew them over!","displayText":"This is all YOUR fault! You were too loud and drew them over!","spans":[{"text":"This is all YOUR fault! You were too loud and drew them over!"}],"shake":true}],"stageRaw":{"imgTween":[{"imgId":159,"delay":0,"duration":0,"posId":2,"alpha":0,"isDark":false},{"imgId":159,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":false},{"imgId":160,"delay":0,"duration":0,"posId":4,"alpha":0,"isDark":true},{"imgId":160,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":true}]},"next":"cpt_nora_04_05#28"},"cpt_nora_04_05#28":{"id":"cpt_nora_04_05#28","act":28,"kind":"dialogue","speaker":{"heroId":1060,"name":"Zangyin","rawName":"Zangyin","isProfessor":false,"faces":[{"imgId":160,"faceId":8}],"dialogPos":3,"lookup":"장음"},"units":[{"uid":"cpt_nora_04_05#28","rawText":"You were the last to speak, weren't you?!","displayText":"You were the last to speak, weren't you?!","spans":[{"text":"You were the last to speak, weren't you?!"}],"shake":true}],"stageRaw":{"imgTween":[{"imgId":160,"delay":0,"duration":0.2,"posId":4,"alpha":1,"shake":true,"isDark":false},{"imgId":159,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":true}],"heroFace":[{"imgId":160,"faceId":8}]},"next":"cpt_nora_04_05#29"},"cpt_nora_04_05#29":{"id":"cpt_nora_04_05#29","act":29,"kind":"dialogue","speaker":{"heroId":1059,"name":"Nora","rawName":"Nora","isProfessor":false,"dialogPos":1,"lookup":"노라"},"units":[{"uid":"cpt_nora_04_05#29","rawText":"...I can't be bothered with you. Just hurry up and run!","displayText":"...I can't be bothered with you. Just hurry up and run!","spans":[{"text":"...I can't be bothered with you. Just hurry up and run!"}