,"speaker":{"heroId":1059,"name":"Nora","rawName":"Nora","isProfessor":false,"dialogPos":1,"lookup":"노라"},"units":[{"uid":"cpt_nora_04_05#17","rawText":"You, you heard that?","displayText":"You, you heard that?","spans":[{"text":"You, you heard that?"}],"shake":true}],"next":"cpt_nora_04_05#18"},"cpt_nora_04_05#18":{"id":"cpt_nora_04_05#18","act":18,"kind":"dialogue","speaker":{"heroId":1060,"name":"Zangyin","rawName":"Zangyin","isProfessor":false,"dialogPos":3,"lookup":"장음"},"units":[{"uid":"cpt_nora_04_05#18","rawText":"You were muttering to yourself so loudly I could have heard you from dozens of meters away.","displayText":"You were muttering to yourself so loudly I could have heard you from dozens of meters away.","spans":[{"text":"You were muttering to yourself so loudly I could have heard you from dozens of meters away."}]}],"stageRaw":{"imgTween":[{"imgId":159,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":true},{"imgId":160,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":false}]},"next":"cpt_nora_04_05#19"},"cpt_nora_04_05#19":{"id":"cpt_nora_04_05#19","act":19,"kind":"dialogue","speaker":{"heroId":1060,"name":"Zangyin","rawName":"Zangyin","isProfessor":false,"faces":[{"imgId":160,"faceId":3}],"dialogPos":3,"lookup":"장음"},"units":[{"uid":"cpt_nora_04_05#19","rawText":"Who knows, those villagers might have caught you because you were so loud.","displayText":"Who knows, those villagers might have caught you because you were so loud.","spans":[{"text":"Who knows, those villagers might have caught you because you were so loud."}]}],"stageRaw":{"heroFace":[{"imgId":160,"faceId":3}]},"next":"cpt_nora_04_05#20"},"cpt_nora_04_05#20":{"id":"cpt_nora_04_05#20","act":20,"kind":"dialogue","speaker":{"heroId":1060,"name":"Zangyin","rawName":"Zangyin","isProfessor":false,"faces":[{"imgId":160,"faceId":4}],"dialogPos":3,"lookup":"장음"},"units":[{"uid":"cpt_nora_04_05#20","rawText":"What's this, was it so scary to not have my guidance around any more?","displayText":"What's this, was it so scary to not have my guidance around any more?","spans":[{"text":"What's this, was it so scary to not have my guidance around any more?"}]}],"stageRaw":{"heroFace":[{"imgId":160,"faceId":4}]},"next":"cpt_nora_04_05#21"},"cpt_nora_04_05#21":{"id":"cpt_nora_04_05#21","act":21,"kind":"dialogue","speaker":{"heroId":1059,"name":"Nora","rawName":"Nora","isProfessor":false,"faces":[{"imgId":159,"faceId":9}],"dialogPos":1,"lookup":"노라"},"units":[{"uid":"cpt_nora_04_05#21","rawText":"I, I was just worried I'd miss the sight of you becoming bear food!","displayText":"I, I was just worried I'd miss the sight of you becoming bear food!","spans":[{"text":"I, I was just worried I'd miss the sight of you becoming bear food!"}]}],"stageRaw":{"imgTween":[{"imgId":159,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":false},{"imgId":160,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":true}],"heroFace":[{"imgId":159,"faceId":9}]},"next":"cpt_nora_04_05#22"},"cpt_nora_04_05#22":{"id":"cpt_nora_04_05#22","act":22,"kind":"dialogue","speaker":{"heroId":1059,"name":"Nora","rawName":"Nora","isProfessor":false,"dialogPos":1,"lookup":"노라"},"units":[{"uid":"cpt_nora_04_05#22","rawText":"And what do you mean by guidance, I was the one who came up with the escape plan just now, right?","displayText":"And what do you mean by guidance, I was the one who came up with the escape plan just now, right?","spans":[{"text":"And what do you mean by guidance, I was the one who came up with the escape plan just now, right?"}]}],"next":"cpt_nora_04_05#23"},"cpt_nora_04_05#23":{"id":"cpt_nora_04_05#23","act":23,"kind":"dialogue","speaker":{"heroId":1060,"name":"Zangyin","rawName":"Zangyin","isProfessor":false,"faces":[{"imgId":160,"faceId":3}],"dialogPos":3,"lookup":"장음"},"units":[{"uid":"cpt_nora_04_05#23","rawText":"Were you? If it wasn't for that uppercut of mine, you'd probably have eaten a bullet.","displayText":"Were you? If it wasn't for that uppercut of mine, yo