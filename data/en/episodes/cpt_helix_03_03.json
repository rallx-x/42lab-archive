less and I can't help anyone...","displayText":"It was like in my past labs, and in the Oasis before, I'm always so careless and I can't help anyone...","spans":[{"text":"It was like in my past labs, and in the Oasis before, I'm always so careless and I can't help anyone..."}]}],"next":"cpt_helix_03_03#11"},"cpt_helix_03_03#11":{"id":"cpt_helix_03_03#11","act":11,"kind":"dialogue","speaker":{"heroId":1061,"name":"Helix","rawName":"Helix","isProfessor":false,"dialogPos":1,"lookup":"헬릭스"},"units":[{"uid":"cpt_helix_03_03#11","rawText":"I also heard that my search for injured people caused a lot of problems for the Exiles...","displayText":"I also heard that my search for injured people caused a lot of problems for the Exiles...","spans":[{"text":"I also heard that my search for injured people caused a lot of problems for the Exiles..."}]}],"next":"cpt_helix_03_03#12"},"cpt_helix_03_03#12":{"id":"cpt_helix_03_03#12","act":12,"kind":"dialogue","speaker":{"heroId":1016,"name":"Banxsy","rawName":"Banxsy","isProfessor":false,"faces":[{"imgId":116,"faceId":5}],"dialogPos":3,"lookup":"뱅크시"},"units":[{"uid":"cpt_helix_03_03#12","rawText":"Did they blame you for it?","displayText":"Did they blame you for it?","spans":[{"text":"Did they blame you for it?"}]}],"stageRaw":{"imgTween":[{"imgId":116,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":false},{"imgId":161,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":true}],"heroFace":[{"imgId":116,"faceId":5}]},"next":"cpt_helix_03_03#13"},"cpt_helix_03_03#13":{"id":"cpt_helix_03_03#13","act":13,"kind":"dialogue","speaker":{"heroId":1061,"name":"Helix","rawName":"Helix","isProfessor":false,"faces":[{"imgId":161,"faceId":3}],"dialogPos":1,"lookup":"헬릭스"},"units":[{"uid":"cpt_helix_03_03#13","rawText":"Well... Not really...","displayText":"Well... Not really...","spans":[{"text":"Well... Not really..."}]}],"stageRaw":{"imgTween":[{"imgId":116,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":true},{"imgId":161,"delay":0,