aces":[{"imgId":161,"faceId":3}],"dialogPos":1,"lookup":"헬릭스"},"units":[{"uid":"cpt_helix_03_03#23","rawText":"I just think... You're not the same... As everyone else, Banxsy.","displayText":"I just think... You're not the same... As everyone else, Banxsy.","spans":[{"text":"I just think... You're not the same... As everyone else, Banxsy."}]}],"stageRaw":{"heroFace":[{"imgId":161,"faceId":3}]},"next":"cpt_helix_03_03#24"},"cpt_helix_03_03#24":{"id":"cpt_helix_03_03#24","act":24,"kind":"dialogue","speaker":{"heroId":1061,"name":"Helix","rawName":"Helix","isProfessor":false,"dialogPos":1,"lookup":"헬릭스"},"units":[{"uid":"cpt_helix_03_03#24","rawText":"You're always doing things I can't do so easily.","displayText":"You're always doing things I can't do so easily.","spans":[{"text":"You're always doing things I can't do so easily."}]}],"next":"cpt_helix_03_03#25"},"cpt_helix_03_03#25":{"id":"cpt_helix_03_03#25","act":25,"kind":"dialogue","speaker":{"heroId":1016,"name":"Banxsy","rawName":"Banxsy","isProfessor":false,"faces":[{"imgId":116,"faceId":0}],"dialogPos":3,"lookup":"뱅크시"},"units":[{"uid":"cpt_helix_03_03#25","rawText":"Of course. That's because there are no shackles on me.","displayText":"Of course. That's because there are no shackles on me.","spans":[{"text":"Of course. That's because there are no shackles on me."}]}],"stageRaw":{"imgTween":[{"imgId":116,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":false},{"imgId":161,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":true}],"heroFace":[{"imgId":116,"faceId":0}]},"next":"cpt_helix_03_03#26"},"cpt_helix_03_03#26":{"id":"cpt_helix_03_03#26","act":26,"kind":"dialogue","speaker":{"heroId":1016,"name":"Banxsy","rawName":"Banxsy","isProfessor":false,"faces":[{"imgId":116,"faceId":1}],"dialogPos":3,"lookup":"뱅크시"},"units":[{"uid":"cpt_helix_03_03#26","rawText":"Would you like to learn? About how to be like me, that is.","displayText":"Would you like to learn? About how to be like me, that is.","spans":[{"