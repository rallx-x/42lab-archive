n after him, face-to-face and eye-to-eye with Eosphorus.","spans":[{"text":"Eosphorus coughs up a cool, light blue liquid and staggers back a few steps. Malkira closes in after him, face-to-face and eye-to-eye with Eosphorus."}]}],"stageRaw":{"images":[{"imgId":37,"imgType":3,"alpha":0,"imgPath":"eosphorus_wings_avg","delete":true},{"imgId":37,"imgType":3,"alpha":0,"imgPath":"eosphorus_w1_avg"}],"imgTween":[{"imgId":6,"delay":0,"duration":0.6,"alpha":0}]},"next":"23carnival_s24_1#54"},"23carnival_s24_1#54":{"id":"23carnival_s24_1#54","act":54,"kind":"dialogue","speaker":{"heroId":507,"name":"Malkira","rawName":"Malkira","isProfessor":false,"faces":[{"imgId":507,"faceId":5}],"lookup":"말키라"},"units":[{"uid":"23carnival_s24_1#54","rawText":"Who made you sacrifice yourselves for the sake of this laughable comedy?!","displayText":"Who made you sacrifice yourselves for the sake of this laughable comedy?!","spans":[{"text":"Who made you sacrifice yourselves for the sake of this laughable comedy?!"}],"shake":true}],"stageRaw":{"imgTween":[{"imgId":507,"delay":0,"duration":0.2,"posId":3,"alpha":1,"shake":true,"isDark":false}],"heroFace":[{"imgId":507,"faceId":5}]},"next":"23carnival_s24_1#55"},"23carnival_s24_1#55":{"id":"23carnival_s24_1#55","act":55,"kind":"dialogue","speaker":{"heroId":37,"name":"Eosphorus","rawName":"Eosphorus","isProfessor":false,"faces":[{"imgId":37,"faceId":3}],"lookup":"에오스포로스"},"units":[{"uid":"23carnival_s24_1#55","rawText":"(Chokes)","displayText":"Chokes","spans":[{"text":"Chokes"}],"shake":true,"monologue":true}],"stageRaw":{"imgTween":[{"imgId":507,"delay":0,"duration":0.2,"posId":3,"alpha":0,"isDark":false},{"imgId":37,"delay":0,"duration":0,"posId":3,"alpha":0,"isDark":false},{"imgId":37,"delay":0,"duration":0.2,"posId":3,"alpha":1,"shake":true,"isDark":false},{"imgId":37,"delay":0.5,"duration":0.2,"posId":3,"alpha":1,"shake":true,"isDark":false}],"heroFace":[{"imgId":37,"faceId":3}]},"next":"23carnival_s24_1#56"},"23carnival_s24_1#56":{"id":