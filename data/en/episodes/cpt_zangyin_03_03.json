yin_03_03#28","act":28,"kind":"dialogue","speaker":{"heroId":125,"name":"Nameless","rawName":"Nameless","isProfessor":false,"faces":[{"imgId":125,"faceId":3}],"dialogPos":3,"lookup":"네임리스"},"units":[{"uid":"cpt_zangyin_03_03#28","rawText":"...Was it Gin?","displayText":"...Was it Gin?","spans":[{"text":"...Was it Gin?"}]}],"stageRaw":{"imgTween":[{"imgId":160,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":true},{"imgId":125,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":false}],"heroFace":[{"imgId":125,"faceId":3}]},"next":"cpt_zangyin_03_03#29"},"cpt_zangyin_03_03#29":{"id":"cpt_zangyin_03_03#29","act":29,"kind":"dialogue","speaker":{"heroId":1060,"name":"Zangyin","rawName":"Zangyin","isProfessor":false,"faces":[{"imgId":160,"faceId":6}],"dialogPos":1,"lookup":"장음"},"units":[{"uid":"cpt_zangyin_03_03#29","rawText":"Gin's not the point here. I checked up on Cyclopes' history. Olivia might be a Monitor-type, but her fighting power is on the same level as Tasha's.","displayText":"Gin's not the point here. I checked up on Cyclopes' history. Olivia might be a Monitor-type, but her fighting power is on the same level as Tasha's.","spans":[{"text":"Gin's not the point here. I checked up on Cyclopes' history. Olivia might be a Monitor-type, but her fighting power is on the same level as Tasha's."}]}],"stageRaw":{"imgTween":[{"imgId":160,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":false},{"imgId":125,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":true}],"heroFace":[{"imgId":160,"faceId":6}]},"next":"cpt_zangyin_03_03#30"},"cpt_zangyin_03_03#30":{"id":"cpt_zangyin_03_03#30","act":30,"kind":"dialogue","speaker":{"heroId":1060,"name":"Zangyin","rawName":"Zangyin","isProfessor":false,"dialogPos":1,"lookup":"장음"},"units":[{"uid":"cpt_zangyin_03_03#30","rawText":"You guys haven't thought this through. You don't have enough of an advantage.","displayText":"You guys haven't thought this through. You don't have enough of an advantage.","spans":[{"text"