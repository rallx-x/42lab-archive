o We've rescued the treasure!]","displayText":"[(oﾟ▽ﾟ)o We've rescued the treasure!]","spans":[{"text":"[(oﾟ▽ﾟ)o We've rescued the treasure!]"}]}],"stageRaw":{"imgTween":[{"imgId":168,"delay":0,"duration":0.2,"posId":3,"alpha":0,"isDark":false},{"imgId":44,"delay":0,"duration":0,"posId":3,"alpha":0,"isDark":false},{"imgId":44,"delay":0,"duration":0.2,"posId":3,"alpha":1,"shake":true,"isDark":false}],"heroFace":[{"imgId":44,"faceId":1}]},"next":"cpt_dupin_04_03#27"},"cpt_dupin_04_03#27":{"id":"cpt_dupin_04_03#27","act":27,"kind":"narration","units":[{"uid":"cpt_dupin_04_03#27","rawText":"As the security robots announce their protection of their \"treasure\", Dupin, who has been high-strung all this while, suddenly realizes something.","displayText":"As the security robots announce their protection of their \"treasure\", Dupin, who has been high-strung all this while, suddenly realizes something.","spans":[{"text":"As the security robots announce their protection of their \"treasure\", Dupin, who has been high-strung all this while, suddenly realizes something."}]}],"stageRaw":{"imgTween":[{"imgId":44,"delay":0,"duration":0.2,"posId":3,"alpha":0,"isDark":false}]},"next":"cpt_dupin_04_03#28"},"cpt_dupin_04_03#28":{"id":"cpt_dupin_04_03#28","act":28,"kind":"dialogue","speaker":{"heroId":1068,"name":"Dupin","rawName":"Dupin","isProfessor":false,"faces":[{"imgId":168,"faceId":3}],"lookup":"뒤팽"},"units":[{"uid":"cpt_dupin_04_03#28","rawText":"(...I see!)","displayText":"...I see!","spans":[{"text":"...I see!"}],"shake":true,"monologue":true}],"stageRaw":{"imgTween":[{"imgId":168,"delay":0,"duration":0,"posId":3,"alpha":0,"isDark":false},{"imgId":168,"delay":0,"duration":0.2,"posId":3,"alpha":1,"isDark":false}],"heroFace":[{"imgId":168,"faceId":3}]},"next":"cpt_dupin_04_03#29"},"cpt_dupin_04_03#29":{"id":"cpt_dupin_04_03#29","act":29,"kind":"dialogue","speaker":{"heroId":1068,"name":"Dupin","rawName":"Dupin","isProfessor":false,"faces":[{"imgId":168,"faceId":1}],"lookup":"뒤팽"},"units":[{"uid":"cpt_dupin_04_03#29","rawText":"The answer lies... in the sword itself!","displayText":"The answer lies... in the sword itself!","spans":[{"text":"The answer lies... in the sword itself!"}],"shake":true}],"stageRaw":{"heroFace":[{"imgId":168,"faceId":1}]},"next":"cpt_dupin_04_03#30"},"cpt_dupin_04_03#30":{"id":"cpt_dupin_04_03#30","act":30,"kind":"dialogue","speaker":{"heroId":1068,"name":"Dupin","rawName":"Dupin","isProfessor":false,"faces":[{"imgId":168,"faceId":5}],"lookup":"뒤팽"},"units":[{"uid":"cpt_dupin_04_03#30","rawText":"Aki! Lend me a hand!","displayText":"Aki! Lend me a hand!","spans":[{"text":"Aki! Lend me a hand!"}],"shake":true}],"stageRaw":{"heroFace":[{"imgId":168,"faceId":5}]},"next":"cpt_dupin_04_03#31"},"cpt_dupin_04_03#31":{"id":"cpt_dupin_04_03#31","act":31,"kind":"dialogue","speaker":{"heroId":1015,"name":"Aki","rawName":"Aki","isProfessor":false,"lookup":"아키"},"units":[{"uid":"cpt_dupin_04_03#31","rawText":"Give me a bit, I'm a little busy at the moment!","displayText":"Give me a bit, I'm a little busy at the moment!","spans":[{"text":"Give me a bit, I'm a little busy at the moment!"}]}],"stageRaw":{"imgTween":[{"imgId":168,"delay":0,"duration":0.2,"posId":3,"alpha":0,"isDark":false},{"imgId":115,"delay":0,"duration":0.2,"posId":3,"alpha":1,"shake":true,"isDark":false}]},"next":"cpt_dupin_04_03#32"},"cpt_dupin_04_03#32":{"id":"cpt_dupin_04_03#32","act":32,"kind":"dialogue","speaker":{"heroId":1068,"name":"Dupin","rawName":"Dupin","isProfessor":false,"lookup":"뒤팽"},"units":[{"uid":"cpt_dupin_04_03#32","rawText":"Then lend me your sword!","displayText":"Then lend me your sword!","spans":[{"text":"Then lend me your sword!"}],"shake":true}],"stageRaw":{"imgTween":[{"imgId":115,"delay":0,"duration":0.2,"posId":3,"alpha":0,"isDark":false},{"imgId":168,"delay":0,"duration":0.2,"posId":3,"alpha":1,"isDark":false}]},"next":"cpt_dupin_04_03#33"},"cpt_dupin_04_03#33":{"id":"cpt_dupin_04_03#33","act":33,"kind":"direction","stageRaw":{"