":0,"duration":0.2,"posId":3,"alpha":0,"isDark":false}]},"next":"cpt_dupin_04_03#20"},"cpt_dupin_04_03#20":{"id":"cpt_dupin_04_03#20","act":20,"kind":"dialogue","speaker":{"heroId":43,"name":"Mini-Robot A","rawName":"Mini-Robot A","isProfessor":false,"lookup":"깡통로봇 A"},"units":[{"uid":"cpt_dupin_04_03#20","rawText":"[(〃＞皿＜) Move the treasure! Move the treasure!]","displayText":"[(〃＞皿＜) Move the treasure! Move the treasure!]","spans":[{"text":"[(〃＞皿＜) Move the treasure! Move the treasure!]"}]}],"stageRaw":{"imgTween":[{"imgId":43,"delay":0,"duration":0,"posId":3,"alpha":0,"isDark":false},{"imgId":43,"delay":0,"duration":0.2,"posId":3,"alpha":1,"shake":true,"isDark":false}]},"next":"cpt_dupin_04_03#21"},"cpt_dupin_04_03#21":{"id":"cpt_dupin_04_03#21","act":21,"kind":"dialogue","speaker":{"name":"Dupin","rawName":"Dupin","isProfessor":false,"lookup":"뒤팽"},"units":[{"uid":"cpt_dupin_04_03#21","rawText":"(Logically speaking, I should be at ease since the security systems and the robots are working fine.)","displayText":"Logically speaking, I should be at ease since the security systems and the robots are working fine.","spans":[{"text":"Logically speaking, I should be at ease since the security systems and the robots are working fine."}],"monologue":true}],"stageRaw":{"imgTween":[{"imgId":43,"delay":0,"duration":0.2,"posId":3,"alpha":0,"isDark":false}]},"next":"cpt_dupin_04_03#22"},"cpt_dupin_04_03#22":{"id":"cpt_dupin_04_03#22","act":22,"kind":"dialogue","speaker":{"name":"LeBlanc","rawName":"<color=red>LeBlanc</color>","isProfessor":false,"lookup":"<color=red>르블랑</color>"},"units":[{"uid":"cpt_dupin_04_03#22","rawText":"<color=red>Not planning to chase me? You've changed, Dupin.</color>","displayText":"Not planning to chase me? You've changed, Dupin.","spans":[{"text":"Not planning to chase me? You've changed, Dupin.","styles":[{"type":"color","value":"red"}]}]}],"next":"cpt_dupin_04_03#23"},"cpt_dupin_04_03#23":{"id":"cpt_dupin_04_03#23","act":23,"kind":"dialogue","sp