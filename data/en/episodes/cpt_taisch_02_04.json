4}],"dialogPos":3,"lookup":"임호텝"},"units":[{"uid":"cpt_taisch_02_04#18","rawText":"...Ah.","displayText":"...Ah.","spans":[{"text":"...Ah."}]}],"stageRaw":{"imgTween":[{"imgId":131,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":false},{"imgId":112,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":true}],"heroFace":[{"imgId":131,"faceId":4}]},"next":"cpt_taisch_02_04#19"},"cpt_taisch_02_04#19":{"id":"cpt_taisch_02_04#19","act":19,"kind":"dialogue","speaker":{"heroId":1012,"name":"Max","rawName":"Max","isProfessor":false,"faces":[{"imgId":112,"faceId":5}],"dialogPos":1,"lookup":"맥스"},"units":[{"uid":"cpt_taisch_02_04#19","rawText":"Her attitude reminds me of myself after I got shocked in the lab once. Her neural cloud's a mess and she just can't sort it out.","displayText":"Her attitude reminds me of myself after I got shocked in the lab once. Her neural cloud's a mess and she just can't sort it out.","spans":[{"text":"Her attitude reminds me of myself after I got shocked in the lab once. Her neural cloud's a mess and she just can't sort it out."}]}],"stageRaw":{"imgTween":[{"imgId":131,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":true},{"imgId":112,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":false}],"heroFace":[{"imgId":112,"faceId":5}]},"next":"cpt_taisch_02_04#20"},"cpt_taisch_02_04#20":{"id":"cpt_taisch_02_04#20","act":20,"kind":"dialogue","speaker":{"heroId":1031,"name":"Imhotep","rawName":"Imhotep","isProfessor":false,"faces":[{"imgId":131,"faceId":3}],"dialogPos":3,"lookup":"임호텝"},"units":[{"uid":"cpt_taisch_02_04#20","rawText":"That's why we should try not to excite her too much...","displayText":"That's why we should try not to excite her too much...","spans":[{"text":"That's why we should try not to excite her too much..."}]}],"stageRaw":{"imgTween":[{"imgId":131,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":false},{"imgId":112,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":true}],"heroFace":[{"imgId":131,"faceId"