Professor":false,"faces":[{"imgId":139,"faceId":0}],"dialogPos":1,"lookup":"센타우레이시"},"units":[{"uid":"cpt_clotho_02_01#5","rawText":"Sir, the work here is very similar to my previous job. Cleaning the barracks on time, washing clothes, preparing meals... I've been trained to do that before.","displayText":"Sir, the work here is very similar to my previous job. Cleaning the barracks on time, washing clothes, preparing meals... I've been trained to do that before.","spans":[{"text":"Sir, the work here is very similar to my previous job. Cleaning the barracks on time, washing clothes, preparing meals... I've been trained to do that before."}]}],"stageRaw":{"imgTween":[{"imgId":139,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":false},{"imgId":146,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":true}],"heroFace":[{"imgId":139,"faceId":0}]},"next":"cpt_clotho_02_01#6"},"cpt_clotho_02_01#6":{"id":"cpt_clotho_02_01#6","act":6,"kind":"dialogue","speaker":{"heroId":146,"name":"Logistics Officer","rawName":"Logistics Officer","isProfessor":false,"dialogPos":3,"lookup":"군수처 장관"},"units":[{"uid":"cpt_clotho_02_01#6","rawText":"But that's not the same. Even if this IS a rear-echelon base, we might be sent to the frontlines at any time, or we might get ambushed and killed on the way back like that squad from last time...","displayText":"But that's not the same. Even if this IS a rear-echelon base, we might be sent to the frontlines at any time, or we might get ambushed and killed on the way back like that squad from last time...","spans":[{"text":"But that's not the same. Even if this IS a rear-echelon base, we might be sent to the frontlines at any time, or we might get ambushed and killed on the way back like that squad from last time..."}]}],"stageRaw":{"imgTween":[{"imgId":139,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":true},{"imgId":146,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":false}]},"next":"cpt_clotho_02_01#7"},"cpt_clotho_02_01#7":{"i