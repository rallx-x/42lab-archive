":0.2,"alpha":1,"isDark":false}],"bgColor":2},"next":"24carnival_croque#2"},"24carnival_croque#2":{"id":"24carnival_croque#2","act":2,"kind":"dialogue","speaker":{"heroId":1005,"name":"克罗琦","rawName":"克罗琦","isProfessor":false,"lookup":"크로크"},"units":[{"uid":"24carnival_croque#2","rawText":"明明是我主导的系统结果却出现了这样的差错……对不起教授！","displayText":"明明是我主导的系统结果却出现了这样的差错……对不起教授！","spans":[{"text":"明明是我主导的系统结果却出现了这样的差错……对不起教授！"}]}],"next":"24carnival_croque#3"},"24carnival_croque#3":{"id":"24carnival_croque#3","act":3,"kind":"dialogue","speaker":{"name":null,"rawName":"bravo","isProfessor":true,"professorVariant":"bravo","lookup":"bravo"},"units":[{"uid":"24carnival_croque#3","rawText":"不需要自责克罗琦，这并非你的过错，是我的贸然决定带来的后果。况且如果没有克罗琦改良沙盒屏障和制作战斗模块的话，我们的冒险或许早在那天已经结束了。","displayText":"不需要自责克罗琦，这并非你的过错，是我的贸然决定带来的后果。况且如果没有克罗琦改良沙盒屏障和制作战斗模块的话，我们的冒险或许早在那天已经结束了。","spans":[{"text":"不需要自责克罗琦，这并非你的过错，是我的贸然决定带来的后果。况且如果没有克罗琦改良沙盒屏障和制作战斗模块的话，我们的冒险或许早在那天已经结束了。"}]}],"stageRaw":{"imgTween":[{"imgId":105,"delay":0,"duration":0.2,"alpha":1,"isDark":true}]},"next":"24carnival_croque#4"},"24carnival_croque#4":{"id":"24carnival_croque#4","act":4,"kind":"dialogue","speaker":{"heroId":1005,"name":"克罗琦","rawName":"克罗琦","isProfessor":false,"lookup":"크로크"},"units":[{"uid":"24carnival_croque#4","rawText":"但要是我当时能将系统制造得更全面一些的话……唉，算了，现在后悔也没用了。","displayText":"但要是我当时能将系统制造得更全面一些的话……唉，算了，现在后悔也没用了。","spans":[{"text":"但要是我当时能将系统制造得更全面一些的话……唉，算了，现在后悔也没用了。"}]}],"stageRaw":{"imgTween":[{"imgId":105,"delay":0,"duration":0.2,"alpha":1,"isDark":false}]},"next":"24carnival_croque#5"},"24carnival_croque#5":{"id":"24carnival_croque#5","act":5,"kind":"dialogue","speaker":{"heroId":1005,"name":"克罗琦","rawName":"克罗琦","isProfessor":false,"lookup":"크로크"},"units":[{"uid":"24carnival_croque#5","rawText":"不过这么说来，确实从和教授你见面之后，我就经常收到你那些离谱的需求呢。一下子扩大心智检索的范围，一下子又是改良沙盒屏障，同时还要准备预备系统……","displayText":"不过这么说来，确实从和教授你见面之后，我就经常收到你那些离谱的需求呢。一下子扩大心智检索的范围，一下子又是改良沙盒屏障，同时还要准备预备系统……","spans":[{"text":"不过这么说来，确实从和教授你见面之后，我就经常收到你那些离谱的需求呢。一下子扩大心智检索的范围，一下子又是改良沙盒屏障，同时还要准备预备系统……"}]}],"next":"24carnival_croque#6"},"24carnival_croque#6":{"id":"24carnival_croque#6","act":6,"kind":"dialogue","speaker":{"heroId":1005,"name":"克罗琦","rawName":"克罗琦","isProfessor":false,"lookup":"크로크"},"units":[{"uid":"24carnival_croque#6","rawText":"真的是每一个需求都好难啊……拯救大家……拯救世界真的好难啊……","displayText":"真的是每一个需求都好难啊……拯救大家……拯救世界真的好难啊……","spans":[{"text":"真的是每一个需求都好难啊……拯救大家……拯救世界真的好难啊……"}]}],"next":"24carnival_croque#7"},"24carnival_croque#7":{"id":"24carnival_croque#7","act":7,"kind":"narration","units":[{"uid":"24carnival_croque#7","rawText":"克罗琦随手摆弄着手中的机兵模型，深深地叹了一口气。","displayText":"克罗琦随手摆弄着手中的机兵模型，深深地叹了一口气。","spans":[{"text":"克罗琦随手摆弄着手中的机兵模型，深深地叹了一口气。"}]}],"stageRaw":{"imgTween":[{"imgId":105,"delay":0,"duration":0.2,"alpha":1,"isDark":true}]},"next":"24carnival_croque#8"},"24carnival_croque#8":{"id":"24carnival_croque#8","act":8,"kind":"dialogue","speaker":{"heroId":1005,"name":"克罗琦","rawName":"克罗琦","isProfessor":false,"lookup":"크로크"},"units":[{"uid":"24carnival_croque#8","rawText":"从我被唤醒开始，我就一直在看各种机器人相关的动漫和影视。我被故事中爱，希望，热血与勇气所吸引，一直期望自己也可以成为拥有钢之魂的人形。","displayText":"从我被唤醒开始，我就一直在看各种机器人相关的动漫和影视。我被故事中爱，希望，热血与勇气所吸引，一直期望自己也可以成为拥有钢之魂的人形。","spans":[{"text":"从我被唤醒开始，我就一直在看各种机器人相关的动漫和影视。我被故事中爱，希望，热血与勇气所吸引，一直期望自己也可以成为拥有钢之魂的人形。"}]}],"stageRaw":{"imgTween":[{"imgId":105,"delay":0,"duration":0.2,"alpha":1,"isDark":false}]},"next":"24carnival_croque#9"},"24carnival_croque#9":{"id":"24carnival_croque#9","act":9,"kind":"dialogue","speaker":{"heroId":1005,"name":"克罗琦","rawName":"克罗琦","isProfessor":false,"lookup":"크로크"},"units":[{"uid":"24carnival_croque#9","rawText":"但是，当我被困在云端的时候，当我开始流浪……当我想要守护大家的时候，我才发现我还差得远啊……老实说有点受到打击呢。","displayText":"但是，当我被困在云端的时候，当我开始流浪……当我想要守护大家的时候，我才发现我还差得远啊……老实说有点受到打击呢。","spans":[{"text":"但是，当我被困在云端的时候，当我开始流浪……当我想要守护大家的时候，我才发现我还差得远啊……老实说有点受到打击呢。"}]}],"next":"24carnival_croque#10"},"24carnival_croque#10":{"id":"24carnival_croque#10","act":10,"kind":"dialogue","speaker":{"heroId":1005,"name":"克罗琦","rawName":"克罗琦","isProfessor":false,"lookup":"크로크"},"units":[{"uid":"24carnival_croque#10","rawText":"我所憧憬的钢之魂……是多么的沉重又是多么的艰难。拯救大家，保护大家……真的好难啊……","displayText":"我所憧憬的钢之魂……是多么的沉重又是多么的艰难。拯救大家，保护大家……真的好难啊……","spans":[{"text":"我所憧憬的钢之魂……是多么的沉重又是多么的艰难。拯救大家，保护大家……真的好难啊……"}]}],"stageRaw":{"imgTween":[{"imgId":105,"delay":0,"duration":0.2,"alpha":1,"shake":true,"isDark":false}]},"next":"24carnival_croque#11"},"24carnival_croque#11":{"id":"24carnival_croque#11","act":11,"kind":"dialogue","speaker":{"name":null,"rawName":"bravo","isProfessor":true,"professorVariant":"bravo","lookup":"bravo"},"units":[{"uid":"24carnival_croque#11","rawText":"确实很艰难啊。但是就是因为它很难，所以克罗琦才会一直憧憬不是吗？","displayText":"确实很艰难啊。但是就是因为它很难，所以克罗琦才会一直憧憬不是吗？","spans":[{"text":"确实很艰难啊。但是就是因为它很难，所以克罗琦才会一直憧憬不是吗？"}]}],"stageRaw":{"imgTween":[{"imgId":105,"delay":0,"duration":0.2,"alpha":1,"isDark":true}]},"next":"24carnival_croque#12"},"24carnival_croque#12":{"id":"24carnival_croque#12","act":12,"kind":"dialogue","speaker":{"heroId":1005,"name":"克罗琦","rawName":"克罗琦","isProfessor":false,"lookup":"크로크"},"units":[{"uid":"24carnival_croque#12","rawText":"……真是的，明明我想帅气地自己说出来的。","displayText":"……真是的，明明我想帅气地自己说出来的。","spans":[{"text":"……真是的，明明我想帅气地自己说出来的。"}]}],"stageRaw":{"imgTween":[{"imgId":105,"delay":0,"duration":0.2,"alpha":1,"isDark":false}]},"next":"24carnival_croque#13"},"24carnival_croque#13":{"id":"24carnival_croque#13","act":13,"kind":"dialogue","speaker":{"heroId":1005,"name":"克罗琦","rawName":"克罗琦","isProfessor":false,"lookup":"크로크"},"units":[{"uid":"24carnival_croque#13","rawText":"确实就如同教授说的一样。每一次我看到教授奋不顾身的身影，看着教授带着我们一点一滴建设起来的绿洲，看着那些被我们帮助过的扇区……","displayText":"确实就如同教授说的一样。每一次我看到教授奋不顾身的身影，看着教授带着我们一点一滴建设起来的绿洲，看着那些被我们帮助过的扇区……","spans":[{"text":"确实就如同教授说的一样。每一次我看到教授奋不顾身的身影，看着教授带着我们一点一滴建设起来的绿洲，看着那些被我们帮助过的扇区……"}]}],"next":"24carnival_croque#14"},"24carnival_croque#14":{"id":"24carnival_croque#14","act":14,"kind":"dialogue","speaker":{"heroId":1005,"name":"克罗琦","rawName":"克罗琦","isProfessor":false,"lookup":"크로크"},"units":[{"uid":"24carnival_croque#14","rawText":"啊~我果然还是想要像教授一样成为保护大家的那个人。","displayText":"啊~我果然还是想要像教授一样成为保护大家的那个人。","spans":[{"text":"啊~我果然还是想要像教授一样成为保护大家的那个人。"}]}],"next":"24carnival_croque#15"},"24carnival_croque#15":{"id":"24carnival_croque#15","act":15,"kind":"dialogue","speaker":{"heroId":1005,"name":"克罗琦","rawName":"克罗琦","isProfessor":false,"lookup":"크로크"},"units":[{"uid":"24carnival_croque#15","rawText":"坚定不移的信念，永不退缩的勇气，和守护他人的温柔……那些作品里传达的感情正是我所憧憬的存在。教授，接下来的战斗我也会依旧秉承着这份精神和你一同战斗下去的。","displayText":"坚定不移的信念，永不退缩的勇气，和守护他人的温柔……那些作品里传达的感情正是我所憧憬的存在。教授，接下来的战斗我也会依旧秉承着这份精神和你一同战斗下去的。","spans":[{"text":"坚定不移的信念，永不退缩的勇气，和守护他人的温柔……那些作品里传达的感情正是我所憧憬的存在。教授，接下来的战斗我也会依旧秉承着这份精神和你一同战斗下去的。"}]}],"next":"24carnival_croque#16"},"24carnival_croque#16":{"id":"24carnival_croque#16","act":16,"kind":"dialogue","speaker":{"heroId":1005,"name":"克罗琦","rawName":"克罗琦","isProfessor":false,"lookup":"크로크"},"units":[{"uid":"24carnival_croque#16","rawText":"啊对了！不如我们来重温一下机器人动画吧！说不定可以帮助教授恢复当初和我一同的记忆……我看看……从《武装机兵》开始也就500部而已嘛！","displayText":"啊对了！不如我们来重温一下机器人动画吧！说不定可以帮助教授恢复当初和我一同的记忆……我看看……从《武装机兵》开始也就500部而已嘛！","spans":[{"text":"啊对了！不如我们来重温一下机器人动画吧！说不定可以帮助教授恢复当初和我一同的记忆……我看看……从《武装机兵》开始也就500部而已嘛！"}],"shake":true}],"stageRaw":{"imgTween":[{"imgId":105,"delay":0,"duration":0.2,"alpha":1,"shake":true,"isDark":false}]},"next":null,"end":true}},"worldRecords":{},"report":{"blocks":16,"unreachedActs":[],"warnings":[]}}