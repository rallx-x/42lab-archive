ct":5,"kind":"narration","units":[{"uid":"24carnival_python#5","rawText":"派森递给了我一瓶啤酒，我们两个人倚靠在吧台边上。","displayText":"派森递给了我一瓶啤酒，我们两个人倚靠在吧台边上。","spans":[{"text":"派森递给了我一瓶啤酒，我们两个人倚靠在吧台边上。"}]}],"stageRaw":{"imgTween":[{"imgId":154,"delay":0,"duration":0.2,"alpha":0,"isDark":false}]},"next":"24carnival_python#6"},"24carnival_python#6":{"id":"24carnival_python#6","act":6,"kind":"dialogue","speaker":{"heroId":1054,"name":"派森","rawName":"派森","isProfessor":false,"lookup":"파이슨"},"units":[{"uid":"24carnival_python#6","rawText":"今天……绿洲所有战斗小队的训练都已经结束了，我已经没有可以教导他们的东西了。接下来的战斗就看他们对技能的应用，以及能否有优秀的指挥官来领导他们了。","displayText":"今天……绿洲所有战斗小队的训练都已经结束了，我已经没有可以教导他们的东西了。接下来的战斗就看他们对技能的应用，以及能否有优秀的指挥官来领导他们了。","spans":[{"text":"今天……绿洲所有战斗小队的训练都已经结束了，我已经没有可以教导他们的东西了。接下来的战斗就看他们对技能的应用，以及能否有优秀的指挥官来领导他们了。"}]}],"stageRaw":{"imgTween":[{"imgId":154,"delay":0,"duration":0.2,"alpha":1,"isDark":false}]},"next":"24carnival_python#7"},"24carnival_python#7":{"id":"24carnival_python#7","act":7,"kind":"dialogue","speaker":{"heroId":1054,"name":"派森","rawName":"派森","isProfessor":false,"lookup":"파이슨"},"units":[{"uid":"24carnival_python#7","rawText":"不过我想这一点是完全不用担心的，他们已经做好的战斗的准备。而我们……有着最好的领导者。","displayText":"不过我想这一点是完全不用担心的，他们已经做好的战斗的准备。而我们……有着最好的领导者。","spans":[{"text":"不过我想这一点是完全不用担心的，他们已经做好的战斗的准备。而我们……有着最好的领导者。"}]}],"next":"24carnival_python#8"},"24carnival_python#8":{"id":"24carnival_python#8","act":8,"kind":"dialogue","speaker":{"heroId":1054,"name":"派森","rawName":"派森","isProfessor":false,"lookup":"파이슨"},"units":[{"uid":"24carnival_python#8","rawText":"教授，敬流亡者。","displayText":"教授，敬流亡者。","spans":[{"text":"教授，敬流亡者。"}]}],"next":"24carnival_python#9"},"24carnival_python#9":{"id":"24carnival_python#9","act":9,"kind":"dialogue","speaker":{"name":null,"rawName":"bravo","isProfessor":true,"professorVariant":"bravo","lookup":"bravo"},"units":[{"uid":"24carnival_python#9","rawText":"呵呵……你说的没错。敬流亡者。","displayText":"呵呵……你说的没错。敬流亡者。","spans":[{"text":"呵呵……你说的没错。敬流亡者。"}]}],"stageRaw":{"imgTween":[{"imgId":154,"delay":0,"durat