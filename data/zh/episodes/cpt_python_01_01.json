,"isDark":true}]},"next":"cpt_python_01_01#16"},"cpt_python_01_01#16":{"id":"cpt_python_01_01#16","act":16,"kind":"dialogue","speaker":{"name":"通讯频段1","rawName":"<color=orange>通讯频段1</color>","isProfessor":false,"lookup":"<color=orange>통신채널 1</color>"},"units":[{"uid":"cpt_python_01_01#16","rawText":"但这并不妨碍我们尝试新的东西。当然，最重要的还是因为南恒那边的几个老顽固眼红我们的成绩，联合军事竞赛委员会给我们下了封战书。","displayText":"但这并不妨碍我们尝试新的东西。当然，最重要的还是因为南恒那边的几个老顽固眼红我们的成绩，联合军事竞赛委员会给我们下了封战书。","spans":[{"text":"但这并不妨碍我们尝试新的东西。当然，最重要的还是因为南恒那边的几个老顽固眼红我们的成绩，联合军事竞赛委员会给我们下了封战书。"}]}],"next":"cpt_python_01_01#17"},"cpt_python_01_01#17":{"id":"cpt_python_01_01#17","act":17,"kind":"dialogue","speaker":{"name":"通讯频段1","rawName":"<color=orange>通讯频段1</color>","isProfessor":false,"lookup":"<color=orange>통신채널 1</color>"},"units":[{"uid":"cpt_python_01_01#17","rawText":"那群***的认为军用人形是战争史上的错误，而人类和人形的配合更被他们视为是军事领域的大倒车。","displayText":"那群***的认为军用人形是战争史上的错误，而人类和人形的配合更被他们视为是军事领域的大倒车。","spans":[{"text":"那群***的认为军用人形是战争史上的错误，而人类和人形的配合更被他们视为是军事领域的大倒车。"}]}],"next":"cpt_python_01_01#18"},"cpt_python_01_01#18":{"id":"cpt_python_01_01#18","act":18,"kind":"dialogue","speaker":{"heroId":1054,"name":"派森","rawName":"派森","isProfessor":false,"faces":[{"imgId":154,"faceId":2}],"dialogPos":2,"lookup":"파이슨"},"units":[{"uid":"cpt_python_01_01#18","rawText":"我认为我们可以先用代表团的模式迎战。","displayText":"我认为我们可以先用代表团的模式迎战。","spans":[{"text":"我认为我们可以先用代表团的模式迎战。"}]}],"stageRaw":{"imgTween":[{"imgId":154,"delay":0,"duration":0.2,"posId":3,"alpha":1,"isDark":false}],"heroFace":[{"imgId":154,"faceId":2}]},"next":"cpt_python_01_01#19"},"cpt_python_01_01#19":{"id":"cpt_python_01_01#19","act":19,"kind":"dialogue","speaker":{"name":"通讯频段1","rawName":"<color=orange>通讯频段1</color>","isProfessor":false,"lookup":"<color=orange>통신채널 1</color>"},"units":[{"uid":"cpt_python_01_01#19","rawText":"我也是这么想的，但那群混账给我们挖了个大坑。他们声称如果人类和人形只是以双团并联的形式合作作战，那和人类军队配备其他的武器并没有区别，只是这群武器长了脑子。","displayText":"我也是这么想的，但那群混账给我们挖了个大坑。他们声称如果人类和人形只是以双团并联的形式合作作战，那和人类军队配备其他的武器并没有区别，只是这群武器长了脑子。","spans":[{"text":"我也是这么想的，但那群混账给我们挖了个大坑。他们声称如果人类和人形只是以双团并联的形式合作作战，那和人类军队配备其他的武器并没有区别，只是这群武器长了脑子。"}]}],"stageRaw":{"imgTween":[{"imgId":154,"delay":0,"duration":0.2,"posId":3,"alpha":1,"isDark":true}]},"next":"cpt_python_01_01#20"},"cpt_python_01_01#20":{"id":"cpt_python_01_01#20","act":20,"kind":"dialogue","speaker":{"name":"通讯频段1","rawName":"<color=orange>通讯频段1</color>","isProfessor":false,"lookup":"<color=orange>통신채널 1</color>"},"units":[{"uid":"cpt_python_01_01#20","rawText":"南恒军区表示如果只是配备武器，他们用不长脑子的也能打赢我们，只要造价和人形团队相当……","displayText":"南恒军区表示如果只是配备武器，他们用不长脑子的也能打赢我们，只要造价和人形团队相当……","spans":[{"text":"南恒军区表示如果只是配备武器，他们用不长脑子的也能打赢我们，只要造价和人形团队相当……"}]}],"next":"cpt_python_01_01#21"},"cpt_python_01_01#21":{"id":"cpt_python_01_01#21","act":21,"kind":"dialogue","speaker":{"name":"通讯频段1","rawName":"<color=orange>通讯频段1</color>","isProfessor":false,"lookup":"<color=orange>통신채널 1</color>"},"units":[{"uid":"cpt_python_01_01#21","rawText":"什么**说法！最糟糕的是军竞委员会认可了他们，要求我们进一步演示人形在军事上的可能性。","displayText":"什么**说法！最糟糕的是军竞委员会认可了他们，要求我们进一步演示人形在军事上的可能性。","spans":[{"text":"什么**说法！最糟糕的是军竞委员会认可了他们，要求我们进一步演示人形在军事上的可能性。"}]}],"next":"cpt_python_01_01#22"},"cpt_python_01_01#22":{"id":"cpt_python_01_01#22","act":22,"kind":"dialogue","speaker":{"name":"通讯频段1","rawName":"<color=orange>通讯频段1</color>","isProfessor":false,"lookup":"<color=orange>통신채널 1</color>"},"units":[{"uid":"cpt_python_01_01#22","rawText":"你明白我的意思吗？派森，这一仗我们只能打。","displayText":"你明白我的意思吗？派森，这一仗我们只能打。","spans":[{"text":"你明白我的意思吗？派森，这一仗我们只能打。"}],"shake":true}],"next":"cpt_python_01_01#23"},"cpt_python_01_01#23":{"id":"cpt_python_01_01#23","act":23,"kind":"dialogue","speaker":{"heroId":1054,"name":"派森","rawName":"派森","isProfessor":false,"faces":[{"imgId":154,"faceId":0}],"dialogPos":2,"lookup":"파이슨"},"units":[{"uid":"cpt_python_01_01#23","rawText":"明白！长官。","displayText":"明白！长官。","spans":[{"text":"明白！长官。"}],"shake":true}],"stageRaw":{"imgTween":[{"imgId":154,"delay":0,"duration":0.2,"posId":3,"alpha":1,"isDark":false}],"heroFace":[{"imgId":154,"faceId":0}]},"n