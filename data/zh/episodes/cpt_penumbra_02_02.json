毕竟人形就是如此。被人类需要便是我们最大存在意义，除此之外，我们一无所有。","spans":[{"text":"毕竟人形就是如此。被人类需要便是我们最大存在意义，除此之外，我们一无所有。"}]}],"next":"cpt_penumbra_02_02#33"},"cpt_penumbra_02_02#33":{"id":"cpt_penumbra_02_02#33","act":33,"kind":"narration","units":[{"uid":"cpt_penumbra_02_02#33","rawText":"黯月低垂着眼帘，逐渐回想起一段不愉快的记忆。","displayText":"黯月低垂着眼帘，逐渐回想起一段不愉快的记忆。","spans":[{"text":"黯月低垂着眼帘，逐渐回想起一段不愉快的记忆。"}]}],"stageRaw":{"imgTween":[{"imgId":183,"delay":0,"duration":0.2,"alpha":0,"isDark":false},{"imgId":165,"delay":0,"duration":0.2,"alpha":0,"isDark":true}]},"next":"cpt_penumbra_02_02#34"},"cpt_penumbra_02_02#34":{"id":"cpt_penumbra_02_02#34","act":34,"kind":"dialogue","speaker":{"heroId":1083,"name":"黯月","rawName":"黯月","isProfessor":false,"faces":[{"imgId":183,"faceId":10}],"lookup":"페넘브라"},"units":[{"uid":"cpt_penumbra_02_02#34","rawText":"而我就是……那样一无所有的人形啊。","displayText":"而我就是……那样一无所有的人形啊。","spans":[{"text":"而我就是……那样一无所有的人形啊。"}]}],"stageRaw":{"imgTween":[{"imgId":183,"delay":0,"duration":0,"posId":3,"alpha":0,"isDark":false},{"imgId":183,"delay":0,"duration":0.2,"alpha":1,"shake":true,"isDark":false},{"imgId":183,"delay":0.5,"duration":0.2,"alpha":1,"shake":true,"isDark":false}],"heroFace":[{"imgId":183,"faceId":10}]},"next":"cpt_penumbra_02_02#35"},"cpt_penumbra_02_02#35":{"id":"cpt_penumbra_02_02#35","act":35,"kind":"narration","units":[{"uid":"cpt_penumbra_02_02#35","rawText":"火神重工研究所，欧米伽07小组内部会议。","displayText":"火神重工研究所，欧米伽07小组内部会议。","spans":[{"text":"火神重工研究所，欧米伽07小组内部会议。"}]}],"stageRaw":{"imgTween":[{"imgId":183,"delay":0,"duration":0.2,"alpha":0,"isDark":false},{"imgId":1,"delay":0,"duration":0.6,"alpha":0}]},"next":"cpt_penumbra_02_02#36"},"cpt_penumbra_02_02#36":{"id":"cpt_penumbra_02_02#36","act":36,"kind":"dialogue","speaker":{"name":"研究员1","rawName":"研究员1","isProfessor":false,"lookup":"연구원1"},"units":[{"uid":"cpt_penumbra_02_02#36","rawText":"OpsTec要被回收了吗？","displayText":"OpsTec要被回收了吗？","spans":[{"text":"OpsTec要被回收了吗？"}]}],"stageRaw":{"imgTween":[{"imgId":2,"delay":0,"duration":1,"alpha":1