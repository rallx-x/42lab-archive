:{"imgTween":[{"imgId":160,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":false},{"imgId":159,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":true}],"heroFace":[{"imgId":160,"faceId":6}]},"next":"cpt_nora_03_05#6"},"cpt_nora_03_05#6":{"id":"cpt_nora_03_05#6","act":6,"kind":"dialogue","speaker":{"heroId":1059,"name":"野良","rawName":"野良","isProfessor":false,"faces":[{"imgId":159,"faceId":5}],"dialogPos":1,"lookup":"노라"},"units":[{"uid":"cpt_nora_03_05#6","rawText":"那泽罗对村民有求必应的传说是……","displayText":"那泽罗对村民有求必应的传说是……","spans":[{"text":"那泽罗对村民有求必应的传说是……"}]}],"stageRaw":{"imgTween":[{"imgId":160,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":true},{"imgId":159,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":false}],"heroFace":[{"imgId":159,"faceId":5}]},"next":"cpt_nora_03_05#7"},"cpt_nora_03_05#7":{"id":"cpt_nora_03_05#7","act":7,"kind":"dialogue","speaker":{"heroId":1060,"name":"蔵音","rawName":"蔵音","isProfessor":false,"dialogPos":3,"lookup":"장음"},"units":[{"uid":"cpt_nora_03_05#7","rawText":"被那个叫工程师的人下达了指令吧。这种老式机器人还不能进行复杂逻辑的判断，用“有求必应”这个词来形容再合适不过了。","displayText":"被那个叫工程师的人下达了指令吧。这种老式机器人还不能进行复杂逻辑的判断，用“有求必应”这个词来形容再合适不过了。","spans":[{"text":"被那个叫工程师的人下达了指令吧。这种老式机器人还不能进行复杂逻辑的判断，用“有求必应”这个词来形容再合适不过了。"}]}],"stageRaw":{"imgTween":[{"imgId":160,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":false},{"imgId":159,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":true}]},"next":"cpt_nora_03_05#8"},"cpt_nora_03_05#8":{"id":"cpt_nora_03_05#8","act":8,"kind":"dialogue","speaker":{"heroId":1059,"name":"野良","rawName":"野良","isProfessor":false,"dialogPos":1,"lookup":"노라"},"units":[{"uid":"cpt_nora_03_05#8","rawText":"你的意思是，村民其实分不清楚现在的人形和老式机器人的区别？","displayText":"你的意思是，村民其实分不清楚现在的人形和老式机器人的区别？","spans":[{"text":"你的意思是，村民其实分不清楚现在的人形和老式机器人的区别？"}]}],"stageRaw":{"imgTween":[{"imgId":160,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":true},{"imgId":159,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":false}]},"next":"cpt_nora_03_05#9"},"cpt_nora_03_05#9":{"id":"cpt_nora_03_05#9","act":9,"kind":"dialogue","speaker":{"heroId":1059,"name":"野良","rawName":"野良","isProfessor":false,"dialogPos":1,"lookup":"노라"},"units":[{"uid":"cpt_nora_03_05#9","rawText":"也对，毕竟这里甚至没有通网……","displayText":"也对，毕竟这里甚至没有通网……","spans":[{"text":"也对，毕竟这里甚至没有通网……"}]}],"next":"cpt_nora_03_05#10"},"cpt_nora_03_05#10":{"id":"cpt_nora_03_05#10","act":10,"kind":"dialogue","speaker":{"heroId":1060,"name":"蔵音","rawName":"蔵音","isProfessor":false,"dialogPos":3,"lookup":"장음"},"units":[{"uid":"cpt_nora_03_05#10","rawText":"不仅如此，他们对人形的接触也很少。我们两个刚来到村子的时候，不是都被当成人类了嘛。","displayText":"不仅如此，他们对人形的接触也很少。我们两个刚来到村子的时候，不是都被当成人类了嘛。","spans":[{"text":"不仅如此，他们对人形的接触也很少。我们两个刚来到村子的时候，不是都被当成人类了嘛。"}]}],"stageRaw":{"imgTween":[{"imgId":160,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":false},{"imgId":159,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":true}]},"next":"cpt_nora_03_05#11"},"cpt_nora_03_05#11":{"id":"cpt_nora_03_05#11","act":11,"kind":"dialogue","speaker":{"heroId":1060,"name":"蔵音","rawName":"蔵音","isProfessor":false,"faces":[{"imgId":160,"faceId":5}],"dialogPos":3,"lookup":"장음"},"units":[{"uid":"cpt_nora_03_05#11","rawText":"就是因为他们很少接触人形，才会分不清楚的。","displayText":"就是因为他们很少接触人形，才会分不清楚的。","spans":[{"text":"就是因为他们很少接触人形，才会分不清楚的。"}]}],"stageRaw":{"heroFace":[{"imgId":160,"faceId":5}]},"next":"cpt_nora_03_05#12"},"cpt_nora_03_05#12":{"id":"cpt_nora_03_05#12","act":12,"kind":"dialogue","speaker":{"heroId":1059,"name":"野良","rawName":"野良","isProfessor":false,"dialogPos":1,"lookup":"노라"},"units":[{"uid":"cpt_nora_03_05#12","rawText":"所以所谓的“泽罗”，只是个政治符号吗？是工程师为了团结村民而树立的榜样？","displayText":"所以所谓的“泽罗”，只是个政治符号吗？是工程师为了团结村民而树立的榜样？","spans":[{"text":"所以所谓的“泽罗”，只是个政治符号吗？是工程师为了团结村民而树立的榜样？"}]}],"stageRaw":{"imgTween":[{"imgId":160,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":true},{"imgId":159,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":false}]},"next":"cpt_nora_03_05#13"},"cpt_nora_03_05#13":{"id":"cpt_nora_03_05#13","act":13,"kind":"dialogue","speaker":{"heroId":1060,"name":"蔵音","rawName":"蔵音","isProfessor":false,"faces":[{"imgId":160,"faceId":6}],"dialogPos":3,"lookup":"장음"},"units":[{"uid":"cpt_nora_03_05#13","rawText":"倒不是，我想他们应该是真心很感谢它。你刚到的时候，不是还被当成好兆头嘛。","displayText":"倒不是，我想他们应该是真心很感谢它。你刚到的时候，不是还被当成好兆头嘛。","spans":[{"text":"倒不是，我想他们应该是真心很感谢它。你刚到的时候，不是还被当成好兆头嘛。"}]}],"stageRaw":{"imgTween":[{"imgId":160,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":false},{"imgId":159,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":true}],"heroFace":[{"imgId":160,"faceId":6}]},"next":"cpt_nora_03_05#14"},"cpt_nora_03_05#14":{"id":"cpt_nora_03_05#14","act":14,"kind":"dialogue","speaker":{"heroId":1059,"name":"野良","rawName":"野良","isProfessor":false,"faces":[{"imgId":159,"faceId":8}],"dialogPos":1,"lookup":"노라"},"units":[{"uid":"cpt_nora_03_05#14","rawText":"怎么这事你也知道……你果然是跟踪我过来的吧？","displayText":"怎么这事你也知道……你果然是跟踪我过来的吧？","spans":[{"text":"怎么这事你也知道……你果然是跟踪我过来的吧？"}]}],"stageRaw":{"imgTween":[{"imgId":160,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":true},{"imgId":159,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":false}],"heroFace":[{"imgId":159,"faceId":8}]},"next":"cpt_nora_03_05#15"},"cpt_nora_03_05#15":{"id":"cpt_nora_03_05#15","act":15,"kind":"dialogue","speaker":{"heroId":1060,"name":"蔵音","rawName":"蔵音","isProfessor":false,"faces":[{"imgId":160,"faceId":5}],"dialogPos":3,"lookup":"장음"},"units":[{"uid":"cpt_nora_03_05#15","rawText":"我才懒得做那种麻烦事，是小巳看到的而已。","displayText":"我才懒得做那种麻烦事，是小巳看到的而已。","spans":[{"text":"我才懒得做那种麻烦事，是小巳看到的而已。"}]}],"stageRaw":{"imgTween":[{"imgId":160,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":false},{"imgId":159,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":true}],"heroFace":[{"imgId":160,"faceId":5}]},"next":"cpt_nora_03_05#16"},"cpt_nora_03_05#16":{"id":"cpt_nora_03_05#16","act":16,"kind":"narration","units":[{"uid":"cpt_nora_03_05#16","rawText":"这家伙编不出理由的时候才会把责任推到那条宠物蛇身上。","displayText":"这家伙编不出理由的时候才会把责任推到那条宠物蛇身上。","spans":[{"text":"这家伙编不出理由的时候才会把责任推到那条宠物蛇