"duration":0.2,"posId":4,"alpha":1,"isDark":false}]},"next":"cpt_python_02_04#16"},"cpt_python_02_04#16":{"id":"cpt_python_02_04#16","act":16,"kind":"dialogue","speaker":{"heroId":1010,"name":"伊芙琳","rawName":"伊芙琳","isProfessor":false,"faces":[{"imgId":110,"faceId":0}],"dialogPos":1,"lookup":"이블린"},"units":[{"uid":"cpt_python_02_04#16","rawText":"关键不在于你我，而在于其他人，你能约束好下属接纳人形？","displayText":"关键不在于你我，而在于其他人，你能约束好下属接纳人形？","spans":[{"text":"关键不在于你我，而在于其他人，你能约束好下属接纳人形？"}]}],"stageRaw":{"imgTween":[{"imgId":110,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":false},{"imgId":62,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":true}],"heroFace":[{"imgId":110,"faceId":0}]},"next":"cpt_python_02_04#17"},"cpt_python_02_04#17":{"id":"cpt_python_02_04#17","act":17,"kind":"dialogue","speaker":{"heroId":62,"name":"埃尔文","rawName":"埃尔文","isProfessor":false,"dialogPos":3,"lookup":"엘빈"},"units":[{"uid":"cpt_python_02_04#17","rawText":"我得试试才知道……","displayText":"我得试试才知道……","spans":[{"text":"我得试试才知道……"}]}],"stageRaw":{"imgTween":[{"imgId":110,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":true},{"imgId":62,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":false}]},"next":"cpt_python_02_04#18"},"cpt_python_02_04#18":{"id":"cpt_python_02_04#18","act":18,"kind":"dialogue","speaker":{"heroId":62,"name":"埃尔文","rawName":"埃尔文","isProfessor":false,"dialogPos":3,"lookup":"엘빈"},"units":[{"uid":"cpt_python_02_04#18","rawText":"但我想，剥夺竞赛资格和竞赛失败里选一个，还是前者更让人难以接受。","displayText":"但我想，剥夺竞赛资格和竞赛失败里选一个，还是前者更让人难以接受。","spans":[{"text":"但我想，剥夺竞赛资格和竞赛失败里选一个，还是前者更让人难以接受。"}]}],"next":"cpt_python_02_04#19"},"cpt_python_02_04#19":{"id":"cpt_python_02_04#19","act":19,"kind":"dialogue","speaker":{"heroId":62,"name":"埃尔文","rawName":"埃尔文","isProfessor":false,"dialogPos":3,"lookup":"엘빈"},"units":[{"uid":"cpt_python_02_04#19","rawText":"没有一个兵能接受在上战场前就认输。","displayText":"没有一个兵能接受在上战场前就认输。","spans":[{"text":"没有一个兵能接受在上战场前就认输。"}]}],"next":"cpt_python_02_04#20"},"cpt_python_02_04#20":{"id":"cpt_python_02_04#20","act":20,"kind":"dialogue","speaker":{"heroId":1010,"name":"伊芙琳","rawName":"伊芙琳","isProfessor":false,"dialogPos":1,"lookup":"이블린"},"units":[{"uid":"cpt_python_02_04#20","rawText":"我相信不论是人形还是人类，只要是军人，荣誉就比什么都重。","displayText":"我相信不论是人形还是人类，只要是军人，荣誉就比什么都重。","spans":[{"text":"我相信不论是人形还是人类，只要是军人，荣誉就比什么都重。"}]}],"stageRaw":{"imgTween":[{"imgId":110,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":false},{"imgId":62,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":true}]},"next":"cpt_python_02_04#21"},"cpt_python_02_04#21":{"id":"cpt_python_02_04#21","act":21,"kind":"dialogue","speaker":{"heroId":62,"name":"埃尔文","rawName":"埃尔文","isProfessor":false,"dialogPos":3,"lookup":"엘빈"},"units":[{"uid":"cpt_python_02_04#21","rawText":"你说得有理……嘶，不会这个也在派森的计算中吧？我还没听说过军事竞赛可以更改参赛人数的。","displayText":"你说得有理……嘶，不会这个也在派森的计算中吧？我还没听说过军事竞赛可以更改参赛人数的。","spans":[{"text":"你说得有理……嘶，不会这个也在派森的计算中吧？我还没听说过军事竞赛可以更改参赛人数的。"}]}],"stageRaw":{"imgTween":[{"imgId":110,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":true},{"imgId":62,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":false}]},"next":"cpt_python_02_04#22"},"cpt_python_02_04#22":{"id":"cpt_python_02_04#22","act":22,"kind":"dialogue","speaker":{"heroId":1010,"name":"伊芙琳","rawName":"伊芙琳","isProfessor":false,"dialogPos":1,"lookup":"이블린"},"units":[{"uid":"cpt_python_02_04#22","rawText":"那就不是我们要考虑的问题了，我也得说服那些人形接受和你们配合。","displayText":"那就不是我们要考虑的问题了，我也得说服那些人形接受和你们配合。","spans":[{"text":"那就不是我们要考虑的问题了，我也得说服那些人形接受和你们配合。"}]}],"stageRaw":{"imgTween":[{"imgId":110,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":false},{"imgId":62,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":true}]},"next":"cpt_python_02_04#23"},"cpt_python_02_04#23":{"id":"cpt_python_02_04#23","act":23,"kind":"dialogue","speaker":{"heroId":62,"name":"埃尔文","rawName":"埃尔文","isProfessor":false,"dialogPos":3,"lookup":"엘빈"},"units":[{"uid":"cpt_python_02_04#23","rawText":"嘁，确实，你们人形个个眼高于顶，不知道的还以为是你们创造了人类。","displayText":"嘁，确实，你们人形个个眼高于顶，不知道的还以为是你们创造了人类。","spans":[{"text":"嘁，确实，你们人形个个眼高于顶，不知道的还以为是你们创造了人类。"}]}],"stageRaw":{"imgTween":[{"imgId":110,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":true},{"imgId":62,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":false}]},"next":"cpt_python_02_04#24"},"cpt_python_02_04#24":{"id":"cpt_python_02_04#24","act":24,"kind":"dialogue","speaker":{"heroId":1010,"name":"伊芙琳","rawName":"伊芙琳","isProfessor":false,"faces":[{"imgId":110,"faceId":3}],"dialogPos":1,"lookup":"이블린"},"units":[{"uid":"cpt_python_02_04#24","rawText":"我们从未如此想过，倒是你们，太容易被情绪影响，身体素质也先天受限，想要设计出彼此配合还能凸显效果的方案简直难上加难。","displayText":"我们从未如此想过，倒是你们，太容易被情绪影响，身体素质也先天受限，想要设计出彼此配合还能凸显效果的方案简直难上加难。","spans":[{"text":"我们从未如此想过，倒是你们，太容易被情绪影响，身体素质也先天受限，想要设计出彼此配合还能凸显效果的方案简直难上加难。"}]}],"stageRaw":{"imgTween":[{"imgId":110,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":false},{"imgId":62,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":true}],"heroFace":[{"imgId":110,"faceId":3}]},"next":"cpt_python_02_04#25"},"cpt_python_02_04#25":{"id":"cpt_python_02_04#25","act":25,"kind":"dialogue","speaker":{"heroId":1010,"name":"伊芙琳","rawName":"伊芙琳","isProfessor":false,"dialogPos":1,"lookup":"이블린"},"units":[{"uid":"cpt_python_02_04#25","rawText":"别说一加一大于二，现在能做到一加一不小于一就很了不起了。","displayText":"别说一加一大于二，现在能做到一加一不小于一就很了不起了。","spans":[{"text":"别说一加一大于二，现在能做到一加一不小于一就很了不起了。"}]}],"next":"cpt_python_02_04#26"},"cpt_python_02_04#26":{"id":"cpt_python_02_04#26","act":26,"kind":"dialogue","speaker":{"heroId":62,"name":"埃尔文","rawName":"埃尔文","isProfessor":false,"dialogPos":3,"lookup":"엘빈"},"units":[{"uid":"cpt_python_02_04#26","rawText":"我突然觉得我们完全可以分开来干，反正派森没有规定我们必须配合，只要赢了就行。","displayText":"我突然觉得我们完全可以分开来干，反正派森没有规定我们必须配合，只要赢了就行。","spans":[{"text":"我突然觉得我们完全可以分开来干，反正派森没有规定我们必须配合，只要赢了就行。"}]}],"stageRaw":{"imgTween":[{"imgId":110,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":true},{"imgId":62,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":false}]},"next":"cpt_python_02_04#27"},"cpt_python_02_04#27":{"id":"cpt_python_02_04#27","