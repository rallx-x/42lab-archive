,"delete":true},{"imgId":10,"imgType":2,"alpha":0,"order":5,"imgPath":"summer/summer_e_bg010","fullScreen":true,"delete":true}],"imgTween":[{"imgId":999,"delay":0,"duration":0.2,"alpha":1,"isDark":false}],"heroFace":[{"imgId":999,"faceId":15}]},"next":"23sg_bs03_1#63"},"23sg_bs03_1#63":{"id":"23sg_bs03_1#63","act":63,"kind":"dialogue","speaker":{"name":"冈部伦太郎","rawName":"冈部伦太郎","isProfessor":false,"lookup":"오카베 린타로"},"units":[{"uid":"23sg_bs03_1#63","rawText":"……没关系，战友，我还记得一部分。","displayText":"……没关系，战友，我还记得一部分。","spans":[{"text":"……没关系，战友，我还记得一部分。"}]}],"stageRaw":{"imgTween":[{"imgId":999,"delay":0,"duration":0.2,"alpha":1,"isDark":true}]},"next":"23sg_bs03_1#64"},"23sg_bs03_1#64":{"id":"23sg_bs03_1#64","act":64,"kind":"dialogue","speaker":{"name":"冈部伦太郎","rawName":"冈部伦太郎","isProfessor":false,"lookup":"오카베 린타로"},"units":[{"uid":"23sg_bs03_1#64","rawText":"那家伙拥有人形，而且体型比较小。但他戴着兜帽，所以我没能看见他的脸……","displayText":"那家伙拥有人形，而且体型比较小。但他戴着兜帽，所以我没能看见他的脸……","spans":[{"text":"那家伙拥有人形，而且体型比较小。但他戴着兜帽，所以我没能看见他的脸……"}]}],"next":"23sg_bs03_1#65"},"23sg_bs03_1#65":{"id":"23sg_bs03_1#65","act":65,"kind":"dialogue","speaker":{"heroId":2,"name":null,"rawName":"教授","isProfessor":true,"professorVariant":"hero","faces":[{"imgId":999,"faceId":7}],"lookup":"교수"},"units":[{"uid":"23sg_bs03_1#65","rawText":"我们目前所遭遇的人形熵，基本上能力都远高于普通的精英熵……看来敌人会很棘手啊。","displayText":"我们目前所遭遇的人形熵，基本上能力都远高于普通的精英熵……看来敌人会很棘手啊。","spans":[{"text":"我们目前所遭遇的人形熵，基本上能力都远高于普通的精英熵……看来敌人会很棘手啊。"}]}],"stageRaw":{"imgTween":[{"imgId":999,"delay":0,"duration":0.2,"alpha":1,"isDark":false}],"heroFace":[{"imgId":999,"faceId":7}]},"next":"23sg_bs03_1#66"},"23sg_bs03_1#66":{"id":"23sg_bs03_1#66","act":66,"kind":"dialogue","speaker":{"heroId":2,"name":null,"rawName":"教授","isProfessor":true,"professorVariant":"hero","faces":[{"imgId":999,"faceId":1}],"lookup":"교수"},"units":[{"uid":"23sg_bs03_1#66","rawText":"……不过不用担心，冈部。感谢你告诉我这些。对了，你来这是想和我说什么吗？","displayText":"……不过不用担心，冈部。感谢你告诉我这些。对了，你来这是想和我说什么吗？","spans":[{"text":"……不过不用担心，冈部。感谢你告诉我这些。对了，你来这是想和我说什么吗？"}]}],"stageRaw":{"heroFace":[{"imgId":999,"faceId":1}]},"next":"23sg_bs03_1#67"},"23sg_bs03_1#67":{"id":"23sg_bs03_1#67","act":67,"kind":"dialogue","speaker":{"name":"冈部伦太郎","rawName":"冈部伦太郎","isProfessor":false,"lookup":"오카베 린타로"},"units":[{"uid":"23sg_bs03_1#67","rawText":"我有一个不情之请……","displayText":"我有一个不情之请……","spans":[{"text":"我有一个不情之请……"}]}],"stageRaw":{"imgTween":[{"imgId":999,"delay":0,"duration":0.2,"alpha":1,"isDark":true}]},"next":"23sg_bs03_1#68"},"23sg_bs03_1#68":{"id":"23sg_bs03_1#68","act":68,"kind":"dialogue","speaker":{"heroId":2001,"name":"冈部伦太郎","rawName":"冈部伦太郎","isProfessor":false,"faces":[{"imgId":201,"faceId":4}],"lookup":"오카베 린타로"},"units":[{"uid":"23sg_bs03_1#68","rawText":"战友，安排我去消灭熵的首领吧。我一定要看清楚他究竟是谁……","displayText":"战友，安排我去消灭熵的首领吧。我一定要看清楚他究竟是谁……","spans":[{"text":"战友，安排我去消灭熵的首领吧。我一定要看清楚他究竟是谁……"}]}],"stageRaw":{"imgTween":[{"imgId":999,"delay":0,"duration":0.2,"alpha":0,"isDark":true},{"imgId":201,"delay":0,"duration":0.2,"alpha":1,"isDark":false}],"heroFace":[{"imgId":201,"faceId":4}]},"next":"23sg_bs03_1#69"},"23sg_bs03_1#69":{"id":"23sg_bs03_1#69","act":69,"kind":"narration","units":[{"uid":"23sg_bs03_1#69","rawText":"究竟是谁，一次又一次地杀了红莉栖，还让真由理以那样的惨状死去。","displayText":"究竟是谁，一次又一次地杀了红莉栖，还让真由理以那样的惨状死去。","spans":[{"text":"究竟是谁，一次又一次地杀了红莉栖，还让真由理以那样的惨状死去。"}]}],"stageRaw":{"imgTween":[{"imgId":201,"delay":0,"duration":0.2,"alpha":0,"isDark":false}]},"next":"23sg_bs03_1#70"},"23sg_bs03_1#70":{"id":"23sg_bs03_1#70","act":70,"kind":"narration","units":[{"uid":"23sg_bs03_1#70","rawText":"我感到自己紧握的手不由自主地开始颤抖，愤怒让我恨不得现在就将他撕碎。","displayText":"我感到自己紧握的手不由自主地开始颤抖，愤怒让我恨不得现在就将他撕碎。","spans":[{"text":"我感到自己紧握的手不由自主地开始颤抖，愤怒让我恨不得现在就将他撕碎。"}]}],"next":"23sg_bs03_1#71"},"23sg_bs03_1#71":{"id":"23sg_bs03_1#71","act":71,"kind":"dialogue","speaker":{"heroId":2001,"name":"冈部伦太郎","rawName":"冈部伦太郎","isProfessor":false,"faces":[{"imgId":201,"faceId":5}],"lookup":"오카베 린타로"},"units":[{"uid":"23sg_bs03_1#71","rawText":"……我一定要让他付出代价。","displayText":"……我一定要让他付出代价。","spans":[{"text":"……我一定要让他付出代价。"}]}],"stageRaw":{"imgTween":[{"imgId":201,"delay":0,"duration":0.2,"alpha":1,"shake":true,"isDark":false},{"imgId":201,"delay":0.5,"duration":0.2,"alpha":1,"shake":true,"isDark":false}],"heroFace":[{"imgId":201,"faceId":5}]},"next":"23sg_bs03_1#72"},"23sg_bs03_1#72":{"id":"23sg_bs03_1#72","act":72,"kind":"dialogue","speaker":{"heroId":2,"name":null,"rawName":"教授","isProfessor":true,"professorVariant":"hero","faces":[{"imgId":999,"faceId":8}],"lookup":"교수"},"units":[{"uid":"23sg_bs03_1#72","rawText":"……我理解你的心情，但你的状态还好吗？","displayText":"……我理解你的心情，但你的状态还好吗？","spans":[{"text":"……我理解你的心情，但你的状态还好吗？"}]}],"stageRaw":{"imgTween":[{"imgId":201,"delay":0,"duration":0.2,"alpha":0,"isDark":false},{"imgId":999,"delay":0,"duration":0.2,"alpha":1,"isDark":false}],"heroFace":[{"imgId":999,"faceId":8}]},"next":"23sg_bs03_1#73"},"23sg_bs03_1#73":{"id":"23sg_bs03_1#73","act":73,"kind":"dialogue","speaker":{"name":"冈部伦太郎","rawName":"冈部伦太郎","isProfessor":false,"lookup":"오카베 린타로"},"units":[{"uid":"23sg_bs03_1#73","rawText":"我没问题。战友，我知道这场战斗有多么重要，所以我不会勉强自己。","displayText":"我没问题。战友，我知道这场战斗有多么重要，所以我不会勉强自己。","spans":[{"text":"我没问题。战友，我知道这场战斗有多么重要，所以我不会勉强自己。"}]}],"stageRaw":{"imgTween":[{"imgId":999,"delay":0,"duration":0.2,"alpha":1,"isDark":true}]},"next":"23sg_bs03_1#74"},"23sg_bs03_1#74":{"id":"23sg_bs03_1#74","act":74,"kind":"dialogue","speaker":{"name":"冈部伦太郎","rawName":"冈部伦太郎","isProfessor":false,"lookup":"오카베 린타로"},"units":[{"uid":"23sg_bs03_1#74","rawText":"交给我吧，拜托了。","displayText":"交给我吧，拜托了。","spans":[{"text":"交给我吧，拜托了。"}]}],"next":"23sg_bs03_1#75"},"23sg_bs03_1#75":{"id":"23sg_bs03_1#75","act":75,"kind":"narration","units":[{"uid":"23sg_bs03_1#75","rawText":"战友沉默了一会儿，拍了拍我的肩。","displayText":"战友沉默了一会儿，拍了拍我的肩。","spans":[{"text":"战友沉默了一会儿，拍了拍我的肩。"}]}],"stageRaw":{"imgTween":[{"imgId":999,"delay":0,"duration":0.2,"alpha":0,"isDark":true}]},"next":"23sg_bs03_1#76"},"23sg_bs03_1#76":{"id":"23sg_bs03_1#76","act":76,"kind":"dialogue","speaker":{"heroId":2,"name":n