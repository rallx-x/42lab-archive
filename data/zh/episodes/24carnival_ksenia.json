ween":[{"imgId":150,"delay":0,"duration":0.2,"alpha":1,"isDark":true}]},"next":"24carnival_ksenia#8"},"24carnival_ksenia#8":{"id":"24carnival_ksenia#8","act":8,"kind":"dialogue","speaker":{"heroId":1050,"name":"科谢尼娅","rawName":"科谢尼娅","isProfessor":false,"lookup":"크세니아"},"units":[{"uid":"24carnival_ksenia#8","rawText":"哼哼哼，工作的第一天教授甚至还没有给我结算小费哦！这件事情我可记得一清二楚。等以后回到现实，教授得把这份小费补给我哦？","displayText":"哼哼哼，工作的第一天教授甚至还没有给我结算小费哦！这件事情我可记得一清二楚。等以后回到现实，教授得把这份小费补给我哦？","spans":[{"text":"哼哼哼，工作的第一天教授甚至还没有给我结算小费哦！这件事情我可记得一清二楚。等以后回到现实，教授得把这份小费补给我哦？"}]}],"stageRaw":{"imgTween":[{"imgId":150,"delay":0,"duration":0.2,"alpha":1,"isDark":false}]},"next":"24carnival_ksenia#9"},"24carnival_ksenia#9":{"id":"24carnival_ksenia#9","act":9,"kind":"dialogue","speaker":{"name":null,"rawName":"bravo","isProfessor":true,"professorVariant":"bravo","lookup":"bravo"},"units":[{"uid":"24carnival_ksenia#9","rawText":"呵呵呵，好，等我们回到现实我双倍给你。","displayText":"呵呵呵，好，等我们回到现实我双倍给你。","spans":[{"text":"呵呵呵，好，等我们回到现实我双倍给你。"}]}],"stageRaw":{"imgTween":[{"imgId":150,"delay":0,"duration":0.2,"alpha":1,"isDark":true}]},"next":"24carnival_ksenia#10"},"24carnival_ksenia#10":{"id":"24carnival_ksenia#10","act":10,"kind":"dialogue","speaker":{"heroId":1050,"name":"科谢尼娅","rawName":"科谢尼娅","isProfessor":false,"lookup":"크세니아"},"units":[{"uid":"24carnival_ksenia#10","rawText":"嘿嘿嘿，谢谢惠顾~","displayText":"嘿嘿嘿，谢谢惠顾~","spans":[{"text":"嘿嘿嘿，谢谢惠顾~"}]}],"stageRaw":{"imgTween":[{"imgId":150,"delay":0,"duration":0.2,"alpha":1,"shake":true,"isDark":false}]},"next":null,"end":true}},"worldRecords":{},"report":{"blocks":10,"unreachedActs":[],"warnings":[]}}