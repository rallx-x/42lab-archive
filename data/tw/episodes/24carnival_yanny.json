":true},"stage":{"backgrounds":["cpt00/cpt00_e_bg020_2"],"characters":[{"imgId":120,"path":"yanny_avg","posId":3,"dark":true,"faceId":null}]}}],"blocks":{"24carnival_yanny#1":{"id":"24carnival_yanny#1","act":1,"kind":"dialogue","speaker":{"heroId":1020,"name":"揚尼","rawName":"揚尼","isProfessor":false,"lookup":"야니"},"units":[{"uid":"24carnival_yanny#1","rawText":"教授，聽說你需要和我們聊天來刺激記憶……教授一直在幫助我恢復記憶，所以我也想反過來幫助教授。","displayText":"教授，聽說你需要和我們聊天來刺激記憶……教授一直在幫助我恢復記憶，所以我也想反過來幫助教授。","spans":[{"text":"教授，聽說你需要和我們聊天來刺激記憶……教授一直在幫助我恢復記憶，所以我也想反過來幫助教授。"}]}],"stageRaw":{"images":[{"imgId":1,"imgType":2,"alpha":0,"imgPath":"cpt00/cpt00_e_bg020_2","fullScreen":true},{"imgId":120,"imgType":3,"alpha":0,"imgPath":"yanny_avg"}],"imgTween":[{"imgId":1,"delay":0,"duration":0.6,"alpha":1},{"imgId":120,"delay":0,"duration":0,"posId":3,"alpha":0,"isDark":false},{"imgId":120,"delay":0.6,"duration":0.2,"alpha":1,"isDark":false}],"bgColor":2},"next":"24carnival_yanny#2"},"24carnival_yanny#2":{"id":"24carnival_yanny#2","act":2,"kind":"dialogue","speaker":{"heroId":1020,"name":"揚尼","rawName":"揚尼","isProfessor":false,"lookup":"야니"},"units":[{"uid":"24carnival_yanny#2","rawText":"但是我的記憶模組一直在報錯……所以我也不知道自己能不能幫上忙。","displayText":"但是我的記憶模組一直在報錯……所以我也不知道自己能不能幫上忙。","spans":[{"text":"但是我的記憶模組一直在報錯……所以我也不知道自己能不能幫上忙。"}]}],"next":"24carnival_yanny#3"},"24carnival_yanny#3":{"id":"24carnival_yanny#3","act":3,"kind":"dialogue","speaker":{"name":null,"rawName":"bravo","isProfessor":true,"professorVariant":"bravo","lookup":"bravo"},"units":[{"uid":"24carnival_yanny#3","rawText":"揚尼，不用這樣。抬起頭來，你有這一份心意我已經很開心，我相信與你的溝通一定能有效的。","displayText":"揚尼，不用這樣。抬起頭來，你有這一份心意我已經很開心，我相信與你的溝通一定能有效的。","spans":[{"text":"揚尼，不用這樣。抬起頭來，你有這一份心意我已經很開心，我相信與你的溝通一定能有效的。"}]}],"stageRaw":{"imgTween":[{"imgId":120,"delay":0,"duration":0.2,"alpha":1,"isDark":true}]},"next":"24carnival_yanny#4"},"24carnival_yanny#4":{"id":"24carnival_yanny#4","act":4,"kind":"dialogue","speaker":{"heroId":1020,"name":"揚尼","rawName":"揚尼","isProfessor":false,"lookup":"야니"},"units":[{"uid":"24carnival_yanny#4","rawText":"好、好的！我和教授第一次相遇應該是在綠洲的邊界線上。我其實不太記得自己是怎麼抵達綠洲的……但是我記得我被淨化者攻擊，身體變得十分疼痛，連視覺模組都快斷線了……","displayText":"好、好的！我和教授第一次相遇應該是在綠洲的邊界線上。我其實不太記得自己是怎麼抵達綠洲的……但是我記得我被淨化者攻擊，身體變得十分疼痛，連視覺模組都快斷線了……","spans":[{"text":"好、好的！我和教授第一次相遇應該是在綠洲的邊界線上。我其實不太記得自己是怎麼抵達綠洲的……但是我記得我被淨化者攻擊，身體變得十分疼痛，連視覺模組都快斷線了……"}],"shake":true}],"stageRaw":{"imgTween":[{"imgId":120,"delay":0,"duration":0.2,"alpha":1,"shake":true,"isDark":false}]},"next":"24carnival_yanny#5"},"24carnival_yanny#5":{"id":"24carnival_yanny#5","act":5,"kind":"dialogue","speaker":{"heroId":1020,"name":"揚尼","rawName":"揚尼","isProfessor":false,"lookup":"야니"},"units":[{"uid":"24carnival_yanny#5","rawText":"然後……唔……是教授和帕斯卡小姐她們救了我……不過當時的我連教授的樣子都看不清了，只能從殘存的聽覺模組裡聽到教授的聲音。儘管如此，那對我來說也是十分安心和可靠的聲音……","displayText":"然後……唔……是教授和帕斯卡小姐她們救了我……不過當時的我連教授的樣子都看不清了，只能從殘存的聽覺模組裡聽到教授的聲音。儘管如此，那對我來說也是十分安心和可靠的聲音……","spans":[{"text":"然後……唔……是教授和帕斯卡小姐她們救了我……不過當時的我連教授的樣子都看不清了，只能從殘存的聽覺模組裡聽到教授的聲音。儘管如此，那對我來說也是十分安心和可靠的聲音……"}]}],"next":"24carnival_yanny#6"},"24carnival_yanny#6":{"id":"24carnival_yanny#6","act":6,"kind":"dialogue","speaker":{"heroId":1020,"name":"揚尼","rawName":"揚尼","isProfessor":false,"lookup":"야니"},"units":[{"uid":"24carnival_yanny#6","rawText":"在那之後的記憶就斷斷續續了……我記得教授和帕斯卡小姐提到過大海，但卻想不起來為什麼你們會提到它……對不起教授，我能回憶起來的只有這一些了。","displayText":"在那之後的記憶就斷斷續續了……我記得教授和帕斯卡小姐提到過大海，但卻想不起來為什麼你們會提到它……對不起教授，我能回憶起來的只有這一些了。","spans":[{"text":"在那之後的記憶就斷斷續續了……我記得教授和帕斯卡小姐提到過大海，但卻想不起來為什麼你們會提到它……對不起教授，我能回憶起來的只有這一些了。"}]}],"next":"24carnival_yanny#7"},"24carnival_yanny#7":{"id":"24carnival_yanny#7","act":7,"kind":"dialogue","speaker":{"name":null,"rawName":"bravo","isProfessor":true,"professorVariant":"bravo","lookup":"bravo"},"units":[{"uid":"24carnival_yanny#7","rawText":"不，這一些資訊就足夠了。謝謝你揚尼，不用勉強自己。","displayText":"不，這一些資訊就足夠了。謝謝你揚尼，不用勉強自己。","spans":[{"text":"不，這一些資訊就足夠了。謝謝你揚尼，不用勉強自己。"}]}],"stageRaw":{"imgTween":[{"imgId":120,"delay":0,"duration":0.2,"alpha":1,"isDark":true}]},"next":"24carnival_yanny#8"},"24carnival_yanny#8":{"id":"24carnival_yanny#8","act":8,"kind":"dialogue","speaker":{"heroId":1020,"name":"揚尼","rawName":"揚尼","isProfessor":false,"lookup":"야니"},"units":[{"uid":"24carnival_yanny#8","rawText":"……教授，有一件事我想請你幫忙。等回到現實的時候，我想和你一起去看海。","displayText":"……教授，有一件事我想請你幫忙。等回到現實的時候，我想和你一起去看海。","spans":[{"text":"……教授，有一件事我想請你幫忙。等回到現實的時候，我想和你一起去看海。"}]}],"stageRaw":{"imgTween":[{"imgId":120,"delay":0,"duration":0.2,"alpha":1,"shake":true,"isDark":false}]},"next":"24carnival_yanny#9"},"24carnival_yanny#9":{"id":"24carnival_yanny#9","act":9,"kind":"dialogue","speaker":{"heroId":1020,"name":"揚尼","rawName":"揚尼","isProfessor":false,"lookup":"야니"},"units":[{"uid":"24carnival_yanny#9","rawText":"雖然我不知道在雲端的治療能不能幫我克服記憶模組的損傷，但是和教授一起的話我就有無盡的勇氣和力量！可以嗎，教授？","displayText":"雖然我不知道在雲端的治療能不能幫我克服記憶模組的損傷，但是和教授一起的話我就有無盡的勇氣和力量！可以嗎，教授？","spans":[{"text":"雖然我不知道在雲端的治療能不能幫我克服記憶模組的損傷，但是和教授一起的話我就有無盡的勇氣和力量！可以嗎，教授？"}]}],"next":"24carnival_yanny#10"},"24carnival_yanny#10":{"id":"24carnival_yanny#10","act":10,"kind":"dialogue","speaker":{"name":null,"rawName":"bravo","isProfessor":true,"professorVariant":"bravo","lookup":"bravo"},"units":[{"uid":"24carnival_yanny#10","rawText":"呵呵呵，我明白了。那我們就約定好了，等離開這裡之後，我一定會陪你去看真正的大海。","displayText":"呵呵呵，我明白了。那我們就約定好了，等離開這裡之後，我一定會陪你去看真正的大海。","spans":[{"text":"呵呵呵，我明白了。那我們就約定好了，等離開這裡之後，我一定會陪你去看真正的大海。"}]}],"stageRaw":{"imgTween":[{"imgId":120,"delay":0,"duration":0.2,"alpha":1,"isDark":true}]},"next":null,"end":true}},"worldRecords":{},"report":{"blocks":10,"unreachedActs":[],"warnings":[]}}