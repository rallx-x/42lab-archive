":0.2,"alpha":1,"isDark":false}],"bgColor":2},"next":"24carnival_croque#2"},"24carnival_croque#2":{"id":"24carnival_croque#2","act":2,"kind":"dialogue","speaker":{"heroId":1005,"name":"克羅琦","rawName":"克羅琦","isProfessor":false,"lookup":"크로크"},"units":[{"uid":"24carnival_croque#2","rawText":"明明是我主導的系統結果卻出現了這樣的差錯……對不起教授！","displayText":"明明是我主導的系統結果卻出現了這樣的差錯……對不起教授！","spans":[{"text":"明明是我主導的系統結果卻出現了這樣的差錯……對不起教授！"}]}],"next":"24carnival_croque#3"},"24carnival_croque#3":{"id":"24carnival_croque#3","act":3,"kind":"dialogue","speaker":{"name":null,"rawName":"bravo","isProfessor":true,"professorVariant":"bravo","lookup":"bravo"},"units":[{"uid":"24carnival_croque#3","rawText":"不需要自責克羅琦，這並非你的過錯，是我的貿然決定帶來的後果。況且如果沒有克羅琦改良沙盒屏障和製作戰鬥模組的話，我們的冒險或許早在那天已經結束了。","displayText":"不需要自責克羅琦，這並非你的過錯，是我的貿然決定帶來的後果。況且如果沒有克羅琦改良沙盒屏障和製作戰鬥模組的話，我們的冒險或許早在那天已經結束了。","spans":[{"text":"不需要自責克羅琦，這並非你的過錯，是我的貿然決定帶來的後果。況且如果沒有克羅琦改良沙盒屏障和製作戰鬥模組的話，我們的冒險或許早在那天已經結束了。"}]}],"stageRaw":{"imgTween":[{"imgId":105,"delay":0,"duration":0.2,"alpha":1,"isDark":true}]},"next":"24carnival_croque#4"},"24carnival_croque#4":{"id":"24carnival_croque#4","act":4,"kind":"dialogue","speaker":{"heroId":1005,"name":"克羅琦","rawName":"克羅琦","isProfessor":false,"lookup":"크로크"},"units":[{"uid":"24carnival_croque#4","rawText":"但要是我當時能將系統製造得更全面一些的話……唉，算了，現在後悔也沒用了。","displayText":"但要是我當時能將系統製造得更全面一些的話……唉，算了，現在後悔也沒用了。","spans":[{"text":"但要是我當時能將系統製造得更全面一些的話……唉，算了，現在後悔也沒用了。"}]}],"stageRaw":{"imgTween":[{"imgId":105,"delay":0,"duration":0.2,"alpha":1,"isDark":false}]},"next":"24carnival_croque#5"},"24carnival_croque#5":{"id":"24carnival_croque#5","act":5,"kind":"dialogue","speaker":{"heroId":1005,"name":"克羅琦","rawName":"克羅琦","isProfessor":false,"lookup":"크로크"},"units":[{"uid":"24carnival_croque#5","rawText":"不過這麼說來，確實從和教授你見面之後，我就經常收到你那些離譜的需求呢。一下子擴大心智檢索的範圍，一下子又是改良沙盒屏障，同時還要準備預備系統……","displayText":"不過這麼說來，確實從和教授你見面之後，我就經常收到你那些離譜的需求呢。一下子擴大心智檢索的範圍，一下子又是改良沙盒屏障，同時還要準備預備系統……","spans":[{"text":"不過這麼說來，確實從和教授你見面之後，我就經常收到你那些離譜的需求呢。一下子擴大心智檢索的範圍，一下子又是改良沙盒屏障，同時還要準備預備系統……"}]}],"next":"24carnival_croque#6"},"24carnival_croque#6":{"id":"24carnival_croque#6","act":6,"kind":"dialogue","speaker":{"heroId":1005,"name":"克羅琦","rawName":"克羅琦","isProfessor":false,"lookup":"크로크"},"units":[{"uid":"24carnival_croque#6","rawText":"真的是每一個需求都好難啊……拯救大家……拯救世界真的好難啊……","displayText":"真的是每一個需求都好難啊……拯救大家……拯救世界真的好難啊……","spans":[{"text":"真的是每一個需求都好難啊……拯救大家……拯救世界真的好難啊……"}]}],"next":"24carnival_croque#7"},"24carnival_croque#7":{"id":"24carnival_croque#7","act":7,"kind":"narration","units":[{"uid":"24carnival_croque#7","rawText":"克羅琦隨手擺弄著手中的機兵模型，深深地歎了一口氣。","displayText":"克羅琦隨手擺弄著手中的機兵模型，深深地歎了一口氣。","spans":[{"text":"克羅琦隨手擺弄著手中的機兵模型，深深地歎了一口氣。"}]}],"stageRaw":{"imgTween":[{"imgId":105,"delay":0,"duration":0.2,"alpha":1,"isDark":true}]},"next":"24carnival_croque#8"},"24carnival_croque#8":{"id":"24carnival_croque#8","act":8,"kind":"dialogue","speaker":{"heroId":1005,"name":"克羅琦","rawName":"克羅琦","isProfessor":false,"lookup":"크로크"},"units":[{"uid":"24carnival_croque#8","rawText":"從我被喚醒開始，我就一直在看各種機器人相關的動漫和影視。我被故事中愛，希望，熱血與勇氣所吸引，一直期望自己也可以成為擁有鋼之魂的人形。","displayText":"從我被喚醒開始，我就一直在看各種機器人相關的動漫和影視。我被故事中愛，希望，熱血與勇氣所吸引，一直期望自己也可以成為擁有鋼之魂的人形。","spans":[{"text":"從我被喚醒開始，我就一直在看各種機器人相關的動漫和影視。我被故事中愛，希望，熱血與勇氣所吸引，一直期望自己也可以成為擁有鋼之魂的人形。"}]}],"stageRaw":{"imgTween":[{"imgId":105,"delay":0,"duration":0.2,"alpha":1,"isDark":false}]},"next":"24carnival_croque#9"},"24carnival_croque#9":{"id":"24carnival_croque#9","act":9,"kind":"dialogue","speaker":{"heroId":1005,"name":"克羅琦","rawName":"克羅琦","isProfessor":false,"lookup":"크로크"},"units":[{"uid":"24carnival_croque#9","rawText":"但是，當我被困在雲端的時候，當我開始流浪……當我想要守護大家的時候，我才發現我還差得遠啊……老實說有點受到打擊呢。","displayText":"但是，當我被困在雲端的時候，當我開始流浪……當我想要守護大家的時候，我才發現我還差得遠啊……老實說有點受到打擊呢。","spans":[{"text":"但是，當我被困在雲端的時候，當我開始流浪……當我想要守護大家的時候，我才發現我還差得遠啊……老實說有點受到打擊呢。"}]}],"next":"24carnival_croque#10"},"24carnival_croque#10":{"id":"24carnival_croque#10","act":10,"kind":"dialogue","speaker":{"heroId":1005,"name":"克羅琦","rawName":"克羅琦","isProfessor":false,"lookup":"크로크"},"units":[{"uid":"24carnival_croque#10","rawText":"我所憧憬的鋼之魂……是多麼的沉重又是多麼的艱難。拯救大家，保護大家……真的好難啊……","displayText":"我所憧憬的鋼之魂……是多麼的沉重又是多麼的艱難。拯救大家，保護大家……真的好難啊……","spans":[{"text":"我所憧憬的鋼之魂……是多麼的沉重又是多麼的艱難。拯救大家，保護大家……真的好難啊……"}]}],"stageRaw":{"imgTween":[{"imgId":105,"delay":0,"duration":0.2,"alpha":1,"shake":true,"isDark":false}]},"next":"24carnival_croque#11"},"24carnival_croque#11":{"id":"24carnival_croque#11","act":11,"kind":"dialogue","speaker":{"name":null,"rawName":"bravo","isProfessor":true,"professorVariant":"bravo","lookup":"bravo"},"units":[{"uid":"24carnival_croque#11","rawText":"確實很艱難啊。但是就是因為它很難，所以克羅琦才會一直憧憬不是嗎？","displayText":"確實很艱難啊。但是就是因為它很難，所以克羅琦才會一直憧憬不是嗎？","spans":[{"text":"確實很艱難啊。但是就是因為它很難，所以克羅琦才會一直憧憬不是嗎？"}]}],"stageRaw":{"imgTween":[{"imgId":105,"delay":0,"duration":0.2,"alpha":1,"isDark":true}]},"next":"24carnival_croque#12"},"24carnival_croque#12":{"id":"24carnival_croque#12","act":12,"kind":"dialogue","speaker":{"heroId":1005,"name":"克羅琦","rawName":"克羅琦","isProfessor":false,"lookup":"크로크"},"units":[{"uid":"24carnival_croque#12","rawText":"……真是的，明明我想帥氣地自己說出來的。","displayText":"……真是的，明明我想帥氣地自己說出來的。","spans":[{"text":"……真是的，明明我想帥氣地自己說出來的。"}]}],"stageRaw":{"imgTween":[{"imgId":105,"delay":0,"duration":0.2,"alpha":1,"isDark":false}]},"next":"24carnival_croque#13"},"24carnival_croque#13":{"id":"24carnival_croque#13","act":13,"kind":"dialogue","speaker":{"heroId":1005,"name":"克羅琦","rawName":"克羅琦","isProfessor":false,"lookup":"크로크"},"units":[{"uid":"24carnival_croque#13","rawText":"確實就如同教授說的一樣。每一次我看到教授奮不顧身的身影，看著教授帶著我們一點一滴建設起來的綠洲，看著那些被我們幫助過的磁區……","displayText":"確實就如同教授說的一樣。每一次我看到教授奮不顧身的身影，看著教授帶著我們一點一滴建設起來的綠洲，看著那些被我們幫助過的磁區……","spans":[{"text":"確實就如同教授說的一樣。每一次我看到教授奮不顧身的身影，看著教授帶著我們一點一滴建設起來的綠洲，看著那些被我們幫助過的磁區……"}]}],"next":"24carnival_croque#14"},"24carnival_croque#14":{"id":"24carnival_croque#14","act":14,"kind":"dialogue","speaker":{"heroId":1005,"name":"克羅琦","rawName":"克羅琦","isProfessor":false,"lookup":"크로크"},"units":[{"uid":"24carnival_croque#14","rawText":"啊~我果然還是想要像教授一樣成為保護大家的那個人。","displayText":"啊~我果然還是想要像教授一樣成為保護大家的那個人。","spans":[{"text":"啊~我果然還是想要像教授一樣成為保護大家的那個人。"}]}],"next":"24carnival_croque#15"},"24carnival_croque#15":{"id":"24carnival_croque#15","act":15,"kind":"dialogue","speaker":{"heroId":1005,"name":"克羅琦","rawName":"克羅琦","isProfessor":false,"lookup":"크로크"},"units":[{"uid":"24carnival_croque#15","rawText":"堅定不移的信念，永不退縮的勇氣，和守護他人的溫柔……那些作品裡傳達的感情正是我所憧憬的存在。教授，接下來的戰鬥我也會依舊秉承著這份精神和你一同戰鬥下去的。","displayText":"堅定不移的信念，永不退縮的勇氣，和守護他人的溫柔……那些作品裡傳達的感情正是我所憧憬的存在。教授，接下來的戰鬥我也會依舊秉承著這份精神和你一同戰鬥下去的。","spans":[{"text":"堅定不移的信念，永不退縮的勇氣，和守護他人的溫柔……那些作品裡傳達的感情正是我所憧憬的存在。教授，接下來的戰鬥我也會依舊秉承著這份精神和你一同戰鬥下去的。"}]}],"next":"24carnival_croque#16"},"24carnival_croque#16":{"id":"24carnival_croque#16","act":16,"kind":"dialogue","speaker":{"heroId":1005,"name":"克羅琦","rawName":"克羅琦","isProfessor":false,"lookup":"크로크"},"units":[{"uid":"24carnival_croque#16","rawText":"啊對了！不如我們來重溫一下機器人動畫吧！說不定可以幫助教授恢復當初和我一同的記憶……我看看……從《武裝機兵》開始也就500部而已嘛！","displayText":"啊對了！不如我們來重溫一下機器人動畫吧！說不定可以幫助教授恢復當初和我一同的記憶……我看看……從《武裝機兵》開始也就500部而已嘛！","spans":[{"text":"啊對了！不如我們來重溫一下機器人動畫吧！說不定可以幫助教授恢復當初和我一同的記憶……我看看……從《武裝機兵》開始也就500部而已嘛！"}],"shake":true}],"stageRaw":{"imgTween":[{"imgId":105,"delay":0,"duration":0.2,"alpha":1,"shake":true,"isDark":false}]},"next":null,"end":true}},"worldRecords":{},"report":{"blocks":16,"unreachedActs":[],"warnings":[]}}