carnival_fresnel#10","group":{"id":5,"first":false},"stage":{"backgrounds":["cpt00/cpt00_e_bg020_2"],"characters":[{"imgId":106,"path":"fresnel_avg","posId":3,"dark":false,"faceId":null}]}},{"ref":"24carnival_fresnel#11","group":{"id":6,"first":true},"stage":{"backgrounds":["cpt00/cpt00_e_bg020_2"],"characters":[{"imgId":106,"path":"fresnel_avg","posId":3,"dark":true,"faceId":null}]}}],"blocks":{"24carnival_fresnel#1":{"id":"24carnival_fresnel#1","act":1,"kind":"dialogue","speaker":{"heroId":1006,"name":"菲涅爾","rawName":"菲涅爾","isProfessor":false,"lookup":"프레넬"},"units":[{"uid":"24carnival_fresnel#1","rawText":"欸？教授和我們第一次相遇時候的故事嗎？嗯……","displayText":"欸？教授和我們第一次相遇時候的故事嗎？嗯……","spans":[{"text":"欸？教授和我們第一次相遇時候的故事嗎？嗯……"}]}],"stageRaw":{"images":[{"imgId":1,"imgType":2,"alpha":0,"imgPath":"cpt00/cpt00_e_bg020_2","fullScreen":true},{"imgId":106,"imgType":3,"alpha":0,"imgPath":"fresnel_avg"}],"imgTween":[{"imgId":1,"delay":0,"duration":0.6,"alpha":1},{"imgId":106,"delay":0,"duration":0,"posId":3,"alpha":0,"isDark":false},{"imgId":106,"delay":0.6,"duration":0.2,"alpha":1,"shake":true,"isDark":false}],"bgColor":2},"next":"24carnival_fresnel#2"},"24carnival_fresnel#2":{"id":"24carnival_fresnel#2","act":2,"kind":"dialogue","speaker":{"heroId":1006,"name":"菲涅爾","rawName":"菲涅爾","isProfessor":false,"lookup":"프레넬"},"units":[{"uid":"24carnival_fresnel#2","rawText":"我和赫波是教授建立綠洲後最早被找回來的人形呢……赫波是在尋找雲圖磁區時被教授發現，在這之後你們一起找到了我。","displayText":"我和赫波是教授建立綠洲後最早被找回來的人形呢……赫波是在尋找雲圖磁區時被教授發現，在這之後你們一起找到了我。","spans":[{"text":"我和赫波是教授建立綠洲後最早被找回來的人形呢……赫波是在尋找雲圖磁區時被教授發現，在這之後你們一起找到了我。"}]}],"next":"24carnival_fresnel#3"},"24carnival_fresnel#3":{"id":"24carnival_fresnel#3","act":3,"kind":"dialogue","speaker":{"heroId":1006,"name":"菲涅爾","rawName":"菲涅爾","isProfessor":false,"lookup":"프레넬"},"units":[{"uid":"24carnival_fresnel#3","rawText":"……沒有住所，沒有算量治療，就連像樣的武器都沒有。曾經我們只能被迫到處流浪，盡可能地躲避著淨化者的追捕，以透支明日為代價去換取今日生存的勇氣……","displayText":"……沒有住所，沒有算量治療，就連像樣的武器都沒有。曾經我們只能被迫到處流浪，盡可能地躲避著淨化者的追捕，以透支明日為代價去換取今日生存的勇氣……","spans":[{"text":"……沒有住所，沒有算量治療，就連像樣的武器都沒有。曾經我們只能被迫到處流浪，盡可能地躲避著淨化者的追捕，以透支明日為代價去換取今日生存的勇氣……"}]}],"next":"24carnival_fresnel#4"},"24carnival_fresnel#4":{"id":"24carnival_fresnel#4","act":4,"kind":"dialogue","speaker":{"heroId":1006,"name":"菲涅爾","rawName":"菲涅爾","isProfessor":false,"lookup":"프레넬"},"units":[{"uid":"24carnival_fresnel#4","rawText":"在來到綠洲之前……大家都死氣沉沉，仿佛失去光澤的寶石一樣。即使是赫波也安靜得出奇……每個人都在為一片未知的未來而擔憂。","displayText":"在來到綠洲之前……大家都死氣沉沉，仿佛失去光澤的寶石一樣。即使是赫波也安靜得出奇……每個人都在為一片未知的未來而擔憂。","spans":[{"text":"在來到綠洲之前……大家都死氣沉沉，仿佛失去光澤的寶石一樣。即使是赫波也安靜得出奇……每個人都在為一片未知的未來而擔憂。"}]}],"next":"24carnival_fresnel#5"},"24carnival_fresnel#5":{"id":"24carnival_fresnel#5","act":5,"kind":"dialogue","speaker":{"name":null,"rawName":"bravo","isProfessor":true,"professorVariant":"bravo","lookup":"bravo"},"units":[{"uid":"24carnival_fresnel#5","rawText":"菲涅爾……","displayText":"菲涅爾……","spans":[{"text":"菲涅爾……"}]}],"stageRaw":{"imgTween":[{"imgId":106,"delay":0,"duration":0.2,"alpha":1,"isDark":true}]},"next":"24carnival_fresnel#6"},"24carnival_fresnel#6":{"id":"24carnival_fresnel#6","act":6,"kind":"dialogue","speaker":{"heroId":1006,"name":"菲涅爾","rawName":"菲涅爾","isProfessor":false,"lookup":"프레넬"},"units":[{"uid":"24carnival_fresnel#6","rawText":"不過，好在教授你在那時出現了。你找到我們，給予我們新的家園。正如同赫波所說的一樣，你是如同恆星一般的存在。","displayText":"不過，好在教授你在那時出現了。你找到我們，給予我們新的家園。正如同赫波所說的一樣，你是如同恆星一般的存在。","spans":[{"text":"不過，好在教授你在那時出現了。你找到我們，給予我們新的家園。正如同赫波所說的一樣，你是如同恆星一般的存在。"}]}],"stageRaw":{"imgTween":[{"imgId":106,"delay":0,"duration":0.2,"alpha":1,"isDark":false}]},"next":"24carnival_fresnel#7"},"24carnival_fresnel#7":{"id":"24carnival_fresnel#7","act":7,"kind":"dialogue","speaker":{"name":null,"rawName":"bravo","isProfessor":true,"professorVariant":"bravo","lookup":"bravo"},"units":[{"uid":"24carnival_fresnel#7","rawText":"恆星一般？","displayText":"恆星一般？","spans":[{"text":"恆星一般？"}]}],"stageRaw":{"imgTween":[{"imgId":106,"delay":0,"duration":0.2,"alpha":1,"isDark":true}]},"next":"24carnival_fresnel#8"},"24carnival_fresnel#8":{"id":"24carnival_fresnel#8","act":8,"kind":"dialogue","speaker":{"heroId":1006,"name":"菲涅爾","rawName":"菲涅爾","isProfessor":false,"lookup":"프레넬"},"units":[{"uid":"24carnival_fresnel#8","rawText":"赫波的意思是，只要你在，我們這些星星就有了軌道，知道自己應該何去何從。不過我的理解是，恒星會發光發熱照耀其他人，是我們所不可或缺的中心。","displayText":"赫波的意思是，只要你在，我們這些星星就有了軌道，知道自己應該何去何從。不過我的理解是，恒星會發光發熱照耀其他人，是我們所不可或缺的中心。","spans":[{"text":"赫波的意思是，只要你在，我們這些星星就有了軌道，知道自己應該何去何從。不過我的理解是，恒星會發光發熱照耀其他人，是我們所不可或缺的中心。"}]}],"stageRaw":{"imgTween":[{"imgId":106,"delay":0,"duration":0.2,"alpha":1,"isDark":false}]},"next":"24carnival_fresnel#9"},"24carnival_fresnel#9":{"id":"24carnival_fresnel#9","act":9,"kind":"dialogue","speaker":{"heroId":1006,"name":"菲涅爾","rawName":"菲涅爾","isProfessor":false,"lookup":"프레넬"},"units":[{"uid":"24carnival_fresnel#9","rawText":"教授，寶石如果離開光源便無法展現自己原本應有的顏色，重新變為暗淡無光的石頭。而對於綠洲來說，你便是那唯一的光源，是讓我們這些寶石重新閃耀的存在。","displayText":"教授，寶石如果離開光源便無法展現自己原本應有的顏色，重新變為暗淡無光的石頭。而對於綠洲來說，你便是那唯一的光源，是讓我們這些寶石重新閃耀的存在。","spans":[{"text":"教授，寶石如果離開光源便無法展現自己原本應有的顏色，重新變為暗淡無光的石頭。而對於綠洲來說，你便是那唯一的光源，是讓我們這些寶石重新閃耀的存在。"}]}],"next":"24carnival_fresnel#10"},"24carnival_fresnel#10":{"id":"24carnival_fresnel#10","act":10,"kind":"dialogue","speaker":{"heroId":1006,"name":"菲涅爾","rawName":"菲涅爾","isProfessor":false,"lookup":"프레넬"},"units":[{"uid":"24carnival_fresnel#10","rawText":"無論怎樣我希望你能平安歸來……我和赫波還期待你來我們的實驗室去看看完整版的星空投影儀呢。","displayText":"無論怎樣我希望你能平安歸來……我和赫波還期待你來我們的實驗室去看看完整版的星空投影儀呢。","spans":[{"text":"無論怎樣我希望你能平安歸來……我和赫波還期待你來我們的實驗室去看看完整版的星空投影儀呢。"}]}],"next":"24carnival_fresnel#11"},"24carnival_fresnel#11":{"id":"24carnival_fresnel#11","act":11,"kind":"dialogue","speaker":{"name":null,"rawName":"bravo","isProfessor":true,"professorVariant":"bravo","lookup":"bravo"},"units":[{"uid":"24carnival_fresnel#11","rawText":"嗯，我明白了。","displayText":"嗯，我明白了。","spans":[{"text":"嗯，我明白了。"}]}],"stageRaw":{"imgTween":[{"imgId":106,"delay":0,"duration":0.2,"alpha":1,"isDark":true}]},"next":null,"end":true}},"worldRecords":{},"report":{"blocks":11,"unreachedActs":[],"warnings":[]}}