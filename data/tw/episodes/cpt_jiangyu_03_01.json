u_03_01#32":{"id":"cpt_jiangyu_03_01#32","act":32,"kind":"dialogue","speaker":{"heroId":185,"name":"經紀人","rawName":"經紀人","isProfessor":false,"dialogPos":3,"lookup":"매니저"},"units":[{"uid":"cpt_jiangyu_03_01#32","rawText":"親愛的，我這裡有個情報。","displayText":"親愛的，我這裡有個情報。","spans":[{"text":"親愛的，我這裡有個情報。"}]}],"stageRaw":{"imgTween":[{"imgId":188,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":true},{"imgId":185,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":false}]},"next":"cpt_jiangyu_03_01#33"},"cpt_jiangyu_03_01#33":{"id":"cpt_jiangyu_03_01#33","act":33,"kind":"dialogue","speaker":{"heroId":185,"name":"經紀人","rawName":"經紀人","isProfessor":false,"dialogPos":3,"lookup":"매니저"},"units":[{"uid":"cpt_jiangyu_03_01#33","rawText":"公司有個古箏人形的收益並不理想，恰逢排期需要安排一場規格很高的音樂會，公司那邊可是頭疼的很。","displayText":"公司有個古箏人形的收益並不理想，恰逢排期需要安排一場規格很高的音樂會，公司那邊可是頭疼的很。","spans":[{"text":"公司有個古箏人形的收益並不理想，恰逢排期需要安排一場規格很高的音樂會，公司那邊可是頭疼的很。"}]}],"next":"cpt_jiangyu_03_01#34"},"cpt_jiangyu_03_01#34":{"id":"cpt_jiangyu_03_01#34","act":34,"kind":"dialogue","speaker":{"heroId":185,"name":"經紀人","rawName":"經紀人","isProfessor":false,"faces":[{"imgId":185,"faceId":3}],"dialogPos":3,"lookup":"매니저"},"units":[{"uid":"cpt_jiangyu_03_01#34","rawText":"而正巧絳雨本身也是古箏人形。這個項目生產的人形本就不多，很容易想到她們之間的關係吧？","displayText":"而正巧絳雨本身也是古箏人形。這個項目生產的人形本就不多，很容易想到她們之間的關係吧？","spans":[{"text":"而正巧絳雨本身也是古箏人形。這個項目生產的人形本就不多，很容易想到她們之間的關係吧？"}]}],"stageRaw":{"heroFace":[{"imgId":185,"faceId":3}]},"next":"cpt_jiangyu_03_01#35"},"cpt_jiangyu_03_01#35":{"id":"cpt_jiangyu_03_01#35","act":35,"kind":"dialogue","speaker":{"heroId":188,"name":"卡卡蘿特","rawName":"卡卡蘿特","isProfessor":false,"faces":[{"imgId":188,"faceId":77}],"dialogPos":1,"lookup":"쿠쿠로트"},"units":[{"uid":"cpt_jiangyu_03_01#35","rawText":"你是說黛煙？我記得她們是以姐妹為噱頭進行宣傳的吧？","displayText":"你是說黛煙？我記得她們是以姐妹為噱頭進行宣傳的吧？","spans":[{"text":"你是說黛煙？我記得她們是以姐妹為噱頭進行宣傳的吧？"}]}],"stageRaw":{"imgTween":[{"imgId":188,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":false},{"imgId":185,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":true}],"heroFace":[{"imgId":188,"faceId":77}]},"next":"cpt_jiangyu_03_01#36"},"cpt_jiangyu_03_01#36":{"id":"cpt_jiangyu_03_01#36","act":36,"kind":"dialogue","speaker":{"heroId":185,"name":"經紀人","rawName":"經紀人","isProfessor":false,"faces":[{"imgId":185,"faceId":0}],"dialogPos":3,"lookup":"매니저"},"units":[{"uid":"cpt_jiangyu_03_01#36","rawText":"沒錯。絳雨一個毫無作品的三流人形可以躋身試鏡，說不準是因為有什麼不可告人的幕後交易。","displayText":"沒錯。絳雨一個毫無作品的三流人形可以躋身試鏡，說不準是因為有什麼不可告人的幕後交易。","spans":[{"text":"沒錯。絳雨一個毫無作品的三流人形可以躋身試鏡，說不準是因為有什麼不可告人的幕後交易。"}]}],"stageRaw":{"imgTween":[{"imgId":188,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":true},{"imgId":185,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":false}],"heroFace":[{"imgId":185,"faceId":0}]},"next":"cpt_jiangyu_03_01#37"},"cpt_jiangyu_03_01#37":{"id":"cpt_jiangyu_03_01#37","act":37,"kind":"dialogue","speaker":{"heroId":185,"name":"經紀人","rawName":"經紀人","isProfessor":false,"faces":[{"imgId":185,"faceId":3}],"dialogPos":3,"lookup":"매니저"},"units":[{"uid":"cpt_jiangyu_03_01#37","rawText":"那……究竟是誰幫了絳雨呢？","displayText":"那……究竟是誰幫了絳雨呢？","spans":[{"text":"那……究竟是誰幫了絳雨呢？"}]}],"stageRaw":{"heroFace":[{"imgId":185,"faceId":3}]},"next":"cpt_jiangyu_03_01#38"},"cpt_jiangyu_03_01#38":{"id":"cpt_jiangyu_03_01#38","act":38,"kind":"dialogue","speaker":{"heroId":188,"name":"卡卡蘿特","rawName":"卡卡蘿特","isProfessor":false,"dialogPos":1,"lookup":"쿠쿠로트"},"units":[{"uid":"cpt_jiangyu_03_01#38","rawText":"……可是絳雨在公司裡的人脈並不只有黛煙？試鏡機會也是公司運作出來的。","displayText":"……可是絳雨在公司裡的人脈並不只有黛煙？試鏡機會也是公司運作出來的。","spans":[{"text":"……可是絳雨在公司裡的人脈並不只有黛煙？試鏡機會也是公司運作出來的。"}]}],"stageRaw":{"imgTween":[{"imgId":188,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":false},{"imgId":185,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":true}]},"next":"cpt_jiangyu_03_01#39"},"cpt_jiangyu_03_01#39":{"id":"cpt_jiangyu_03_01#39","act":39,"kind":"dialogue","speaker":{"heroId":185,"name":"經紀人","rawName":"經紀人","isProfessor":false,"dialogPos":3,"lookup":"매니저"},"units":[{"uid":"cpt_jiangy