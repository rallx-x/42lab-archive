畢竟人形就是如此。被人類需要便是我們最大存在意義，除此之外，我們一無所有。","spans":[{"text":"畢竟人形就是如此。被人類需要便是我們最大存在意義，除此之外，我們一無所有。"}]}],"next":"cpt_penumbra_02_02#33"},"cpt_penumbra_02_02#33":{"id":"cpt_penumbra_02_02#33","act":33,"kind":"narration","units":[{"uid":"cpt_penumbra_02_02#33","rawText":"黯月低垂著眼簾，逐漸回想起一段不愉快的記憶。","displayText":"黯月低垂著眼簾，逐漸回想起一段不愉快的記憶。","spans":[{"text":"黯月低垂著眼簾，逐漸回想起一段不愉快的記憶。"}]}],"stageRaw":{"imgTween":[{"imgId":183,"delay":0,"duration":0.2,"alpha":0,"isDark":false},{"imgId":165,"delay":0,"duration":0.2,"alpha":0,"isDark":true}]},"next":"cpt_penumbra_02_02#34"},"cpt_penumbra_02_02#34":{"id":"cpt_penumbra_02_02#34","act":34,"kind":"dialogue","speaker":{"heroId":1083,"name":"黯月","rawName":"黯月","isProfessor":false,"faces":[{"imgId":183,"faceId":10}],"lookup":"페넘브라"},"units":[{"uid":"cpt_penumbra_02_02#34","rawText":"而我就是……那樣一無所有的人形啊。","displayText":"而我就是……那樣一無所有的人形啊。","spans":[{"text":"而我就是……那樣一無所有的人形啊。"}]}],"stageRaw":{"imgTween":[{"imgId":183,"delay":0,"duration":0,"posId":3,"alpha":0,"isDark":false},{"imgId":183,"delay":0,"duration":0.2,"alpha":1,"shake":true,"isDark":false},{"imgId":183,"delay":0.5,"duration":0.2,"alpha":1,"shake":true,"isDark":false}],"heroFace":[{"imgId":183,"faceId":10}]},"next":"cpt_penumbra_02_02#35"},"cpt_penumbra_02_02#35":{"id":"cpt_penumbra_02_02#35","act":35,"kind":"narration","units":[{"uid":"cpt_penumbra_02_02#35","rawText":"火神重工研究所，歐米伽07小組內部會議。","displayText":"火神重工研究所，歐米伽07小組內部會議。","spans":[{"text":"火神重工研究所，歐米伽07小組內部會議。"}]}],"stageRaw":{"imgTween":[{"imgId":183,"delay":0,"duration":0.2,"alpha":0,"isDark":false},{"imgId":1,"delay":0,"duration":0.6,"alpha":0}]},"next":"cpt_penumbra_02_02#36"},"cpt_penumbra_02_02#36":{"id":"cpt_penumbra_02_02#36","act":36,"kind":"dialogue","speaker":{"name":"研究員1","rawName":"研究員1","isProfessor":false,"lookup":"연구원1"},"units":[{"uid":"cpt_penumbra_02_02#36","rawText":"OpsTec要被回收了嗎？","displayText":"OpsTec要被回收了嗎？","spans":[{"text":"OpsTec要被回收了嗎？"}]}],"stageRaw":{"imgTween":[{"imgId":2,"delay":0,"duration":1,"alpha":1