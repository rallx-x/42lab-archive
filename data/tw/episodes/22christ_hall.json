Dark":false}],"heroFace":[{"imgId":102,"faceId":12}]},"next":"22christ_hall#7"},"22christ_hall#7":{"id":"22christ_hall#7","act":7,"kind":"dialogue","speaker":{"name":null,"rawName":"bravo","isProfessor":true,"professorVariant":"bravo","lookup":"bravo"},"units":[{"uid":"22christ_hall#7","rawText":"咳……假期會有的。不過我們還是回到沙盤迴廊的話題上吧。","displayText":"咳……假期會有的。不過我們還是回到沙盤迴廊的話題上吧。","spans":[{"text":"咳……假期會有的。不過我們還是回到沙盤迴廊的話題上吧。"}]}],"stageRaw":{"imgTween":[{"imgId":102,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":true}]},"next":"22christ_hall#8"},"22christ_hall#8":{"id":"22christ_hall#8","act":8,"kind":"dialogue","speaker":{"name":null,"rawName":"bravo","isProfessor":true,"professorVariant":"bravo","lookup":"bravo"},"units":[{"uid":"22christ_hall#8","rawText":"我們可以利用敵方單位的資料來進行模擬作戰，但在有限的空間內怎樣體現區域探索的隨機性呢？","displayText":"我們可以利用敵方單位的資料來進行模擬作戰，但在有限的空間內怎樣體現區域探索的隨機性呢？","spans":[{"text":"我們可以利用敵方單位的資料來進行模擬作戰，但在有限的空間內怎樣體現區域探索的隨機性呢？"}]}],"next":"22christ_hall#9"},"22christ_hall#9":{"id":"22christ_hall#9","act":9,"kind":"dialogue","speaker":{"heroId":1002,"name":"安冬妮娜","rawName":"安冬妮娜","isProfessor":false,"faces":[{"imgId":102,"faceId":0}],"dialogPos":1,"lookup":"안토니나"},"units":[{"uid":"22christ_hall#9","rawText":"這個就是我要介紹的沙盤迴廊的核心功能了。沙盤迴廊會在人形完成當前區域的探索後，<color=orange>隨機生成三個新的探索區域來供大家選擇。</color>","displayText":"這個就是我要介紹的沙盤迴廊的核心功能了。沙盤迴廊會在人形完成當前區域的探索後，隨機生成三個新的探索區域來供大家選擇。","spans":[{"text":"這個就是我要介紹的沙盤迴廊的核心功能了。沙盤迴廊會在人形完成當前區域的探索後，"},{"text":"隨機生成三個新的探索區域來供大家選擇。","styles":[{"type":"accent"}]}]}],"stageRaw":{"imgTween":[{"imgId":102,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":false}],"heroFace":[{"imgId":102,"faceId":0}]},"next":"22christ_hall#10"},"22christ_hall#10":{"id":"22christ_hall#10","act":10,"kind":"dialogue","speaker":{"heroId":1002,"name":"安冬妮娜","rawName":"安冬妮娜","isProfessor":false,"dialogPos":1,"lookup":"안토니나"},"units":[{"uid":"22christ_hall#10","rawText":"<color=orange>這些區域包含了作戰，恢復，採集等不同的功能。</color>根據大家選擇的不同和隨機出的區域不同，就可以模擬出不同的探索路線了。","displayText":"這些區域包含了作戰，恢復，採集等不同