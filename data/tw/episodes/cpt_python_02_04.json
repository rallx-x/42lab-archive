"duration":0.2,"posId":4,"alpha":1,"isDark":false}]},"next":"cpt_python_02_04#16"},"cpt_python_02_04#16":{"id":"cpt_python_02_04#16","act":16,"kind":"dialogue","speaker":{"heroId":1010,"name":"伊芙琳","rawName":"伊芙琳","isProfessor":false,"faces":[{"imgId":110,"faceId":0}],"dialogPos":1,"lookup":"이블린"},"units":[{"uid":"cpt_python_02_04#16","rawText":"關鍵不在於你我，而在於其他人，你能約束好下屬接納人形？","displayText":"關鍵不在於你我，而在於其他人，你能約束好下屬接納人形？","spans":[{"text":"關鍵不在於你我，而在於其他人，你能約束好下屬接納人形？"}]}],"stageRaw":{"imgTween":[{"imgId":110,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":false},{"imgId":62,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":true}],"heroFace":[{"imgId":110,"faceId":0}]},"next":"cpt_python_02_04#17"},"cpt_python_02_04#17":{"id":"cpt_python_02_04#17","act":17,"kind":"dialogue","speaker":{"heroId":62,"name":"埃爾文","rawName":"埃爾文","isProfessor":false,"dialogPos":3,"lookup":"엘빈"},"units":[{"uid":"cpt_python_02_04#17","rawText":"我得試試才知道……","displayText":"我得試試才知道……","spans":[{"text":"我得試試才知道……"}]}],"stageRaw":{"imgTween":[{"imgId":110,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":true},{"imgId":62,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":false}]},"next":"cpt_python_02_04#18"},"cpt_python_02_04#18":{"id":"cpt_python_02_04#18","act":18,"kind":"dialogue","speaker":{"heroId":62,"name":"埃爾文","rawName":"埃爾文","isProfessor":false,"dialogPos":3,"lookup":"엘빈"},"units":[{"uid":"cpt_python_02_04#18","rawText":"但我想，剝奪競賽資格和競賽失敗裡選一個，還是前者更讓人難以接受。","displayText":"但我想，剝奪競賽資格和競賽失敗裡選一個，還是前者更讓人難以接受。","spans":[{"text":"但我想，剝奪競賽資格和競賽失敗裡選一個，還是前者更讓人難以接受。"}]}],"next":"cpt_python_02_04#19"},"cpt_python_02_04#19":{"id":"cpt_python_02_04#19","act":19,"kind":"dialogue","speaker":{"heroId":62,"name":"埃爾文","rawName":"埃爾文","isProfessor":false,"dialogPos":3,"lookup":"엘빈"},"units":[{"uid":"cpt_python_02_04#19","rawText":"沒有一個兵能接受在上戰場前就認輸。","displayText":"沒有一個兵能接受在上戰場前就認輸。","spans":[{"text":"沒有一個兵能接受在上戰場前就認輸。"}]}],"next":"cpt_python_02_04#20"},"cpt_python_02_04#20":{"id":"cpt_python_02_04#20","act":20,"kind":"dialogue","speaker":{"heroId":1010,"name":"伊芙琳","rawName":"伊芙琳","isProfessor":false,"dialogPos":1,"lookup":"이블린"},"units":[{"uid":"cpt_python_02_04#20","rawText":"我相信不論是人形還是人類，只要是軍人，榮譽就比什麼都重。","displayText":"我相信不論是人形還是人類，只要是軍人，榮譽就比什麼都重。","spans":[{"text":"我相信不論是人形還是人類，只要是軍人，榮譽就比什麼都重。"}]}],"stageRaw":{"imgTween":[{"imgId":110,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":false},{"imgId":62,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":true}]},"next":"cpt_python_02_04#21"},"cpt_python_02_04#21":{"id":"cpt_python_02_04#21","act":21,"kind":"dialogue","speaker":{"heroId":62,"name":"埃爾文","rawName":"埃爾文","isProfessor":false,"dialogPos":3,"lookup":"엘빈"},"units":[{"uid":"cpt_python_02_04#21","rawText":"你說得有理……嘶，不會這個也在派森的計算中吧？我還沒聽說過軍事競賽可以更改參賽人數的。","displayText":"你說得有理……嘶，不會這個也在派森的計算中吧？我還沒聽說過軍事競賽可以更改參賽人數的。","spans":[{"text":"你說得有理……嘶，不會這個也在派森的計算中吧？我還沒聽說過軍事競賽可以更改參賽人數的。"}]}],"stageRaw":{"imgTween":[{"imgId":110,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":true},{"imgId":62,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":false}]},"next":"cpt_python_02_04#22"},"cpt_python_02_04#22":{"id":"cpt_python_02_04#22","act":22,"kind":"dialogue","speaker":{"heroId":1010,"name":"伊芙琳","rawName":"伊芙琳","isProfessor":false,"dialogPos":1,"lookup":"이블린"},"units":[{"uid":"cpt_python_02_04#22","rawText":"那就不是我們要考慮的問題了，我也得說服那些人形接受和你們配合。","displayText":"那就不是我們要考慮的問題了，我也得說服那些人形接受和你們配合。","spans":[{"text":"那就不是我們要考慮的問題了，我也得說服那些人形接受和你們配合。"}]}],"stageRaw":{"imgTween":[{"imgId":110,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":false},{"imgId":62,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":true}]},"next":"cpt_python_02_04#23"},"cpt_python_02_04#23":{"id":"cpt_python_02_04#23","act":23,"kind":"dialogue","speaker":{"heroId":62,"name":"埃爾文","rawName":"埃爾文","isProfessor":false,"dialogPos":3,"lookup":"엘빈"},"units":[{"uid":"cpt_python_02_04#23","rawText":"嘁，確實，你們人形個個眼高於頂，不知道的還以為是你們創造了人類。","displayText":"嘁，確實，你們人形個個眼高於頂，不知道的還以為是你們創造了人類。","spans":[{"text":"嘁，確實，你們人形個個眼高於頂，不知道的還以為是你們創造了人類。"}]}],"stageRaw":{"imgTween":[{"imgId":110,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":true},{"imgId":62,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":false}]},"next":"cpt_python_02_04#24"},"cpt_python_02_04#24":{"id":"cpt_python_02_04#24","act":24,"kind":"dialogue","speaker":{"heroId":1010,"name":"伊芙琳","rawName":"伊芙琳","isProfessor":false,"faces":[{"imgId":110,"faceId":3}],"dialogPos":1,"lookup":"이블린"},"units":[{"uid":"cpt_python_02_04#24","rawText":"我們從未如此想過，倒是你們，太容易被情緒影響，身體素質也先天受限，想要設計出彼此配合還能凸顯效果的方案簡直難上加難。","displayText":"我們從未如此想過，倒是你們，太容易被情緒影響，身體素質也先天受限，想要設計出彼此配合還能凸顯效果的方案簡直難上加難。","spans":[{"text":"我們從未如此想過，倒是你們，太容易被情緒影響，身體素質也先天受限，想要設計出彼此配合還能凸顯效果的方案簡直難上加難。"}]}],"stageRaw":{"imgTween":[{"imgId":110,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":false},{"imgId":62,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":true}],"heroFace":[{"imgId":110,"faceId":3}]},"next":"cpt_python_02_04#25"},"cpt_python_02_04#25":{"id":"cpt_python_02_04#25","act":25,"kind":"dialogue","speaker":{"heroId":1010,"name":"伊芙琳","rawName":"伊芙琳","isProfessor":false,"dialogPos":1,"lookup":"이블린"},"units":[{"uid":"cpt_python_02_04#25","rawText":"別說一加一大於二，現在能做到一加一不小於一就很了不起了。","displayText":"別說一加一大於二，現在能做到一加一不小於一就很了不起了。","spans":[{"text":"別說一加一大於二，現在能做到一加一不小於一就很了不起了。"}]}],"next":"cpt_python_02_04#26"},"cpt_python_02_04#26":{"id":"cpt_python_02_04#26","act":26,"kind":"dialogue","speaker":{"heroId":62,"name":"埃爾文","rawName":"埃爾文","isProfessor":false,"dialogPos":3,"lookup":"엘빈"},"units":[{"uid":"cpt_python_02_04#26","rawText":"我突然覺得我們完全可以分開來幹，反正派森沒有規定我們必須配合，只要贏了就行。","displayText":"我突然覺得我們完全可以分開來幹，反正派森沒有規定我們必須配合，只要贏了就行。","spans":[{"text":"我突然覺得我們完全可以分開來幹，反正派森沒有規定我們必須配合，只要贏了就行。"}]}],"stageRaw":{"imgTween":[{"imgId":110,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":true},{"imgId":62,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":false}]},"next":"cpt_python_02_04#27"},"cpt_python_02_04#27":{"id":"cpt_python_02_04#27","