:{"imgTween":[{"imgId":160,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":false},{"imgId":159,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":true}],"heroFace":[{"imgId":160,"faceId":6}]},"next":"cpt_nora_03_05#6"},"cpt_nora_03_05#6":{"id":"cpt_nora_03_05#6","act":6,"kind":"dialogue","speaker":{"heroId":1059,"name":"野良","rawName":"野良","isProfessor":false,"faces":[{"imgId":159,"faceId":5}],"dialogPos":1,"lookup":"노라"},"units":[{"uid":"cpt_nora_03_05#6","rawText":"那澤羅對村民有求必應的傳說是……","displayText":"那澤羅對村民有求必應的傳說是……","spans":[{"text":"那澤羅對村民有求必應的傳說是……"}]}],"stageRaw":{"imgTween":[{"imgId":160,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":true},{"imgId":159,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":false}],"heroFace":[{"imgId":159,"faceId":5}]},"next":"cpt_nora_03_05#7"},"cpt_nora_03_05#7":{"id":"cpt_nora_03_05#7","act":7,"kind":"dialogue","speaker":{"heroId":1060,"name":"藏音","rawName":"藏音","isProfessor":false,"dialogPos":3,"lookup":"장음"},"units":[{"uid":"cpt_nora_03_05#7","rawText":"被那個叫工程師的人下達了指令吧。這種老式機器人還不能進行複雜邏輯的判斷，用「有求必應」這個詞來形容再合適不過了。","displayText":"被那個叫工程師的人下達了指令吧。這種老式機器人還不能進行複雜邏輯的判斷，用「有求必應」這個詞來形容再合適不過了。","spans":[{"text":"被那個叫工程師的人下達了指令吧。這種老式機器人還不能進行複雜邏輯的判斷，用「有求必應」這個詞來形容再合適不過了。"}]}],"stageRaw":{"imgTween":[{"imgId":160,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":false},{"imgId":159,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":true}]},"next":"cpt_nora_03_05#8"},"cpt_nora_03_05#8":{"id":"cpt_nora_03_05#8","act":8,"kind":"dialogue","speaker":{"heroId":1059,"name":"野良","rawName":"野良","isProfessor":false,"dialogPos":1,"lookup":"노라"},"units":[{"uid":"cpt_nora_03_05#8","rawText":"你的意思是，村民其實分不清楚現在的人形和老式機器人的區別？","displayText":"你的意思是，村民其實分不清楚現在的人形和老式機器人的區別？","spans":[{"text":"你的意思是，村民其實分不清楚現在的人形和老式機器人的區別？"}]}],"stageRaw":{"imgTween":[{"imgId":160,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":true},{"imgId":159,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":false}]},"next":"cpt_nora_03_05#9"},"cpt_nora_03_05#9":{"id":"cpt_nora_03_05#9","act":9,"kind":"dialogue","speaker":{"heroId":1059,"name":"野良","rawName":"野良","isProfessor":false,"dialogPos":1,"lookup":"노라"},"units":[{"uid":"cpt_nora_03_05#9","rawText":"也對，畢竟這裡甚至沒有通網……","displayText":"也對，畢竟這裡甚至沒有通網……","spans":[{"text":"也對，畢竟這裡甚至沒有通網……"}]}],"next":"cpt_nora_03_05#10"},"cpt_nora_03_05#10":{"id":"cpt_nora_03_05#10","act":10,"kind":"dialogue","speaker":{"heroId":1060,"name":"藏音","rawName":"藏音","isProfessor":false,"dialogPos":3,"lookup":"장음"},"units":[{"uid":"cpt_nora_03_05#10","rawText":"不僅如此，他們對人形的接觸也很少。我們兩個剛來到村子的時候，不是都被當成人類了嘛。","displayText":"不僅如此，他們對人形的接觸也很少。我們兩個剛來到村子的時候，不是都被當成人類了嘛。","spans":[{"text":"不僅如此，他們對人形的接觸也很少。我們兩個剛來到村子的時候，不是都被當成人類了嘛。"}]}],"stageRaw":{"imgTween":[{"imgId":160,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":false},{"imgId":159,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":true}]},"next":"cpt_nora_03_05#11"},"cpt_nora_03_05#11":{"id":"cpt_nora_03_05#11","act":11,"kind":"dialogue","speaker":{"heroId":1060,"name":"藏音","rawName":"藏音","isProfessor":false,"faces":[{"imgId":160,"faceId":5}],"dialogPos":3,"lookup":"장음"},"units":[{"uid":"cpt_nora_03_05#11","rawText":"就是因為他們很少接觸人形，才會分不清楚的。","displayText":"就是因為他們很少接觸人形，才會分不清楚的。","spans":[{"text":"就是因為他們很少接觸人形，才會分不清楚的。"}]}],"stageRaw":{"heroFace":[{"imgId":160,"faceId":5}]},"next":"cpt_nora_03_05#12"},"cpt_nora_03_05#12":{"id":"cpt_nora_03_05#12","act":12,"kind":"dialogue","speaker":{"heroId":1059,"name":"野良","rawName":"野良","isProfessor":false,"dialogPos":1,"lookup":"노라"},"units":[{"uid":"cpt_nora_03_05#12","rawText":"所以所謂的「澤羅」，只是個政治符號嗎？是工程師為了團結村民而樹立的榜樣？","displayText":"所以所謂的「澤羅」，只是個政治符號嗎？是工程師為了團結村民而樹立的榜樣？","spans":[{"text":"所以所謂的「澤羅」，只是個政治符號嗎？是工程師為了團結村民而樹立的榜樣？"}]}],"stageRaw":{"imgTween":[{"imgId":160,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":true},{"imgId":159,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":false}]},"next":"cpt_nora_03_05#13"},"cpt_nora_03_05#13":{"id":"cpt_nora_03_05#13","act":13,"kind":"dialogue","speaker":{"heroId":1060,"name":"藏音","rawName":"藏音","isProfessor":false,"faces":[{"imgId":160,"faceId":6}],"dialogPos":3,"lookup":"장음"},"units":[{"uid":"cpt_nora_03_05#13","rawText":"倒不是，我想他們應該是真心很感謝它。你剛到的時候，不是還被當成好兆頭嘛。","displayText":"倒不是，我想他們應該是真心很感謝它。你剛到的時候，不是還被當成好兆頭嘛。","spans":[{"text":"倒不是，我想他們應該是真心很感謝它。你剛到的時候，不是還被當成好兆頭嘛。"}]}],"stageRaw":{"imgTween":[{"imgId":160,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":false},{"imgId":159,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":true}],"heroFace":[{"imgId":160,"faceId":6}]},"next":"cpt_nora_03_05#14"},"cpt_nora_03_05#14":{"id":"cpt_nora_03_05#14","act":14,"kind":"dialogue","speaker":{"heroId":1059,"name":"野良","rawName":"野良","isProfessor":false,"faces":[{"imgId":159,"faceId":8}],"dialogPos":1,"lookup":"노라"},"units":[{"uid":"cpt_nora_03_05#14","rawText":"怎麼這事你也知道……你果然是跟蹤我過來的吧？","displayText":"怎麼這事你也知道……你果然是跟蹤我過來的吧？","spans":[{"text":"怎麼這事你也知道……你果然是跟蹤我過來的吧？"}]}],"stageRaw":{"imgTween":[{"imgId":160,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":true},{"imgId":159,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":false}],"heroFace":[{"imgId":159,"faceId":8}]},"next":"cpt_nora_03_05#15"},"cpt_nora_03_05#15":{"id":"cpt_nora_03_05#15","act":15,"kind":"dialogue","speaker":{"heroId":1060,"name":"藏音","rawName":"藏音","isProfessor":false,"faces":[{"imgId":160,"faceId":5}],"dialogPos":3,"lookup":"장음"},"units":[{"uid":"cpt_nora_03_05#15","rawText":"我才懶得做那種麻煩事，是小巳看到的而已。","displayText":"我才懶得做那種麻煩事，是小巳看到的而已。","spans":[{"text":"我才懶得做那種麻煩事，是小巳看到的而已。"}]}],"stageRaw":{"imgTween":[{"imgId":160,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":false},{"imgId":159,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":true}],"heroFace":[{"imgId":160,"faceId":5}]},"next":"cpt_nora_03_05#16"},"cpt_nora_03_05#16":{"id":"cpt_nora_03_05#16","act":16,"kind":"narration","units":[{"uid":"cpt_nora_03_05#16","rawText":"這傢伙編不出理由的時候才會把責任推到那條寵物蛇身上。","displayText":"這傢伙編不出理由的時候才會把責任推到那條寵物蛇身上。","spans":[{"text":"這傢伙編不出理由的時候才會把責任推到那條寵物蛇身上。"}]}],"stageRaw":{"imgTween":[{"imgId":160,"delay":0,"duration":0.2,"posId":4,"alpha":0,"isDark":false},{"imgId":159,"delay":0,"duration":0.2,"posId":2,"alpha":0,"isDark":true}]},"next":"cpt_nora_03_05#17"},"cpt_nora_03_05#17":{"id":"cpt_nora_03_05#17","act":17,"kind":"dialogue","speaker":{"heroId":1059,"name":"野良","rawName":"野良","isProfessor":false,"faces":[{"imgId":159,"faceId":5}],"dialogPos":1,"lookup":"노라"},"units":[{"uid":"cpt_nora_03_05#17","rawText":"那就算我們是福星了好吧，為什麼又要把我們給關起來？","displayText":"那就算我們是福星了好吧，為什麼又要把我們給關起來？","spans":[{"text":"那就算我們是福星了好吧，為什麼又要把我們給關起來？"}]}],"stageRaw":{"imgTween":[{"imgId":160,"delay":0,"duration":0,"posId":4,"alpha":0,"isDark":true},{"imgId":160,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":true},{"imgId":159,"delay":0,"duration":0,"posId":2,"alpha":0,"isDark":false},{"imgId":159,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":false}],"heroFace":[{"imgId":159,"faceId":5}]},"next":"cpt_nora_03_05#18"},"cpt_nora_03_05#18":{"id":"cpt_nora_03_05#18","act":18,"kind":"dialogue","speaker":{"heroId":1060,"name":"藏音","rawName":"藏音","isProfessor":false,"faces":[{"imgId":160,"faceId":6}],"dialogPos":3,"lookup":"장음"},"units":[{"uid":"cpt_nora_03_05#18","rawText":"嘶……蠢也要有個限度吧，你還沒懂嗎？","displayText":"嘶……蠢也要有個限度吧，你還沒懂嗎？","spans":[{"text":"嘶……蠢也要有個限度吧，你還沒懂嗎？"}]}],"stageRaw":{"imgTween":[{"imgId":160,"delay":0,"duration":0.2,"posId":4,"alpha":1,"isDark":false},{"imgId":159,"delay":0,"duration":0.2,"posId":2,"alpha":1,"isDark":true}],"heroFace":[{"imgId":160,"faceId":6}]},"next":"cpt_nora_03_05#19"},"cpt_nora_03_05#19":{"id":"cpt_nora_03_05#19","act":19,"kind":"narration","units":[{"uid":"cpt_nora_03_05#19","rawText":"她把舌頭頂在牙齒上，發出蛇一樣的吸氣聲。","displayText":"她把舌頭頂在牙齒上，發出蛇一樣的吸氣聲。","spans":[{"text":"她把舌頭頂在牙齒上，發出蛇一樣的吸氣聲。"}]}],"stageRaw":{"imgTween":[{"imgId":160,"delay":0,"duration":0.2,"posId":4,"alpha":0,"isDark":false},{"imgId":159,"delay":0,"duration":0.2,"posId":2,"alpha":0,"isDark":true}]},"next":"cpt_nora_03_05#20"},"cpt_nora_03_05#20":{"id":"cpt_nora_03_05#20","act":20,"kind":"dialogue","speaker":{"heroId":1060,"name":"藏音","rawName":"藏音","isProfessor":false,"dialogPos":2,"lookup":"장음"},"units":[{"uid":"cpt_nora_03_05#20","rawText":"聽好了，這裡的人，除了工程師，都是些連網都沒怎麼上過的難民哦？他們根本不懂人形是怎麼運作的，需要什麼。","displayText":"聽好了，這裡的人，除了工程師，都是些連網都沒怎麼上過的難民哦？他們根本不懂人形是怎麼運作的，需要什麼。","spans":[{"text":"聽好了，這裡的人，除了工程師，都是些連網都沒怎麼上過的難民哦？他們根本不懂人形是怎麼運作的，需要什麼。"}]}],"stageRaw":{"imgTween":[{"imgId":160,"delay":0,"duration":0,"posId":3,"alpha":0,"isDark":false},{"imgId":160,"delay":0,"duration":0.2,"posId":3,"alpha":1,"isDark":false}]},"next":"cpt_nora_03_05#21"},"cpt_nora_03_05#21":{"id":"cpt_nora_03_05#21","act":21,"kind":"dialogue","speaker":{"heroId":1060,"name":"藏音","rawName":"藏音","isProfessor":false,"dialogPos":2,"lookup":"장음"},"units":[{"uid":"cpt_nora_03_05#21","rawText":"而跟他們一起建村的澤羅，也是個沒有感情的鐵疙瘩。","displayText":"而跟他們一起建村的澤羅，也是個沒有感情的鐵疙瘩。","spans":[{"text":"而跟他們一起建村的澤羅，也是個沒有感情的鐵疙瘩。"}]}],"next":"cpt_nora_03_05#22"},"cpt_nora_03_05#22":{"id":"cpt_nora_03_05#22","act":22,"kind":"dialogue","speaker":{"heroId":1060,"name":"藏音","rawName":"藏音","isProfessor":false,"dialogPos":2,"lookup":"장음"},"units":[{"uid":"cpt_nora_03_05#22","rawText":"所以他們對人形的感情只是對工具的感情而已，大人對我們態度還算不錯，小孩則完全不感興趣。這就好像你會對你那根破毛筆戀戀不捨一樣。","displayText":"所以他們對人形的感情只是對工具的感情而已，大人對我們態度還算不錯，小孩則完全不感興趣。這就好像你會對你那根破毛筆戀戀不捨一樣。","spans":[{"text":"所以他們對人形的感情只是對工具的感情而已，大人對我們態度還算不錯，小孩則完全不感興趣。這就好像你會對你那根破毛筆戀戀不捨一樣。"}]}],"next":"cpt_nora_03_05#23"},"cpt_nora_03_05#23":{"id":"cpt_nora_03_05#23","act":23,"kind":"dialogue","speaker":{"heroId":1059,"name":"野良","rawName":"野良","isProfessor":false,"faces":[{"imgId":159,"faceId":5}],"dialogPos":2,"lookup":"노라"},"units":[{"uid":"cpt_nora_03_05#23","rawText":"你這個比喻……倒也可以理解嘛，不是沒有道理。","displayText":"你這個比喻……倒也可以理解嘛，不是沒有道理。","spans":[{"text":"你這個比喻……倒也可以理解嘛，不是沒有道理。"}]}],"stageRaw":{"imgTween":[{"imgId":160,"delay":0,"duration":0.2,"posId":3,"alpha":0,"isDark":false},{"imgId":159,"delay":0,"duration":0,"posId":3,"alpha":0,"isDark":false},{"imgId":159,"delay"