avo"},"units":[{"uid":"cpt_imr_s19#34","rawText":"這是你的指令嗎？","displayText":"這是你的指令嗎？","spans":[{"text":"這是你的指令嗎？"}]}],"stageRaw":{"imgTween":[{"imgId":13,"delay":0,"duration":0.2,"posId":3,"alpha":1,"isDark":true}]},"next":"cpt_imr_s19#35"},"cpt_imr_s19#35":{"id":"cpt_imr_s19#35","act":35,"kind":"dialogue","speaker":{"heroId":103,"name":"梅麗爾","rawName":"梅麗爾","isProfessor":false,"faces":[{"imgId":13,"faceId":0}],"lookup":"메릴"},"units":[{"uid":"cpt_imr_s19#35","rawText":"很多人都這麼問，但我只是愛他。我愛著他那獨一無二的生命。","displayText":"很多人都這麼問，但我只是愛他。我愛著他那獨一無二的生命。","spans":[{"text":"很多人都這麼問，但我只是愛他。我愛著他那獨一無二的生命。"}]}],"stageRaw":{"imgTween":[{"imgId":13,"delay":0,"duration":0.2,"posId":3,"alpha":1,"isDark":false}],"heroFace":[{"imgId":13,"faceId":0}]},"next":"cpt_imr_s19#36"},"cpt_imr_s19#36":{"id":"cpt_imr_s19#36","act":36,"kind":"dialogue","speaker":{"heroId":103,"name":"梅麗爾","rawName":"梅麗爾","isProfessor":false,"lookup":"메릴"},"units":[{"uid":"cpt_imr_s19#36","rawText":"是否由指令決定，都不能改變這個事實。","displayText":"是否由指令決定，都不能改變這個事實。","spans":[{"text":"是否由指令決定，都不能改變這個事實。"}]}],"next":"cpt_imr_s19#37"},"cpt_imr_s19#37":{"id":"cpt_imr_s19#37","act":37,"kind":"choice","choice":{"options":[{"index":1,"rawText":"難以理解。","displayText":"難以理解。","spans":[{"text":"難以理解。"}],"jumpAct":38},{"index":2,"rawText":"可以理解。","displayText":"可以理解。","spans":[{"text":"可以理解。"}],"jumpAct":38}]},"stageRaw":{"imgTween":[{"imgId":13,"delay":0,"duration":0.2,"posId":3,"alpha":1,"isDark":true}]},"next":"cpt_imr_s19#38"},"cpt_imr_s19#38":{"id":"cpt_imr_s19#38","act":38,"kind":"dialogue","speaker":{"heroId":103,"name":"梅麗爾","rawName":"梅麗爾","isProfessor":false,"lookup":"메릴"},"units":[{"uid":"cpt_imr_s19#38","rawText":"如果對你們來說，突破和犧牲些什麼就是愛的話，我也同樣能夠繞過我的基礎法則，只為了我愛著的那個人。","displayText":"如果對你們來說，突破和犧牲些什麼就是愛的話，我也同樣能夠繞過我的基礎法則，只為了我愛著的那個人。","spans":[{"text":"如果對你們來說，突破和犧牲些什麼就是愛的話，我也同樣能夠繞過我的基礎法則，只為了我愛著的那個人。"}]}],"stageRaw":{"imgTween":[{"imgId":13,"delay":0,"duration":0.2,"posId":3,"alpha":1,"isDark":false}]},"next":"cpt_imr_s19#39"},"cpt_imr_s19#